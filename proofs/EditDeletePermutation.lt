import Rust_primitives
import Core_models
import Nickel.Vector
import Nickel.LoopUtil
import FStar.Pervasives
import FStar.Classical
import FStar.Mul
import Seq = FStar.Seq
import Props = FStar.Seq.Properties
import Native = Nickel_crdt.Edit
import Flow = Core_models.Ops.Control_flow
import Folds = Rust_primitives.Hax.Folds
import Tactics = FStar.Tactics.V2

type births = Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)
function same_births(before: t_Slice(Native.t_BirthId), after: t_Slice(Native.t_BirthId)): Type0 {
  Seq.length(before) == Seq.length(after) and
  (forall(id: Native.t_BirthId) . Seq.count(id, before) == Seq.count(id, after))
}
proof copy_births_exact(xs: t_Slice(Native.t_BirthId)): unit
  gives Alloc.Vec.impl_1__as_slice(Alloc.Slice.impl__to_vec(xs)) == xs
  hint Alloc.Slice.impl__to_vec(xs)
{
  assert(Alloc.Vec.impl_1__as_slice(Alloc.Slice.impl__to_vec(xs)) == Seq.append(Seq.empty, xs));
  Seq.append_empty_l(xs);
}

function exchange(values: births, left: usize where v(left) < Seq.length(Alloc.Vec.impl_1__as_slice(values)),
  right: usize where v(right) < Seq.length(Alloc.Vec.impl_1__as_slice(values))): births {
  const before = Alloc.Vec.impl_1__as_slice(values);
  const one = Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(before, left, Rust_primitives.Slice.slice_index(before, right)));
  Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(Alloc.Vec.impl_1__as_slice(one), right, Rust_primitives.Slice.slice_index(before, left)))
}
proof exchange_preserves_births(values: births, left: usize where v(left) < Seq.length(Alloc.Vec.impl_1__as_slice(values)),
  right: usize where v(left) <= v(right) and v(right) < Seq.length(Alloc.Vec.impl_1__as_slice(values))): unit
  gives same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(exchange(values, left, right)))
{
  Props.lemma_swap_permutes(Alloc.Vec.impl_1__as_slice(values), v(left), v(right));
  const before = Alloc.Vec.impl_1__as_slice(values);
  const after = Alloc.Vec.impl_1__as_slice(exchange(values, left, right));
  const swapped = Seq.swap(before, v(left), v(right));
  assert(forall(i: nat where i < Seq.length(before)) . Seq.index(after, i) == Seq.index(swapped, i));
  Seq.lemma_eq_intro(after, swapped);
  Seq.lemma_eq_elim(after, swapped);
}

// This loop law accounts for both early break and loop exhaustion. It supplies
// preservation only; it does not assert that sifting has established a heap.
function break_keeps<state: Type0>(p: state => Type0, out: Flow.t_ControlFlow((unit, state), state)): Type0 {
  match out { Flow.ControlFlow_Break((_, next)) => p(next), Flow.ControlFlow_Continue(next) => p(next) }
}
proof! break_preserve<state: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  inv: Nickel.LoopUtil.total_invariant(state, start, finish), value: state,
  f: Nickel.LoopUtil.break_callback(state, start, finish), p: state => Type0): unit
  decreases v(finish) - v(start)
  takes p(value)
  takes forall(s: state, at: Nickel.LoopUtil.position(start, finish)) . p(s) ==> break_keeps(p, f(s, at))
  gives p(Folds.fold_range_cf(start, finish, inv, value, f))
{
  if v(start) < v(finish) {
    Nickel.LoopUtil.break_step(start, finish, inv, value, f);
    match f(value, start) {
      Flow.ControlFlow_Break((_, next)) => {
        assert(p(Folds.fold_range_cf(start, finish, inv, value, f))) by {
          Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf"); Tactics.smt_sync'(1, 1)
        }
      },
      Flow.ControlFlow_Continue(next) => {
        break_preserve(start +! mk_usize(1), finish, inv, next, f, p);
        assert(p(Folds.fold_range_cf(start, finish, inv, value, f))) by {
          Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf"); Tactics.smt_sync'(1, 1)
        }
      },
    }
  } else {
    Nickel.LoopUtil.break_end(start, finish, inv, value, f);
    assert(p(Folds.fold_range_cf(start, finish, inv, value, f))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf"); Tactics.smt_sync'(1, 1)
    }
  }
}
proof break_preserve_any<state: Type0>(start: usize, finish: usize where v(start) <= v(finish), p: state => Type0): unit
  gives forall(inv: Nickel.LoopUtil.total_invariant(state, start, finish), value: state, f: Nickel.LoopUtil.break_callback(state, start, finish)) .
    (p(value) and (forall(s: state, at: Nickel.LoopUtil.position(start, finish)) . p(s) ==> break_keeps(p, f(s, at)))) ==>
      p(Folds.fold_range_cf(start, finish, inv, value, f))
{
  proof each(inv: Nickel.LoopUtil.total_invariant(state, start, finish), value: state, f: Nickel.LoopUtil.break_callback(state, start, finish)): unit
    takes p(value)
    takes forall(s: state, at: Nickel.LoopUtil.position(start, finish)) . p(s) ==> break_keeps(p, f(s, at))
    gives p(Folds.fold_range_cf(start, finish, inv, value, f))
  {
    break_preserve(start, finish, inv, value, f, p);
    assert(p(Folds.fold_range_cf(start, finish, inv, value, f))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf"); Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_3(FStar.Classical.move_requires_3(each))
}

// Match the two actual extracted indexed writes, including both slice-to-vector
// conversions. This is a contract for that model expression, not a sort axiom.
proof indexed_exchange_preserves(values: births,
  left: usize where v(left) < Seq.length(Alloc.Vec.impl_1__as_slice(values)),
  right: usize where v(left) <= v(right) and v(right) < Seq.length(Alloc.Vec.impl_1__as_slice(values))): unit
  gives same_births(Alloc.Vec.impl_1__as_slice(values),
    Alloc.Vec.impl_1__as_slice(Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(
      Alloc.Vec.impl_1__as_slice(Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(
        Alloc.Vec.impl_1__as_slice(values), left, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(values), right)))),
      right, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(values), left)))))
  hint Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(
      Alloc.Vec.impl_1__as_slice(Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(
        Alloc.Vec.impl_1__as_slice(values), left, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(values), right)))),
      right, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(values), left)))
{
  exchange_preserves_births(values, left, right);
}
type sift_state = (usize, births)
function sift_items(before: t_Slice(Native.t_BirthId), state: sift_state): Type0 {
  same_births(before, Alloc.Vec.impl_1__as_slice(state._2))
}
proof sift_preserves_births(values: births, start: usize, finish: usize): unit
  gives same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(Native.sift_births(values, start, finish)))
  hint Native.sift_births(values, start, finish)
{
  // The pinned model permits both32- and64-bit usize. Use the actual extracted
  // bound rather than silently assuming the target machine's64-bit value.
  break_preserve_any(mk_usize(0), (Rust_primitives.Integers.cast(Core_models.Num.impl_usize__BITS) : usize), sift_items(Alloc.Vec.impl_1__as_slice(values)));
  assert(same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(Native.sift_births(values, start, finish)))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf");
    Tactics.prune("Alloc.Slice.impl__to_vec");
    Tactics.smt_sync'(1, 1)
  }
}

proof heap_preserves_births(values: births, len: usize): unit
  gives same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(Native.heap_births(values, len)))
  hint Native.heap_births(values, len)
{
  Nickel.LoopUtil.plain_preserve_any(mk_usize(0), len /! mk_usize(2),
    ((_: nat, current: births) => same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(current))),
    ((current: births) => same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(current))));
  assert(same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(Native.heap_births(values, len)))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range");
    Tactics.prune("Nickel_crdt.Edit.sift_births");
    Tactics.smt_sync'(1, 1)
  }
}
function vector_items(before: t_Slice(Native.t_BirthId), values: births): Type0 {
  same_births(before, Alloc.Vec.impl_1__as_slice(values))
}
proof vector_index_exact(values: births, at: usize where v(at) < Seq.length(Alloc.Vec.impl_1__as_slice(values))): unit
  gives Core_models.Ops.Index.f_index(values, at) == Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(values), at)
  hint Core_models.Ops.Index.f_index(values, at)
{ () }
function drain_step(len: usize, current: births, step: Nickel.LoopUtil.position(mk_usize(0), len)): Flow.t_ControlFlow((unit, births), births) {
  const finish = (len -! mk_usize(1)) -! step;
  if Alloc.Vec.impl_1__is_empty(current) || Rust_primitives.Integers.gte(finish, Alloc.Vec.impl_1__len(current)) { Flow.ControlFlow_Break(((), current)) }
  else {
    const before = Alloc.Vec.impl_1__as_slice(current);
    const one = Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(before, mk_usize(0), Core_models.Ops.Index.f_index(current, finish)));
    const swapped = Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(Alloc.Vec.impl_1__as_slice(one), finish, Core_models.Ops.Index.f_index(current, mk_usize(0))));
    Flow.ControlFlow_Continue(Native.sift_births(swapped, mk_usize(0), finish))
  }
}
proof drain_step_preserves(original: t_Slice(Native.t_BirthId), len: usize, current: births, step: Nickel.LoopUtil.position(mk_usize(0), len)): unit
  takes vector_items(original, current)
  gives break_keeps(vector_items(original), drain_step(len, current, step))
{
  const finish = (len -! mk_usize(1)) -! step;
  if Alloc.Vec.impl_1__is_empty(current) || Rust_primitives.Integers.gte(finish, Alloc.Vec.impl_1__len(current)) {
    assert(break_keeps(vector_items(original), drain_step(len, current, step)));
  } else {
    const before = Alloc.Vec.impl_1__as_slice(current);
    const one = Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(before, mk_usize(0), Core_models.Ops.Index.f_index(current, finish)));
    const swapped = Alloc.Slice.impl__to_vec(Rust_primitives.Hax.Monomorphized_update_at.update_at_usize(Alloc.Vec.impl_1__as_slice(one), finish, Core_models.Ops.Index.f_index(current, mk_usize(0))));
    indexed_exchange_preserves(current, mk_usize(0), finish);
    sift_preserves_births(swapped, mk_usize(0), finish);
    assert(break_keeps(vector_items(original), drain_step(len, current, step))) by {
      Tactics.prune("Nickel_crdt.Edit.sift_births");
      Tactics.prune("Alloc.Slice.impl__to_vec");
      Tactics.smt_sync'(1, 1)
    }
  }
}
// Compare callback results pointwise. Equality of higher-order functions is not
// needed to transport this invariant to the actual extracted anonymous callback.
proof drain_callbacks_preserve(original: t_Slice(Native.t_BirthId), len: usize): unit
  gives forall(inv: Nickel.LoopUtil.total_invariant(births, mk_usize(0), len), initial: births,
    f: Nickel.LoopUtil.break_callback(births, mk_usize(0), len)) .
    (vector_items(original, initial) and
      (forall(current: births, at: Nickel.LoopUtil.position(mk_usize(0), len)) . f(current, at) == drain_step(len, current, at))) ==>
    vector_items(original, Folds.fold_range_cf(mk_usize(0), len, inv, initial, f))
{
  proof each(inv: Nickel.LoopUtil.total_invariant(births, mk_usize(0), len), initial: births,
    f: Nickel.LoopUtil.break_callback(births, mk_usize(0), len)): unit
    takes vector_items(original, initial)
    takes forall(current: births, at: Nickel.LoopUtil.position(mk_usize(0), len)) . f(current, at) == drain_step(len, current, at)
    gives vector_items(original, Folds.fold_range_cf(mk_usize(0), len, inv, initial, f))
  {
    FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(drain_step_preserves(original, len)));
    break_preserve_any(mk_usize(0), len, vector_items(original));
    assert(vector_items(original, Folds.fold_range_cf(mk_usize(0), len, inv, initial, f))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf");
      Tactics.prune("Nickel.EditDeletePermutation.drain_step");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_3(FStar.Classical.move_requires_3(each))
}
proof drain_preserves_births(values: births, len: usize): unit
  gives same_births(Alloc.Vec.impl_1__as_slice(values), Alloc.Vec.impl_1__as_slice(Native.drain_births(values, len)))
  hint Native.drain_births(values, len)
{
  drain_callbacks_preserve(Alloc.Vec.impl_1__as_slice(values), len);
  assert(vector_items(Alloc.Vec.impl_1__as_slice(values), Native.drain_births(values, len))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_cf");
    Tactics.prune("Nickel_crdt.Edit.sift_births");
    Tactics.prune("Alloc.Slice.impl__to_vec");
    Tactics.smt_sync'(1, 1)
  }
}
proof ordered_preserves_births(xs: t_Slice(Native.t_BirthId)): unit
  gives same_births(xs, Alloc.Vec.impl_1__as_slice(Native.ordered_births(xs)))
  hint Native.ordered_births(xs)
{
  const copied = Alloc.Slice.impl__to_vec(xs);
  const len = Alloc.Vec.impl_1__len(copied);
  copy_births_exact(xs);
  heap_preserves_births(copied, len);
  drain_preserves_births(Native.heap_births(copied, len), len);
  assert(same_births(xs, Alloc.Vec.impl_1__as_slice(Native.ordered_births(xs)))) by {
    Tactics.prune("Nickel_crdt.Edit.heap_births");
    Tactics.prune("Nickel_crdt.Edit.drain_births");
    Tactics.prune("Alloc.Slice.impl__to_vec");
    Tactics.smt_sync'(1, 1)
  }
}
