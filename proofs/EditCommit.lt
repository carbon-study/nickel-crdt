import Rust_primitives
import Core_models
import FStar.Pervasives
import FStar.NormSteps
import Nickel.EditAtomic
import Native = Nickel_crdt.Edit
import Result = Core_models.Result

// Compare the complete public-call results, not only their rendered text.
// The same before-instance receives the exact fact returned by local authoring.
function same_commit(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) =>
      match Native.impl_Replica__receive(before, fact) {
        (admitted, Result.Result_Ok(Native.Admission_Added)) =>
          next.f_facts == admitted.f_facts and
          next.f_tree == admitted.f_tree and
          next.f_writer == admitted.f_writer and
          next.f_limits == admitted.f_limits and
          v(next.f_next_counter) == v(before.f_next_counter) + 1,
        _ => Prims.l_False
      },
    _ => Prims.l_True
  }
}
proof authored_fact_replays_same_commit(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives same_commit(before, Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditAtomic.authored_edit_advances_once(before, gap, insert, delete);
  norm_spec([delta_only(["Nickel_crdt.Edit.impl_Replica__edit", "Nickel_crdt.Edit.next_counter_after", "Nickel_crdt.Edit.impl_Replica__with_counter", "Nickel_crdt.Edit.impl_Replica__receive", "Nickel.EditCommit.same_commit"]), iota, zeta_full, primops, unmeta, unascribe], same_commit(before, Native.impl_Replica__edit(before, gap, insert, delete)))
}

function private_unchanged(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (next, _) =>
    next.f_writer == before.f_writer and
    next.f_next_counter == before.f_next_counter and
    next.f_limits == before.f_limits
  }
}
proof receive_preserves_private_state(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives private_unchanged(before, Native.impl_Replica__receive(before, fact))
{
  norm_spec([delta_only(["Nickel_crdt.Edit.impl_Replica__receive", "Nickel_crdt.Edit.impl_Replica__plan", "Nickel.EditCommit.private_unchanged"]), iota, zeta_full, primops, unmeta, unascribe], private_unchanged(before, Native.impl_Replica__receive(before, fact)))
}

function requested_gap(gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global)): Core_models.Option.t_Option(usize) {
  if Alloc.Vec.impl_1__is_empty(insert) { Core_models.Option.Option_None } else { Core_models.Option.Option_Some(gap) }
}

function request_bound(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global), outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (_, Result.Result_Ok(Native.Local_Authored(fact))) =>
      fact.f_insert == insert and fact.f_delete == delete and
      Core_models.Option.Option_Some(fact.f_id.f_writer) == before.f_writer and
      fact.f_gap == requested_gap(gap, insert),
    _ => Prims.l_True
  }
}
proof authored_fact_binds_request(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives request_bound(before, gap, insert, delete, Native.impl_Replica__edit(before, gap, insert, delete))
{
  norm_spec([delta_only(["Nickel_crdt.Edit.impl_Replica__edit", "Nickel_crdt.Edit.next_counter_after", "Nickel_crdt.Edit.impl_Replica__with_counter", "Nickel.EditCommit.request_bound", "Nickel.EditCommit.requested_gap"]), iota, zeta_full, primops, unmeta, unascribe], request_bound(before, gap, insert, delete, Native.impl_Replica__edit(before, gap, insert, delete)))
}

function same_shared(left: Native.t_Replica, right: Native.t_Replica): Type0 {
  left.f_facts == right.f_facts and left.f_tree == right.f_tree and left.f_limits == right.f_limits
}
function same_admission(left: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error)), right: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match (left, right) { ((a, x), (b, y)) => x == y and same_shared(a, b) }
}
proof admission_ignores_private_state(before: Native.t_Replica, remote: Native.t_Replica where same_shared(before, remote), fact: Native.t_Fact): unit
  gives same_admission(Native.impl_Replica__receive(before, fact), Native.impl_Replica__receive(remote, fact))
{
  norm_spec([delta_only(["Nickel_crdt.Edit.impl_Replica__receive", "Nickel_crdt.Edit.impl_Replica__plan", "Nickel.EditCommit.same_admission", "Nickel.EditCommit.same_shared"]), iota, zeta_full, primops, unmeta, unascribe], same_admission(Native.impl_Replica__receive(before, fact), Native.impl_Replica__receive(remote, fact)))
}

function delivered_commit(remote: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) =>
      match Native.impl_Replica__receive(remote, fact) {
        (admitted, Result.Result_Ok(Native.Admission_Added)) =>
          same_shared(next, admitted) and
          admitted.f_writer == remote.f_writer and
          admitted.f_next_counter == remote.f_next_counter,
        _ => Prims.l_False
      },
    _ => Prims.l_True
  }
}
proof local_author_remote_admit(before: Native.t_Replica, remote: Native.t_Replica where same_shared(before, remote), gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives delivered_commit(remote, Native.impl_Replica__edit(before, gap, insert, delete))
{
  authored_fact_replays_same_commit(before, gap, insert, delete);
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (_, Result.Result_Ok(Native.Local_Authored(fact))) => {
      admission_ignores_private_state(before, remote, fact);
      receive_preserves_private_state(remote, fact)
    },
    _ => ()
  };
  norm_spec([delta_only(["Nickel.EditCommit.delivered_commit", "Nickel.EditCommit.same_commit", "Nickel.EditCommit.same_admission", "Nickel.EditCommit.same_shared", "Nickel.EditCommit.private_unchanged"]), iota, zeta_full, primops, unmeta, unascribe], delivered_commit(remote, Native.impl_Replica__edit(before, gap, insert, delete)))
}
