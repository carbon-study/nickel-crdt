import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.LoopUtil
import Native = Nickel_crdt.Event_layer
import Seq = FStar.Seq
import Option = Core_models.Option

// These scans only need the supplied comparison; equality laws belong to clients.
function absent_prefix<i: Type0>(ids: t_Slice(i), wanted: i, eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(ids)) . v(at) < finish ==> eq(Seq.index(ids, v(at)), wanted) == false
}
function member<i: Type0>(ids: t_Slice(i), wanted: i, eq: i => i => bool): Type0 {
  not absent_prefix(ids, wanted, eq, Seq.length(ids))
}
proof membership_is_exact<i: Type0>(ids: t_Slice(i), wanted: i, eq: i => i => bool): unit
  gives Native.has_id(ids, wanted, eq) == true <==> member(ids, wanted, eq)
  hint Native.has_id(ids, wanted, eq)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(ids),
    ((at: nat, _: unit) => absent_prefix(ids, wanted, eq, at)),
    ((_: unit) => not member(ids, wanted, eq)),
    ((b: bool) => b == true and member(ids, wanted, eq)));
  assert(Native.has_id(ids, wanted, eq) == true <==> member(ids, wanted, eq)) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
function all_ids<i: Type0>(ids: t_Slice(i), p: i => Type0): Type0 {
  forall(at: usize where v(at) < Seq.length(ids)) . p(Seq.index(ids, v(at)))
}
function ready_prefix<i: Type0>(after: t_Slice(i), done: t_Slice(i), eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(after)) . v(at) < finish ==> member(done, Seq.index(after, v(at)), eq)
}
proof readiness_is_exact<i: Type0>(after: t_Slice(i), done: t_Slice(i), eq: i => i => bool): unit
  gives Native.ready(after, done, eq) == true <==> all_ids(after, ((wanted: i) => member(done, wanted, eq)))
  hint Native.ready(after, done, eq)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(after),
    ((at: nat, _: unit) => ready_prefix(after, done, eq, at)),
    ((_: unit) => all_ids(after, ((wanted: i) => member(done, wanted, eq)))),
    ((b: bool) => b == false and not all_ids(after, ((wanted: i) => member(done, wanted, eq)))));
  assert(Native.ready(after, done, eq) == true <==> all_ids(after, ((wanted: i) => member(done, wanted, eq)))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.smt_sync'(1, 1)
  }
}
function eligible<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool,
  at: nat where at < Seq.length(facts)): Type0 {
  not member(done, id(Seq.index(facts, at)), eq) and
  all_ids(after(Seq.index(facts, at)), ((wanted: i) => member(done, wanted, eq)))
}
function no_eligible_prefix<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(facts)) . v(at) < finish ==> not eligible(facts, done, id, after, eq, v(at))
}
function chosen_is_first<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool, result: Option.t_Option(usize)): Type0 {
  match result {
    Option.Option_None => no_eligible_prefix(facts, done, id, after, eq, Seq.length(facts)),
    Option.Option_Some(at) => v(at) < Seq.length(facts) and
      (v(at) < Seq.length(facts) ==> eligible(facts, done, id, after, eq, v(at)) and no_eligible_prefix(facts, done, id, after, eq, v(at)))
  }
}
proof scheduler_choice_is_exact<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool): unit
  gives chosen_is_first(facts, done, id, after, eq, Native.choose_ready(facts, done, id, after, eq))
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((at: nat, _: unit) => no_eligible_prefix(facts, done, id, after, eq, at)),
    ((_: unit) => no_eligible_prefix(facts, done, id, after, eq, Seq.length(facts))),
    chosen_is_first(facts, done, id, after, eq));
  assert(chosen_is_first(facts, done, id, after, eq, Native.choose_ready(facts, done, id, after, eq))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.prune("Nickel_crdt.Event_layer.ready");
    Tactics.smt_sync'(1, 1)
  }
}

function fact_absent_prefix<f: Type0, i: Type0>(facts: t_Slice(f), wanted: i, id: f => i, eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(facts)) . v(at) < finish ==> eq(id(Seq.index(facts, v(at))), wanted) == false
}
proof fact_membership_is_exact<f: Type0, i: Type0>(facts: t_Slice(f), wanted: i, id: f => i, eq: i => i => bool): unit
  gives Native.has_fact(facts, wanted, id, eq) == true <==> not fact_absent_prefix(facts, wanted, id, eq, Seq.length(facts))
  hint Native.has_fact(facts, wanted, id, eq)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((at: nat, _: unit) => fact_absent_prefix(facts, wanted, id, eq, at)),
    ((_: unit) => fact_absent_prefix(facts, wanted, id, eq, Seq.length(facts))),
    ((b: bool) => b == true and not fact_absent_prefix(facts, wanted, id, eq, Seq.length(facts))));
  assert(Native.has_fact(facts, wanted, id, eq) == true <==> not fact_absent_prefix(facts, wanted, id, eq, Seq.length(facts))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
