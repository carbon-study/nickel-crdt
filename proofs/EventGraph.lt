import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.LoopUtil
import Native = Nickel_crdt.Event_layer
import Seq = FStar.Seq
import Option = Core_models.Option
import Result = Core_models.Result
import Tactics = FStar.Tactics.V2

// Same arbitrary callback domain, now bundled without extra semantic premises.
unfold type graph_fields(f: Type0, i: Type0) =
  (f => i, f => t_Slice(i), i => i => bool, i => i => bool, f => f, f => f => bool)
unfold type graph_errors(e: Type0) = (unit => e, unit => e)
unfold type graph_ops(f: Type0, i: Type0, e: Type0) =
  (graph_fields(f, i), graph_errors(e))
unfold type admission_errors(e: Type0) = (unit => e, unit => e)
unfold type admission_fields(i: Type0, e: Type0) =
  (i => Option.t_Option(i), i => i => bool, admission_errors(e))
unfold type event_ops(f: Type0, i: Type0, e: Type0) =
  (graph_ops(f, i, e), admission_fields(i, e))


// Constructor contracts pin logical callback identities, including same-typed slots.
function graph_callbacks_match<f: Type0, i: Type0, e: Type0>(ops: graph_ops(f, i, e),
  id: f => i, after: f => t_Slice(i), eq: i => i => bool, lt: i => i => bool,
  copy: f => f, same: f => f => bool, internal: unit => e, missing: unit => e): Type0 {
  (ops._1._1 == id) and (ops._1._2 == after) and (ops._1._3 == eq) and
  (ops._1._4 == lt) and (ops._1._5 == copy) and (ops._1._6 == same) and
  (ops._2._1 == internal) and (ops._2._2 == missing)
}
proof graph_ops_preserve_callbacks<f: Type0, i: Type0, e: Type0>(
  id: f => i, after: f => t_Slice(i), eq: i => i => bool, lt: i => i => bool,
  copy: f => f, same: f => f => bool, internal: unit => e, missing: unit => e): unit
  gives graph_callbacks_match(Native.graph_ops(id, after, eq, lt, copy, same, internal, missing),
    id, after, eq, lt, copy, same, internal, missing)
{ () }
function event_callbacks_match<f: Type0, i: Type0, e: Type0>(ops: event_ops(f, i, e),
  graph: graph_ops(f, i, e), predecessor: i => Option.t_Option(i), forbidden: i => i => bool,
  duplicate: unit => e, producer: unit => e): Type0 {
  (ops._1 == graph) and (ops._2._1 == predecessor) and (ops._2._2 == forbidden) and
  (ops._2._3._1 == duplicate) and (ops._2._3._2 == producer)
}
proof event_ops_preserve_callbacks<f: Type0, i: Type0, e: Type0>(
  graph: graph_ops(f, i, e), predecessor: i => Option.t_Option(i), forbidden: i => i => bool,
  duplicate: unit => e, producer: unit => e): unit
  gives event_callbacks_match(Native.event_ops(graph, predecessor, forbidden, duplicate, producer),
    graph, predecessor, forbidden, duplicate, producer)
{ () }

// These scans only need the supplied comparison; equality laws belong to clients.
function absent_prefix<i: Type0>(ids: t_Slice(i), wanted: i, eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(ids)) . v(at) < finish ==> eq(Seq.index(ids, v(at)), wanted) == false
}
function member<i: Type0>(ids: t_Slice(i), wanted: i, eq: i => i => bool): Type0 {
  not absent_prefix(ids, wanted, eq, Seq.length(ids))
}
proof membership_is_exact<f: Type0, i: Type0, e: Type0>(ids: t_Slice(i), wanted: i, ops: graph_ops(f, i, e)): unit
  gives Native.has_id(ids, wanted, ops) == true <==> member(ids, wanted, ops._1._3)
  hint Native.has_id(ids, wanted, ops)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(ids),
    ((at: nat, _: unit) => absent_prefix(ids, wanted, ops._1._3, at)),
    ((_: unit) => not member(ids, wanted, ops._1._3)),
    ((b: bool) => b == true and member(ids, wanted, ops._1._3)));
  assert(Native.has_id(ids, wanted, ops) == true <==> member(ids, wanted, ops._1._3)) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
function all_ids<i: Type0>(ids: t_Slice(i), p: i => Type0): Type0 {
  forall(at: usize where v(at) < Seq.length(ids)) . p(Seq.index(ids, v(at)))
}
function ready_prefix<i: Type0>(after: t_Slice(i), done: t_Slice(i), eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(after)) . v(at) < finish ==> member(done, Seq.index(after, v(at)), eq)
}
proof readiness_is_exact<f: Type0, i: Type0, e: Type0>(after: t_Slice(i), done: t_Slice(i), ops: graph_ops(f, i, e)): unit
  gives Native.ready(after, done, ops) == true <==> all_ids(after, ((wanted: i) => member(done, wanted, ops._1._3)))
  hint Native.ready(after, done, ops)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(after),
    ((at: nat, _: unit) => ready_prefix(after, done, ops._1._3, at)),
    ((_: unit) => all_ids(after, ((wanted: i) => member(done, wanted, ops._1._3)))),
    ((b: bool) => b == false and not all_ids(after, ((wanted: i) => member(done, wanted, ops._1._3)))));
  assert(Native.ready(after, done, ops) == true <==> all_ids(after, ((wanted: i) => member(done, wanted, ops._1._3)))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.smt_sync'(1, 1)
  }
}
function eligible<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool,
  at: nat where at < Seq.length(facts)): Type0 {
  not member(done, id(Seq.index(facts, at)), eq) and
  all_ids(after(Seq.index(facts, at)), ((wanted: i) => member(done, wanted, eq)))
}
function no_eligible_prefix<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(facts)) . v(at) < finish ==> not eligible(facts, done, id, after, eq, v(at))
}
function chosen_is_first<f: Type0, i: Type0>(facts: t_Slice(f), done: t_Slice(i), id: f => i, after: f => t_Slice(i), eq: i => i => bool, result: Option.t_Option(usize)): Type0 {
  match result {
    Option.Option_None => no_eligible_prefix(facts, done, id, after, eq, Seq.length(facts)),
    Option.Option_Some(at) => v(at) < Seq.length(facts) and
      (v(at) < Seq.length(facts) ==> eligible(facts, done, id, after, eq, v(at)) and no_eligible_prefix(facts, done, id, after, eq, v(at)))
  }
}
proof scheduler_choice_is_exact<f: Type0, i: Type0, e: Type0>(facts: t_Slice(f), done: t_Slice(i), ops: graph_ops(f, i, e)): unit
  gives chosen_is_first(facts, done, ops._1._1, ops._1._2, ops._1._3, Native.choose_ready(facts, done, ops))
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((at: nat, _: unit) => no_eligible_prefix(facts, done, ops._1._1, ops._1._2, ops._1._3, at)),
    ((_: unit) => no_eligible_prefix(facts, done, ops._1._1, ops._1._2, ops._1._3, Seq.length(facts))),
    chosen_is_first(facts, done, ops._1._1, ops._1._2, ops._1._3));
  assert(chosen_is_first(facts, done, ops._1._1, ops._1._2, ops._1._3, Native.choose_ready(facts, done, ops))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.prune("Nickel_crdt.Event_layer.ready");
    Tactics.smt_sync'(1, 1)
  }
}

function fact_absent_prefix<f: Type0, i: Type0>(facts: t_Slice(f), wanted: i, id: f => i, eq: i => i => bool, finish: nat): Type0 {
  forall(at: usize where v(at) < Seq.length(facts)) . v(at) < finish ==> eq(id(Seq.index(facts, v(at))), wanted) == false
}
proof fact_membership_is_exact<f: Type0, i: Type0, e: Type0>(facts: t_Slice(f), wanted: i, ops: graph_ops(f, i, e)): unit
  gives Native.has_fact(facts, wanted, ops) == true <==> not fact_absent_prefix(facts, wanted, ops._1._1, ops._1._3, Seq.length(facts))
  hint Native.has_fact(facts, wanted, ops)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((at: nat, _: unit) => fact_absent_prefix(facts, wanted, ops._1._1, ops._1._3, at)),
    ((_: unit) => fact_absent_prefix(facts, wanted, ops._1._1, ops._1._3, Seq.length(facts))),
    ((b: bool) => b == true and not fact_absent_prefix(facts, wanted, ops._1._1, ops._1._3, Seq.length(facts))));
  assert(Native.has_fact(facts, wanted, ops) == true <==> not fact_absent_prefix(facts, wanted, ops._1._1, ops._1._3, Seq.length(facts))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

// Successful shared admission checks exactly the returned selection.
// No equality, ordering, closed-history or callback laws are assumed here.
function no_forbidden_prefix<ft: Type0, it: Type0, et: Type0>(facts: t_Slice(ft), offered: ft, eops: event_ops(ft, it, et),
  selected: Alloc.Vec.t_Vec(it, Alloc.Alloc.t_Global), at: nat): Type0 {
  forall(j: nat) . (j < at and j < Seq.length(facts)) ==>
    not (Native.has_id(Alloc.Vec.impl_1__as_slice(selected), eops._1._1._1(Seq.index(facts, j)), eops._1) == true and
         eops._2._2(eops._1._1._1(Seq.index(facts, j)), eops._1._1._1(offered)) == true)
}
function stream_checks<ft: Type0, it: Type0, et: Type0>(facts: t_Slice(ft), offered: ft, eops: event_ops(ft, it, et),
  selected: Alloc.Vec.t_Vec(it, Alloc.Alloc.t_Global)): Type0 {
  (match eops._2._1(eops._1._1._1(offered)) {
    Option.Option_Some(prev) => Native.has_id(Alloc.Vec.impl_1__as_slice(selected), prev, eops._1) == true,
    Option.Option_None => Prims.l_True,
  } : Type0) and
  no_forbidden_prefix(facts, offered, eops, selected, Seq.length(facts))
}
// A successful shared admission checked the predecessor and the forbidden-ancestor rule
// against exactly its selection.
proof validated_stream_checks<ft: Type0, it: Type0, et: Type0>(facts: t_Slice(ft), offered: ft,
  eops: event_ops(ft, it, et)): unit
  gives forall(selected: Alloc.Vec.t_Vec(it, Alloc.Alloc.t_Global)) . Native.validate_event(facts, offered, eops) == Result.Result_Ok(selected) ==>
    stream_checks(facts, offered, eops, selected)
{
  assert(eops == (eops._1, (eops._2._1, eops._2._2, (eops._2._3._1, eops._2._3._2))));
  assert(eops._1 == ((eops._1._1._1, eops._1._1._2, eops._1._1._3, eops._1._1._4, eops._1._1._5, eops._1._1._6), (eops._1._2._1, eops._1._2._2)));
  proof membership_boolean(ids: t_Slice(it), id: it): unit
    gives Native.has_id(ids, id, eops._1) == true or Native.has_id(ids, id, eops._1) == false
    hint Native.has_id(ids, id, eops._1)
  { () };
  match Native.past(facts, eops._1._1._2(offered), eops._1) {
    Result.Result_Ok(past_ids) => {
      Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
        ((at: nat, _: unit) => no_forbidden_prefix(facts, offered, eops, past_ids, at)), ((_: unit) => past_ids),
        ((x: Alloc.Vec.t_Vec(it, Alloc.Alloc.t_Global)) => x == past_ids and no_forbidden_prefix(facts, offered, eops, past_ids, Seq.length(facts))),
        ((_: et) => Prims.l_True));
      assert(forall(selected: Alloc.Vec.t_Vec(it, Alloc.Alloc.t_Global)) . Native.validate_event(facts, offered, eops) == Result.Result_Ok(selected) ==>
        stream_checks(facts, offered, eops, selected)) by {
        Tactics.prune("Nickel_crdt.Event_layer.past");
        Tactics.prune("Nickel_crdt.Event_layer.has_id");
        Tactics.prune("Nickel_crdt.Event_layer.duplicate_ids");
        Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
        Tactics.smt_sync'(1, 1)
      }
    },
    Result.Result_Err(_) => {
      assert(forall(selected: Alloc.Vec.t_Vec(it, Alloc.Alloc.t_Global)) . Native.validate_event(facts, offered, eops) == Result.Result_Ok(selected) ==>
        stream_checks(facts, offered, eops, selected)) by {
        Tactics.prune("Nickel_crdt.Event_layer.past");
        Tactics.prune("Nickel_crdt.Event_layer.has_id");
        Tactics.prune("Nickel_crdt.Event_layer.duplicate_ids");
        Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
