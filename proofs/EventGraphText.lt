import Rust_primitives
import Core_models
import FStar.Pervasives
import Native = Nickel_crdt.Edit
import Shared = Nickel_crdt.Event_layer
import Nickel.EventGraph
import Tactics = FStar.Tactics.V2

// A semantic spelling of the exact client policy, independent of its constant.
function text_graph_ops(): Nickel.EventGraph.graph_ops(Native.t_Fact, Native.t_EventId, Native.t_Error) {
  Shared.graph_ops(Native.fact_id, Native.fact_after, Native.same_event_id,
    Native.earlier_event_id, Native.clone_selected_fact, Native.fact_equal,
    Native.internal_error, Native.missing_error)
}
function text_event_ops(): Nickel.EventGraph.event_ops(Native.t_Fact, Native.t_EventId, Native.t_Error) {
  Shared.event_ops(text_graph_ops(), Native.required_predecessor, Native.forbidden_ancestor,

    Native.duplicate_dependency_error, Native.predecessor_error)
}
proof text_graph_callbacks_are_exact(): unit
  gives Nickel.EventGraph.graph_callbacks_match(text_graph_ops(),
    Native.fact_id, Native.fact_after, Native.same_event_id, Native.earlier_event_id,
    Native.clone_selected_fact, Native.fact_equal, Native.internal_error, Native.missing_error)
{
  Nickel.EventGraph.graph_ops_preserve_callbacks(Native.fact_id, Native.fact_after,
    Native.same_event_id, Native.earlier_event_id, Native.clone_selected_fact,
    Native.fact_equal, Native.internal_error, Native.missing_error);
  assert(Nickel.EventGraph.graph_callbacks_match(text_graph_ops(),
    Native.fact_id, Native.fact_after, Native.same_event_id, Native.earlier_event_id,
    Native.clone_selected_fact, Native.fact_equal, Native.internal_error, Native.missing_error)) by {
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.smt_sync'(1, 1)
  }
}

proof text_policy_is_exact(): unit
  gives Native.v_TEXT_OPS == text_event_ops()
{ () }

proof text_graph_policy_is_exact(): unit
  gives Native.v_TEXT_OPS._1 == text_graph_ops()
{
  text_policy_is_exact();
  Nickel.EventGraph.event_ops_preserve_callbacks(text_graph_ops(), Native.required_predecessor,
    Native.forbidden_ancestor,
    Native.duplicate_dependency_error, Native.predecessor_error);
  assert(Native.v_TEXT_OPS._1 == text_graph_ops()) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.smt_sync'(1, 1)
  }
}

// Exact specializations let checked text contracts apply at shared inner calls.
// Each right-hand side is the actual retained text wrapper, with no new algorithm.
proof has_fact_is_text_call(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  gives Shared.has_fact(facts, id, text_graph_ops()) == Native.has_fact(facts, id)
  hint Shared.has_fact(facts, id, text_graph_ops())
{
  text_graph_policy_is_exact();
  assert(Shared.has_fact(facts, id, text_graph_ops()) == Native.has_fact(facts, id)) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.smt_sync'(1, 1)
  }
}


