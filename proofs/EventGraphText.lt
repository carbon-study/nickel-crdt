proof push_is_text_call<item: Type0>(before: Alloc.Vec.t_Vec(item, Alloc.Alloc.t_Global), value: item): unit
  gives Shared.push(before, value, Native.internal_error) == Native.push(before, value)
  hint Shared.push(before, value, Native.internal_error)
{ () }
proof clone_is_text_call(fact: Native.t_Fact): unit
  gives Shared.clone_selected_fact(fact, Native.clone_selected_fact) == Native.clone_selected_fact(fact)
  hint Shared.clone_selected_fact(fact, Native.clone_selected_fact)
{ () }

// The shared scheduler invokes these exact concrete text callbacks.
proof scheduler_choice_is_text_call(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): unit
  gives Native.scheduled_choose((), facts, done) == Native.choose_ready(facts, done)
  hint Native.scheduled_choose((), facts, done)
{ () }
proof scheduler_application_is_text_call(facts: t_Slice(Native.t_Fact), event: Native.t_Fact,
  operations: t_Slice((Native.t_EventId, Alloc.Vec.t_Vec(Native.t_Node, Alloc.Alloc.t_Global))), tree: Native.t_Tree): unit
  gives Native.scheduled_apply((), facts, event, operations, tree) == Native.interpret_event(facts, event, operations, tree)
  hint Native.scheduled_apply((), facts, event, operations, tree)
{ () }
