import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.EventGraph
import Nickel.LoopUtil
import Nickel.Vector
import Native = Nickel_crdt.Event_layer
import Seq = FStar.Seq
import Option = Core_models.Option
import Result = Core_models.Result
import Tactics = FStar.Tactics.V2
import FStar.Fin
import FStar.Classical

type vector(f: Type0) = Alloc.Vec.t_Vec(f, Alloc.Alloc.t_Global)
function exact_values<f: Type0, i: Type0, e: Type0>(ops: Nickel.EventGraph.graph_ops(f, i, e)): Type0 {
  (forall(a: i, b: i) . (ops._1._3(a, b) == true <==> a == b)) and
  (forall(a: f) . ops._1._5(a) == a) and
  (forall(a: f, b: f) . (ops._1._6(a, b) == true <==> a == b))
}
function present<f: Type0>(input: t_Slice(f), item: f): Type0 {
  exists(j: nat) . j < Seq.length(input) and Seq.index(input, j) == item
}
function unique<f: Type0, i: Type0>(items: t_Slice(f), id: f => i): Type0 {
  forall(a: nat, b: nat) . (a < Seq.length(items) and b < Seq.length(items) and
    id(Seq.index(items, a)) == id(Seq.index(items, b))) ==> a == b
}
function content_prefix<f: Type0, i: Type0>(input: t_Slice(f), at: nat, out: vector(f), id: f => i): Type0 {
  Seq.length(Alloc.Vec.impl_1__as_slice(out)) == at and
  (forall(j: nat) . j < Seq.length(Alloc.Vec.impl_1__as_slice(out)) ==>
    present(input, Seq.index(Alloc.Vec.impl_1__as_slice(out), j))) and
  unique(Alloc.Vec.impl_1__as_slice(out), id)
}
function push_outcome<f: Type0, e: Type0>(before: vector(f), item: f, internal: unit => e): (vector(f), Result.t_Result(unit, e)) {
  if v(Alloc.Vec.impl_1__len(before)) ==? max_usize {
    (before, Result.Result_Err(internal(())))
  } else {
    (Alloc.Vec.from_seq(Seq.append(Alloc.Vec.impl_1__as_slice(before), Seq.create(1, item))), Result.Result_Ok(()))
  }
}
proof push_is_exact<f: Type0, e: Type0>(before: vector(f), item: f, internal: unit => e): unit
  gives Native.push(before, item, internal) == push_outcome(before, item, internal)
  hint Native.push(before, item, internal)
{ () }
function fresh_prefix<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: t_Slice(f), ops: Nickel.EventGraph.graph_ops(f, i, e), at: nat, choice: Option.t_Option(usize)): Type0 {
  match choice {
    Option.Option_None => Prims.l_True,
    Option.Option_Some(k) => v(k) < at and v(k) < Seq.length(input) and
      not (Native.has_fact(out, ops._1._1(Rust_primitives.Slice.slice_index(input, k)), ops) == true),
  }
}
function fresh_choice<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: t_Slice(f), ops: Nickel.EventGraph.graph_ops(f, i, e), choice: Option.t_Option(usize)): Type0 {
  fresh_prefix(input, out, ops, Seq.length(input), choice)
}
proof choose_is_fresh<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: t_Slice(f), ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  gives Nickel.LoopUtil.result_safe(fresh_choice(input, out, ops), ((_: e) => Prims.l_True), Native.choose_unseen(input, out, ops))
  hint Native.choose_unseen(input, out, ops)
{
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(input),
    ((at: nat, choice: Option.t_Option(usize)) => fresh_prefix(input, out, ops, at, choice)),
    ((choice: Option.t_Option(usize)) => choice), fresh_choice(input, out, ops), ((_: e) => Prims.l_True));
  assert(Nickel.LoopUtil.result_safe(fresh_choice(input, out, ops), ((_: e) => Prims.l_True), Native.choose_unseen(input, out, ops))) by {
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
function appended_content<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: vector(f), ops: Nickel.EventGraph.graph_ops(f, i, e), result: (vector(f), Result.t_Result(unit, e))): Type0 {
  match result {
    (next, Result.Result_Ok(_)) => content_prefix(input, Seq.length(Alloc.Vec.impl_1__as_slice(out)) + 1, next, ops._1._1),
    _ => Prims.l_True,
  }
}
proof append_preserves_content<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: vector(f), item: f, ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  takes exact_values(ops)
  takes content_prefix(input, Seq.length(Alloc.Vec.impl_1__as_slice(out)), out, ops._1._1)
  takes present(input, item)
  takes not (Native.has_fact(Alloc.Vec.impl_1__as_slice(out), ops._1._1(item), ops) == true)
  gives appended_content(input, out, ops, Native.push(out, item, ops._2._1))
{
  Nickel.EventGraph.fact_membership_is_exact(Alloc.Vec.impl_1__as_slice(out), ops._1._1(item), ops);
  proof each_absent(j: nat where j < Seq.length(Alloc.Vec.impl_1__as_slice(out))): unit
    gives ops._1._1(Seq.index(Alloc.Vec.impl_1__as_slice(out), j)) =!= ops._1._1(item)
  {
    assert(v(mk_usize(j)) == j);
    assert(ops._1._3(ops._1._1(Seq.index(Alloc.Vec.impl_1__as_slice(out), v(mk_usize(j)))), ops._1._1(item)) == false) by {
      Tactics.prune("Nickel_crdt.Event_layer.has_fact");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro(each_absent);
  push_is_exact(out, item, ops._2._1);
  Nickel.Vector.vector_length(out);
  if v(Alloc.Vec.impl_1__len(out)) ==? max_usize { () } else {
  Nickel.Vector.vector_from_seq_value(Seq.append(Alloc.Vec.impl_1__as_slice(out), Seq.create(1, item)))
  };
  assert(appended_content(input, out, ops, Native.push(out, item, ops._2._1))) by {
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
proof copy_selected_is_exact<f: Type0>(item: f, copy: f => f): unit
  takes copy(item) == item
  gives Native.clone_selected_fact(item, copy) == item
  hint Native.clone_selected_fact(item, copy)
{ () }
// Exact native control flow, with called choice/copy/append bodies withheld.
function step_result<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: vector(f), ops: Nickel.EventGraph.graph_ops(f, i, e)): Result.t_Result(vector(f), e) {
  match Native.choose_unseen(input, Alloc.Vec.impl_1__as_slice(out), ops) {
    Result.Result_Err(err) => Result.Result_Err(err),
    Result.Result_Ok(Option.Option_None) => Result.Result_Err(ops._2._1(())),
    Result.Result_Ok(Option.Option_Some(k)) => if v(k) < Seq.length(input) {
      match Native.push(out, Native.clone_selected_fact(Rust_primitives.Slice.slice_index(input, k), ops._1._5), ops._2._1) {
        (next, Result.Result_Ok(_)) => Result.Result_Ok(next),
        (_, Result.Result_Err(err)) => Result.Result_Err(err),
      }
    } else { Result.Result_Err(ops._2._1(())) },
  }
}
proof step_uses_selected_fact<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: vector(f), ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  gives Native.canonical_step(input, out, ops) == step_result(input, out, ops)
{
  assert(Native.canonical_step(input, out, ops) == step_result(input, out, ops)) by {
    Tactics.prune("Nickel_crdt.Event_layer.choose_unseen");
    Tactics.prune("Nickel_crdt.Event_layer.clone_selected_fact");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
proof step_preserves_content<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: vector(f), at: nat, ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  takes exact_values(ops)
  takes content_prefix(input, at, out, ops._1._1)
  gives Nickel.LoopUtil.result_safe(((next: vector(f)) => content_prefix(input, at + 1, next, ops._1._1)), ((_: e) => Prims.l_True), Native.canonical_step(input, out, ops))
{
  step_uses_selected_fact(input, out, ops);
  choose_is_fresh(input, Alloc.Vec.impl_1__as_slice(out), ops);
  assert(Nickel.LoopUtil.result_safe(fresh_choice(input, Alloc.Vec.impl_1__as_slice(out), ops), ((_: e) => Prims.l_True), Native.choose_unseen(input, Alloc.Vec.impl_1__as_slice(out), ops))) by {
    Tactics.prune("Nickel_crdt.Event_layer.choose_unseen");
    Tactics.smt_sync'(1, 1)
  };
  match Native.choose_unseen(input, Alloc.Vec.impl_1__as_slice(out), ops) {
    Result.Result_Ok(Option.Option_Some(k)) => if v(k) < Seq.length(input) {
      copy_selected_is_exact(Rust_primitives.Slice.slice_index(input, k), ops._1._5);
      assert(present(input, Rust_primitives.Slice.slice_index(input, k)));
      append_preserves_content(input, out, Rust_primitives.Slice.slice_index(input, k), ops)
    } else { () },
    _ => (),
  };
  assert(Nickel.LoopUtil.result_safe(((next: vector(f)) => content_prefix(input, at + 1, next, ops._1._1)), ((_: e) => Prims.l_True), Native.canonical_step(input, out, ops))) by {
    Tactics.prune("Nickel_crdt.Event_layer.choose_unseen");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.clone_selected_fact");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
proof canonical_selects_whole_facts<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  takes exact_values(ops)
  gives Nickel.LoopUtil.result_safe(((out: vector(f)) => content_prefix(input, Seq.length(input), out, ops._1._1)), ((_: e) => Prims.l_True), Native.canonical(input, ops))
{
  Nickel.Vector.empty_vector_value<#f>();
  proof each_step(out: vector(f)): unit
    takes content_prefix(input, Seq.length(Alloc.Vec.impl_1__as_slice(out)), out, ops._1._1)
    gives Nickel.LoopUtil.result_safe(((next: vector(f)) => content_prefix(input, Seq.length(Alloc.Vec.impl_1__as_slice(out)) + 1, next, ops._1._1)), ((_: e) => Prims.l_True), Native.canonical_step(input, out, ops))
    hint Native.canonical_step(input, out, ops)
  {
    step_preserves_content(input, out, Seq.length(Alloc.Vec.impl_1__as_slice(out)), ops);
    assert(Nickel.LoopUtil.result_safe(((next: vector(f)) => content_prefix(input, Seq.length(Alloc.Vec.impl_1__as_slice(out)) + 1, next, ops._1._1)), ((_: e) => Prims.l_True), Native.canonical_step(input, out, ops))) by {
      Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
      Tactics.smt_sync'(1, 1)
    }
  };
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(input),
    ((at: nat, out: vector(f)) => content_prefix(input, at, out, ops._1._1)),
    ((out: vector(f)) => out), ((out: vector(f)) => content_prefix(input, Seq.length(input), out, ops._1._1)), ((_: e) => Prims.l_True));
  assert(Nickel.LoopUtil.result_safe(((out: vector(f)) => content_prefix(input, Seq.length(input), out, ops._1._1)), ((_: e) => Prims.l_True), Native.canonical(input, ops))) by {
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

// Finite coverage: enough distinct selected originals leave no missing original.
function position<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), item: f where present(input, item),
  ops: Nickel.EventGraph.graph_ops(f, i, e) where exact_values(ops)): at: nat where at < Seq.length(input) and Seq.index(input, at) == item {
  match FStar.Fin.find(input, ((old: f) => ops._1._6(old, item)), 0) {
    Some(at) => at,
    None => 0,
  }
}
function squeezed<f: Type0, i: Type0, e: Type0>(input: t_Slice(f) where Seq.length(input) > 1,
  ops: Nickel.EventGraph.graph_ops(f, i, e) where exact_values(ops),
  out: vector(f) where content_prefix(input, Seq.length(input), out, ops._1._1),
  missing: nat where missing < Seq.length(input) and not present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, missing)),
  at: nat where at < Seq.length(Alloc.Vec.impl_1__as_slice(out))): FStar.Fin.under(Seq.length(input) - 1) {
  const pos = position(input, Seq.index(Alloc.Vec.impl_1__as_slice(out), at), ops);
  if pos < missing { pos } else { pos - 1 }
}
proof squeeze_collision<f: Type0, i: Type0, e: Type0>(input: t_Slice(f) where Seq.length(input) > 1,
  ops: Nickel.EventGraph.graph_ops(f, i, e) where exact_values(ops),
  out: vector(f) where content_prefix(input, Seq.length(input), out, ops._1._1),
  missing: nat where missing < Seq.length(input) and not present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, missing)),
  a: nat where a < Seq.length(Alloc.Vec.impl_1__as_slice(out)), b: nat where b < Seq.length(Alloc.Vec.impl_1__as_slice(out))): unit
  takes squeezed(input, ops, out, missing, a) == squeezed(input, ops, out, missing, b)
  gives a == b
{ () }
proof whole_selection_covers<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), out: vector(f), ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  takes exact_values(ops)
  takes content_prefix(input, Seq.length(input), out, ops._1._1)
  gives forall(item: f) . present(input, item) <==> present(Alloc.Vec.impl_1__as_slice(out), item)
{
  proof no_missing(at: nat where at < Seq.length(input)): unit
    takes not present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at))
    gives Prims.l_False
  {
    if Seq.length(input) > 1 {
      const positions = Seq.init(Seq.length(input), squeezed(input, ops, out, at));
      Seq.lemma_init_len(Seq.length(input), squeezed(input, ops, out, at));
      Seq.init_index(Seq.length(input), squeezed(input, ops, out, at));
      match FStar.Fin.pigeonhole(positions) {
        (a, b) => {
          assert(a < b);
          assert(squeezed(input, ops, out, at, a) == squeezed(input, ops, out, at, b));
          squeeze_collision(input, ops, out, at, a, b)
        }
      }
    } else {
      assert(Seq.length(input) == 1);
      assert(present(input, Seq.index(Alloc.Vec.impl_1__as_slice(out), 0)));
      assert(Seq.index(Alloc.Vec.impl_1__as_slice(out), 0) == Seq.index(input, at));
      assert(present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at)))
    }
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(no_missing));
  ()
}
function exact_contents<f: Type0>(input: t_Slice(f), out: vector(f)): Type0 {
  Seq.length(Alloc.Vec.impl_1__as_slice(out)) == Seq.length(input) and
  (forall(item: f) . present(input, item) <==> present(Alloc.Vec.impl_1__as_slice(out), item))
}
proof canonical_preserves_exact_contents<f: Type0, i: Type0, e: Type0>(input: t_Slice(f), ops: Nickel.EventGraph.graph_ops(f, i, e)): unit
  takes exact_values(ops)
  gives Nickel.LoopUtil.result_safe(exact_contents(input), ((_: e) => Prims.l_True), Native.canonical(input, ops))
{
  canonical_selects_whole_facts(input, ops);
  match Native.canonical(input, ops) {
    Result.Result_Ok(out) => whole_selection_covers(input, out, ops),
    _ => (),
  };
  ()
}
