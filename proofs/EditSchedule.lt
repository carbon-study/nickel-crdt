import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.Vector
import Nickel.LoopUtil
import Nickel.EditPast
import Native = Nickel_crdt.Edit
import Seq = FStar.Seq
import Option = Core_models.Option

// A dependency is ready exactly when every direct predecessor has run.
function ready_prefix(after: t_Slice(Native.t_EventId), done: t_Slice(Native.t_EventId), finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(after)) . v(i) < finish ==> member(done, Seq.index(after, v(i)))
}
proof readiness_is_exact(after: t_Slice(Native.t_EventId), done: t_Slice(Native.t_EventId)): unit
  gives Native.ready(after, done) == true <==> all_ids(after, member(done))
  hint Native.ready(after, done)
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(after),
    ((at: nat, _: unit) => ready_prefix(after, done, at)),
    ((_: unit) => all_ids(after, member(done))),
    ((b: bool) => b == false and not all_ids(after, member(done))));
  assert(Native.ready(after, done) == true <==> all_ids(after, member(done))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.has_event");
    Tactics.smt_sync'(1, 1)
  }
}
function eligible(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), i: nat where i < Seq.length(facts)): Type0 {
  not member(done, Seq.index(facts, i).f_id) and
  all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, i).f_after), member(done))
}
function no_eligible_prefix(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(facts)) . v(i) < finish ==> not eligible(facts, done, v(i))
}
function chosen_is_first(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), result: Option.t_Option(usize)): Type0 {
  match result {
    Option.Option_None => no_eligible_prefix(facts, done, Seq.length(facts)),
    Option.Option_Some(i) => v(i) < Seq.length(facts) and
      (v(i) < Seq.length(facts) ==> eligible(facts, done, v(i)) and no_eligible_prefix(facts, done, v(i)))
  }
}
proof scheduler_choice_is_exact(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): unit
  gives chosen_is_first(facts, done, Native.choose_ready(facts, done))
{
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((at: nat, _: unit) => no_eligible_prefix(facts, done, at)),
    ((_: unit) => no_eligible_prefix(facts, done, Seq.length(facts))),
    chosen_is_first(facts, done));
  assert(chosen_is_first(facts, done, Native.choose_ready(facts, done))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.has_event");
    Tactics.prune("Nickel_crdt.Edit.ready");
    Tactics.smt_sync'(1, 1)
  }
}

// The caller's None/Internal branch is excluded if any eligible fact exists.
// This is conditional scan progress, not existence of an eligible fact in a DAG.
proof available_event_is_chosen(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), available: usize where v(available) < Seq.length(facts)): unit
  takes eligible(facts, done, v(available))
  gives not (Native.choose_ready(facts, done) == Option.Option_None)
{
  scheduler_choice_is_exact(facts, done);
  assert(not (Native.choose_ready(facts, done) == Option.Option_None)) by {
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.smt_sync'(1, 1)
  }
}

import Nickel.EditCausal
import Nickel.EditAccepted
import Nickel.EditWellFormed
import FStar.Classical
import FStar.Fin

function ranked_prefix_done(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))) .
    rank(Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)).f_id) < finish ==>
      member(done, Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)).f_id)
}
// If nothing is eligible, induction on rank forces every stored event to be done.
proof! no_choice_finishes_lower_ranks(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat, finish: nat): unit
  decreases finish
  takes causal_rank(facts, rank, bound)
  takes no_eligible_prefix(Alloc.Vec.impl_1__as_slice(facts), done, Seq.length(Alloc.Vec.impl_1__as_slice(facts)))
  gives ranked_prefix_done(facts, done, rank, finish)
{
  if finish ==? 0 { () } else {
    no_choice_finishes_lower_ranks(facts, done, rank, bound, finish - 1);
    const input = Alloc.Vec.impl_1__as_slice(facts);
    proof each(i: usize where v(i) < Seq.length(input)): unit
      gives rank(Seq.index(input, v(i)).f_id) < finish ==> member(done, Seq.index(input, v(i)).f_id)
    {
      const fact = Seq.index(input, v(i));
      if rank(fact.f_id) < finish {
        assert(fact_present(input, fact));
        proof dependency(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after))): unit
          gives member(done, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)))
        {
          const id = Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j));
          assert(rank(id) < rank(fact.f_id));
          assert(fact_id_present(facts, id));
          const position = parent_fact_position(facts, id);
          assert(rank(Seq.index(input, position).f_id) < finish - 1);
          assert(member(done, Seq.index(input, v(mk_usize(position))).f_id)) by {
            Tactics.prune("Nickel.EditSchedule.no_eligible_prefix");
            Tactics.smt_sync'(1, 1)
          };
          assert(member(done, id))
        };
        FStar.Classical.forall_intro(dependency);
        assert(all_ids(Alloc.Vec.impl_1__as_slice(fact.f_after), member(done)));
        assert(not eligible(input, done, v(i)));
        assert(member(done, fact.f_id))
      } else { () }
    };
    FStar.Classical.forall_intro(each);
    assert(ranked_prefix_done(facts, done, rank, finish))
  }
}
proof ranked_unfinished_has_eligible(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat,
  unfinished: usize where v(unfinished) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))): unit
  takes causal_rank(facts, rank, bound)
  takes not member(done, Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(unfinished)).f_id)
  gives not no_eligible_prefix(Alloc.Vec.impl_1__as_slice(facts), done, Seq.length(Alloc.Vec.impl_1__as_slice(facts)))
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  proof impossible(dummy: unit): unit
    takes no_eligible_prefix(input, done, Seq.length(input))
    gives Prims.l_False
  {
    no_choice_finishes_lower_ranks(facts, done, rank, bound, bound);
    assert(fact_present(input, Seq.index(input, v(unfinished))));
    assert(rank(Seq.index(input, v(unfinished)).f_id) < bound);
    assert(member(done, Seq.index(input, v(unfinished)).f_id)) by {
      Tactics.prune("Nickel.EditSchedule.no_eligible_prefix");
      Tactics.smt_sync'(1, 1)
    };
    assert(Prims.l_False)
  };
  FStar.Classical.move_requires(impossible, ())
}

function all_stored_done(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): Type0 {
  forall(i: FStar.Fin.under(Seq.length(facts))) . member(done, Seq.index(facts, i).f_id)
}
function done_position(done: t_Slice(Native.t_EventId), id: Native.t_EventId where member(done, id)): i: FStar.Fin.under(Seq.length(done)) where Seq.index(done, i) == id {
  match FStar.Fin.find(done, ((item: Native.t_EventId) => item ==? id), 0) {
    Some(i) => i,
    None => 0
  }
}
// A shorter done vector cannot contain every distinct stored ID. No subset or
// uniqueness premise on done is needed for this direction of the count argument.
proof shorter_done_is_unfinished(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): unit
  takes Nickel.EditIdentity.unique_ids(facts)
  takes Seq.length(done) < Seq.length(facts)
  gives not all_stored_done(facts, done)
{
  proof impossible(dummy: unit): unit
    takes all_stored_done(facts, done)
    gives Prims.l_False
  {
    if Seq.length(done) ==? 0 {
      assert(member(done, Seq.index(facts, 0).f_id));
      assert(absent_prefix(done, Seq.index(facts, 0).f_id, 0));
      assert(Prims.l_False)
    } else {
      const position = ((i: nat where i < Seq.length(done) + 1) => done_position(done, Seq.index(facts, i).f_id));
      const positions = Seq.init(Seq.length(done) + 1, position);
      Seq.lemma_init_len(Seq.length(done) + 1, position);
      Seq.init_index(Seq.length(done) + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j and j < Seq.length(facts));
          assert(position(i) == position(j));
          assert(Seq.index(facts, i).f_id == Seq.index(facts, j).f_id);
          unique_slice_nat_positions(facts, i, j);
          assert(i == j)
        }
      }
    }
  };
  FStar.Classical.move_requires(impossible, ())
}
// The outer loop's count test supplies unfinishedness under stored-ID uniqueness.
proof ranked_incomplete_has_eligible(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(facts, rank, bound)
  takes ids_unique(facts)
  takes Seq.length(done) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
  gives not no_eligible_prefix(Alloc.Vec.impl_1__as_slice(facts), done, Seq.length(Alloc.Vec.impl_1__as_slice(facts)))
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  proof impossible(dummy: unit): unit
    takes no_eligible_prefix(input, done, Seq.length(input))
    gives Prims.l_False
  {
    no_choice_finishes_lower_ranks(facts, done, rank, bound, bound);
    proof each(i: FStar.Fin.under(Seq.length(input))): unit
      gives member(done, Seq.index(input, i).f_id)
    {
      assert(fact_present(input, Seq.index(input, i)));
      assert(rank(Seq.index(input, i).f_id) < bound);
      assert(member(done, Seq.index(input, v(mk_usize(i))).f_id)) by {
        Tactics.prune("Nickel.EditSchedule.no_eligible_prefix");
        Tactics.smt_sync'(1, 1)
      }
    };
    FStar.Classical.forall_intro(each);
    assert(all_stored_done(input, done));
    shorter_done_is_unfinished(input, done);
    assert(Prims.l_False)
  };
  FStar.Classical.move_requires(impossible, ())
}
// Connect independent eligible-event existence to the actual Rust scan.
proof ranked_incomplete_scan_progress(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(facts, rank, bound)
  takes ids_unique(facts)
  takes Seq.length(done) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
  gives not (Native.choose_ready(Alloc.Vec.impl_1__as_slice(facts), done) == Option.Option_None)
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  ranked_incomplete_has_eligible(facts, done, rank, bound);
  scheduler_choice_is_exact(input, done);
  assert(not (Native.choose_ready(input, done) == Option.Option_None)) by {
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.smt_sync'(1, 1)
  }
}
