import Shared = Nickel_crdt.Event_layer
import Graph = Nickel.EventGraph
import Nickel.EventGraphText
import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.Vector
import Nickel.LoopUtil
import Nickel.EditPast
import Native = Nickel_crdt.Edit
import Seq = FStar.Seq
import Option = Core_models.Option

// A dependency is ready exactly when every direct predecessor has run.
function ready_prefix(after: t_Slice(Native.t_EventId), done: t_Slice(Native.t_EventId), finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(after)) . v(i) < finish ==> member(done, Seq.index(after, v(i)))
}
proof readiness_is_exact(after: t_Slice(Native.t_EventId), done: t_Slice(Native.t_EventId)): unit
  gives Native.ready(after, done) == true <==> all_ids(after, member(done))
  hint Native.ready(after, done)
{
  // Check the actual text arguments before consuming generic correctness.
  assert(Shared.ready(after, done, Native.same_event_id) == Native.ready(after, done));
  Graph.readiness_is_exact(after, done, Native.same_event_id);
  assert(Native.ready(after, done) == true <==> all_ids(after, member(done))) by {
    Tactics.prune("Nickel_crdt.Edit.ready");
    Tactics.prune("Nickel_crdt.Event_layer.ready");
    Tactics.smt_sync'(1, 1)
  }
}

proof ready_is_text_call(after: t_Slice(Native.t_EventId), done: t_Slice(Native.t_EventId)): unit
  gives Shared.ready(after, done, Native.same_event_id) == Native.ready(after, done)
  hint Shared.ready(after, done, Native.same_event_id)
{ () }
function eligible(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), i: nat where i < Seq.length(facts)): Type0 {
  not member(done, Seq.index(facts, i).f_id) and
  all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, i).f_after), member(done))
}
function no_eligible_prefix(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(facts)) . v(i) < finish ==> not eligible(facts, done, v(i))
}
function chosen_is_first(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), result: Option.t_Option(usize)): Type0 {
  match result {
    Option.Option_None => no_eligible_prefix(facts, done, Seq.length(facts)),
    Option.Option_Some(i) => v(i) < Seq.length(facts) and
      (v(i) < Seq.length(facts) ==> eligible(facts, done, v(i)) and no_eligible_prefix(facts, done, v(i)))
  }
}
proof scheduler_choice_is_exact(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): unit
  gives chosen_is_first(facts, done, Native.choose_ready(facts, done))
{
  // Check the actual text arguments before consuming generic correctness.
  assert(Shared.choose_ready(facts, done, Native.fact_id, Native.fact_after, Native.same_event_id) == Native.choose_ready(facts, done));
  Graph.scheduler_choice_is_exact(facts, done, Native.fact_id, Native.fact_after, Native.same_event_id);
  assert(chosen_is_first(facts, done, Native.choose_ready(facts, done))) by {
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
    Tactics.smt_sync'(1, 1)
  }
}

proof choose_ready_is_text_call(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): unit
  gives Shared.choose_ready(facts, done, Native.fact_id, Native.fact_after, Native.same_event_id) == Native.choose_ready(facts, done)
  hint Shared.choose_ready(facts, done, Native.fact_id, Native.fact_after, Native.same_event_id)
{ () }

// The caller's None/Internal branch is excluded if any eligible fact exists.
// This is conditional scan progress, not existence of an eligible fact in a DAG.
proof available_event_is_chosen(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId), available: usize where v(available) < Seq.length(facts)): unit
  takes eligible(facts, done, v(available))
  gives not (Native.choose_ready(facts, done) == Option.Option_None)
{
  scheduler_choice_is_exact(facts, done);
  assert(not (Native.choose_ready(facts, done) == Option.Option_None)) by {
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
    Tactics.smt_sync'(1, 1)
  }
}

import Nickel.EditCausal
import Nickel.EditAccepted
import Nickel.EditWellFormed
import FStar.Classical
import FStar.Fin

function ranked_prefix_done(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))) .
    rank(Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)).f_id) < finish ==>
      member(done, Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)).f_id)
}
// If nothing is eligible, induction on rank forces every stored event to be done.
proof! no_choice_finishes_lower_ranks(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat, finish: nat): unit
  decreases finish
  takes causal_rank(facts, rank, bound)
  takes no_eligible_prefix(Alloc.Vec.impl_1__as_slice(facts), done, Seq.length(Alloc.Vec.impl_1__as_slice(facts)))
  gives ranked_prefix_done(facts, done, rank, finish)
{
  if finish ==? 0 { () } else {
    no_choice_finishes_lower_ranks(facts, done, rank, bound, finish - 1);
    const input = Alloc.Vec.impl_1__as_slice(facts);
    proof each(i: usize where v(i) < Seq.length(input)): unit
      gives rank(Seq.index(input, v(i)).f_id) < finish ==> member(done, Seq.index(input, v(i)).f_id)
    {
      const fact = Seq.index(input, v(i));
      if rank(fact.f_id) < finish {
        assert(fact_present(input, fact));
        proof dependency(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after))): unit
          gives member(done, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)))
        {
          const id = Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j));
          assert(rank(id) < rank(fact.f_id));
          assert(fact_id_present(facts, id));
          const position = parent_fact_position(facts, id);
          assert(rank(Seq.index(input, position).f_id) < finish - 1);
          assert(member(done, Seq.index(input, v(mk_usize(position))).f_id)) by {
            Tactics.prune("Nickel.EditSchedule.no_eligible_prefix");
            Tactics.smt_sync'(1, 1)
          };
          assert(member(done, id))
        };
        FStar.Classical.forall_intro(dependency);
        assert(all_ids(Alloc.Vec.impl_1__as_slice(fact.f_after), member(done)));
        assert(not eligible(input, done, v(i)));
        assert(member(done, fact.f_id))
      } else { () }
    };
    FStar.Classical.forall_intro(each);
    assert(ranked_prefix_done(facts, done, rank, finish))
  }
}
proof ranked_unfinished_has_eligible(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat,
  unfinished: usize where v(unfinished) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))): unit
  takes causal_rank(facts, rank, bound)
  takes not member(done, Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(unfinished)).f_id)
  gives not no_eligible_prefix(Alloc.Vec.impl_1__as_slice(facts), done, Seq.length(Alloc.Vec.impl_1__as_slice(facts)))
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  proof impossible(dummy: unit): unit
    takes no_eligible_prefix(input, done, Seq.length(input))
    gives Prims.l_False
  {
    no_choice_finishes_lower_ranks(facts, done, rank, bound, bound);
    assert(fact_present(input, Seq.index(input, v(unfinished))));
    assert(rank(Seq.index(input, v(unfinished)).f_id) < bound);
    assert(member(done, Seq.index(input, v(unfinished)).f_id)) by {
      Tactics.prune("Nickel.EditSchedule.no_eligible_prefix");
      Tactics.smt_sync'(1, 1)
    };
    assert(Prims.l_False)
  };
  FStar.Classical.move_requires(impossible, ())
}

function all_stored_done(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): Type0 {
  forall(i: FStar.Fin.under(Seq.length(facts))) . member(done, Seq.index(facts, i).f_id)
}
function done_position(done: t_Slice(Native.t_EventId), id: Native.t_EventId where member(done, id)): i: FStar.Fin.under(Seq.length(done)) where Seq.index(done, i) == id {
  match FStar.Fin.find(done, ((item: Native.t_EventId) => item ==? id), 0) {
    Some(i) => i,
    None => 0
  }
}
// A shorter done vector cannot contain every distinct stored ID. No subset or
// uniqueness premise on done is needed for this direction of the count argument.
proof shorter_done_is_unfinished(facts: t_Slice(Native.t_Fact), done: t_Slice(Native.t_EventId)): unit
  takes Nickel.EditIdentity.unique_ids(facts)
  takes Seq.length(done) < Seq.length(facts)
  gives not all_stored_done(facts, done)
{
  proof impossible(dummy: unit): unit
    takes all_stored_done(facts, done)
    gives Prims.l_False
  {
    if Seq.length(done) ==? 0 {
      assert(member(done, Seq.index(facts, 0).f_id));
      assert(absent_prefix(done, Seq.index(facts, 0).f_id, 0));
      assert(Prims.l_False)
    } else {
      const position = ((i: nat where i < Seq.length(done) + 1) => done_position(done, Seq.index(facts, i).f_id));
      const positions = Seq.init(Seq.length(done) + 1, position);
      Seq.lemma_init_len(Seq.length(done) + 1, position);
      Seq.init_index(Seq.length(done) + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j and j < Seq.length(facts));
          assert(position(i) == position(j));
          assert(Seq.index(facts, i).f_id == Seq.index(facts, j).f_id);
          unique_slice_nat_positions(facts, i, j);
          assert(i == j)
        }
      }
    }
  };
  FStar.Classical.move_requires(impossible, ())
}
// The outer loop's count test supplies unfinishedness under stored-ID uniqueness.
proof ranked_incomplete_has_eligible(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(facts, rank, bound)
  takes ids_unique(facts)
  takes Seq.length(done) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
  gives not no_eligible_prefix(Alloc.Vec.impl_1__as_slice(facts), done, Seq.length(Alloc.Vec.impl_1__as_slice(facts)))
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  proof impossible(dummy: unit): unit
    takes no_eligible_prefix(input, done, Seq.length(input))
    gives Prims.l_False
  {
    no_choice_finishes_lower_ranks(facts, done, rank, bound, bound);
    proof each(i: FStar.Fin.under(Seq.length(input))): unit
      gives member(done, Seq.index(input, i).f_id)
    {
      assert(fact_present(input, Seq.index(input, i)));
      assert(rank(Seq.index(input, i).f_id) < bound);
      assert(member(done, Seq.index(input, v(mk_usize(i))).f_id)) by {
        Tactics.prune("Nickel.EditSchedule.no_eligible_prefix");
        Tactics.smt_sync'(1, 1)
      }
    };
    FStar.Classical.forall_intro(each);
    assert(all_stored_done(input, done));
    shorter_done_is_unfinished(input, done);
    assert(Prims.l_False)
  };
  FStar.Classical.move_requires(impossible, ())
}
// Connect independent eligible-event existence to the actual Rust scan.
proof ranked_incomplete_scan_progress(facts: facts_vec, done: t_Slice(Native.t_EventId), rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(facts, rank, bound)
  takes ids_unique(facts)
  takes Seq.length(done) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
  gives not (Native.choose_ready(Alloc.Vec.impl_1__as_slice(facts), done) == Option.Option_None)
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  ranked_incomplete_has_eligible(facts, done, rank, bound);
  scheduler_choice_is_exact(input, done);
  assert(not (Native.choose_ready(input, done) == Option.Option_None)) by {
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
    Tactics.smt_sync'(1, 1)
  }
}

import Nickel.EditPastTotal
// The event at each trace position comes from storage; every direct predecessor
// occurs at a strictly earlier position. This records order, not just closure.
function causal_position(facts: t_Slice(Native.t_Fact), ids: t_Slice(Native.t_EventId), at: FStar.Fin.under(Seq.length(ids))): Type0 {
    exists(index: FStar.Fin.under(Seq.length(facts))) .
      Seq.index(facts, index).f_id == Seq.index(ids, at) and
      all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, index).f_after),
        ((id: Native.t_EventId) => not absent_prefix(ids, id, at)))
}
function causal_trace(facts: t_Slice(Native.t_Fact), ids: t_Slice(Native.t_EventId)): Type0 {
  forall(at: FStar.Fin.under(Seq.length(ids))) . causal_position(facts, ids, at)
}
proof append_retains_earlier(before: t_Slice(Native.t_EventId), id: Native.t_EventId, wanted: Native.t_EventId, finish: nat where finish <= Seq.length(before)): unit
  takes Seq.length(before) < max_usize
  takes not absent_prefix(before, wanted, finish)
  gives not absent_prefix(Seq.append(before, Seq.create(1, id)), wanted, finish)
{
  const next = Seq.append(before, Seq.create(1, id));
  proof impossible(dummy: unit): unit
    takes absent_prefix(next, wanted, finish)
    gives Prims.l_False
  {
    proof each(i: usize where v(i) < Seq.length(before)): unit
      gives v(i) < finish ==> not (Seq.index(before, v(i)) == wanted)
    {
      assert(v(i) < Seq.length(next));
      assert(Seq.index(next, v(i)) == Seq.index(before, v(i)));
      ()
    };
    FStar.Classical.forall_intro(each);
    assert(absent_prefix(before, wanted, finish));
    ()
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(impossible));
  ()
}
proof eligible_append_keeps_causal_trace(facts: t_Slice(Native.t_Fact), before: t_Slice(Native.t_EventId), index: nat where index < Seq.length(facts)): unit
  takes Seq.length(before) < max_usize
  takes causal_trace(facts, before)
  takes eligible(facts, before, index)
  gives causal_trace(facts, Seq.append(before, Seq.create(1, Seq.index(facts, index).f_id)))
{
  const fact = Seq.index(facts, index);
  const next = Seq.append(before, Seq.create(1, fact.f_id));
  proof position(at: FStar.Fin.under(Seq.length(next))): unit
    gives causal_position(facts, next, at)
  {
    if at < Seq.length(before) {
      assert(causal_position(facts, before, at));
      proof transfer(k: FStar.Fin.under(Seq.length(facts))): unit
        takes Seq.index(facts, k).f_id == Seq.index(before, at)
        takes all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, k).f_after),
          ((id: Native.t_EventId) => not absent_prefix(before, id, at)))
        gives Seq.index(facts, k).f_id == Seq.index(next, at) and
          all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, k).f_after),
            ((id: Native.t_EventId) => not absent_prefix(next, id, at)))
      {
        proof dependency(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(Seq.index(facts, k).f_after))): unit
          gives not absent_prefix(next, Seq.index(Alloc.Vec.impl_1__as_slice(Seq.index(facts, k).f_after), v(j)), at)
        {
          append_retains_earlier(before, fact.f_id, Seq.index(Alloc.Vec.impl_1__as_slice(Seq.index(facts, k).f_after), v(j)), at)
        };
        FStar.Classical.forall_intro(dependency);
        ()
      };
      FStar.Classical.forall_intro(FStar.Classical.move_requires(transfer));
      ()
    } else {
      assert(at == Seq.length(before));
      proof dependency(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after))): unit
        gives not absent_prefix(next, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)), at)
      {
        append_retains_earlier(before, fact.f_id, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)), at)
      };
      FStar.Classical.forall_intro(dependency);
      assert(Seq.index(facts, index).f_id == Seq.index(next, at));
      assert(all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, index).f_after),
        ((id: Native.t_EventId) => not absent_prefix(next, id, at))));
      ()
    }
  };
  FStar.Classical.forall_intro(position);
  ()
}

import Result = Core_models.Result
unfold type operations_vec = Alloc.Vec.t_Vec((Native.t_EventId, Alloc.Vec.t_Vec(Native.t_Node, Alloc.Alloc.t_Global)), Alloc.Alloc.t_Global)
unfold type schedule_state = (ids_vec, operations_vec, Native.t_Tree)
function schedule_done(state: schedule_state): (Native.t_Tree, ids_vec) {
  match state { (done, _, tree) => (tree, done) }
}
function schedule_invariant(facts: t_Slice(Native.t_Fact), at: nat, state: schedule_state): Type0 {
  match state { (done, _, _) => Seq.length(Alloc.Vec.impl_1__as_slice(done)) == at and unique_selection(Alloc.Vec.impl_1__as_slice(done)) and causal_trace(facts, Alloc.Vec.impl_1__as_slice(done)) }
}
function complete_causal_trace(facts: t_Slice(Native.t_Fact), pair: (Native.t_Tree, ids_vec)): Type0 {
  match pair { (_, done) => Seq.length(Alloc.Vec.impl_1__as_slice(done)) == Seq.length(facts) and unique_selection(Alloc.Vec.impl_1__as_slice(done)) and causal_trace(facts, Alloc.Vec.impl_1__as_slice(done)) }
}
// This contract describes exactly the append used by the outer loop.
function choice_keeps_trace(facts: t_Slice(Native.t_Fact), before: t_Slice(Native.t_EventId) where Seq.length(before) < max_usize): Type0 {
match Native.choose_ready(facts, before) {
    Option.Option_None => Prims.l_True,
    Option.Option_Some(index) => v(index) < Seq.length(facts) and
      (v(index) < Seq.length(facts) ==> unique_selection(Seq.append(before, Seq.create(1, Seq.index(facts, v(index)).f_id))) and
        causal_trace(facts, Seq.append(before, Seq.create(1, Seq.index(facts, v(index)).f_id))))
  }
}
proof chosen_append_keeps_trace(facts: t_Slice(Native.t_Fact), before: t_Slice(Native.t_EventId)): unit
  takes Seq.length(before) < max_usize
  takes unique_selection(before) and causal_trace(facts, before)
  gives choice_keeps_trace(facts, before)
  hint Native.choose_ready(facts, before)
{
  scheduler_choice_is_exact(facts, before);
  match Native.choose_ready(facts, before) {
    Option.Option_None => (),
    Option.Option_Some(index) => if v(index) < Seq.length(facts) {
      eligible_append_keeps_causal_trace(facts, before, v(index));
      fresh_append_is_unique(before, Seq.index(facts, v(index)).f_id)
    } else { () }
  }
}
proof empty_trace_is_valid(facts: t_Slice(Native.t_Fact)): unit
  gives unique_selection(Seq.empty) and causal_trace(facts, Seq.empty)
{ () }
proof successful_schedule_is_once_only_and_causal(facts: t_Slice(Native.t_Fact)): unit
  gives Nickel.LoopUtil.result_safe(complete_causal_trace(facts), ((_: Native.t_Error) => Prims.l_True), Native.interpret_scheduled(facts))
{
  proof event_shape(event: Native.t_Fact, operations: t_Slice((Native.t_EventId, Alloc.Vec.t_Vec(Native.t_Node, Alloc.Alloc.t_Global))), tree: Native.t_Tree): unit
    gives result_shape(Native.interpret_event(facts, event, operations, tree))
    hint Native.interpret_event(facts, event, operations, tree)
  { () };
  proof choice_shape(done: t_Slice(Native.t_EventId)): unit
    gives Native.choose_ready(facts, done) == Option.Option_None or (exists(i: usize) . Native.choose_ready(facts, done) == Option.Option_Some(i))
    hint Native.choose_ready(facts, done)
  { () };
  empty_trace_is_valid(facts);
  Nickel.Vector.empty_vector_contents<#Native.t_EventId>();
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    schedule_invariant(facts), schedule_done, complete_causal_trace(facts), ((_: Native.t_Error) => Prims.l_True));
  assert(Nickel.LoopUtil.result_safe(complete_causal_trace(facts), ((_: Native.t_Error) => Prims.l_True), Native.interpret_scheduled(facts))) by {
    Tactics.prune("Nickel.EditSchedule.causal_trace");
    Tactics.prune("Nickel_crdt.Edit.interpret_event");
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

proof causal_trace_uses_stored_ids(facts: facts_vec, done: ids_vec): unit
  takes causal_trace(Alloc.Vec.impl_1__as_slice(facts), Alloc.Vec.impl_1__as_slice(done))
  gives all_ids(Alloc.Vec.impl_1__as_slice(done), fact_id_present(facts))
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  const ids = Alloc.Vec.impl_1__as_slice(done);
  proof each(at: usize where v(at) < Seq.length(ids)): unit
    gives fact_id_present(facts, Seq.index(ids, v(at)))
  {
    assert(causal_position(input, ids, v(at)));
    assert(exists(index: FStar.Fin.under(Seq.length(input))) . Seq.index(input, index).f_id == Seq.index(ids, v(at)) and
      all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(input, index).f_after),
        ((id: Native.t_EventId) => not absent_prefix(ids, id, v(at)))));
    assert(exists(index: FStar.Fin.under(Seq.length(input))) . Seq.index(input, index).f_id == Seq.index(ids, v(at)));
    proof stored(index: FStar.Fin.under(Seq.length(input))): unit
      takes Seq.index(input, index).f_id == Seq.index(ids, v(at))
      gives fact_id_present(facts, Seq.index(ids, v(at)))
    {
      assert(fact_present(input, Seq.index(input, index)));
      ()
    };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(stored));
    ()
  };
  FStar.Classical.forall_intro(each);
  ()
}
proof full_trace_covers_storage(facts: t_Slice(Native.t_Fact), done: ids_vec): unit
  takes Seq.length(Alloc.Vec.impl_1__as_slice(done)) == Seq.length(facts)
  takes unique_selection(Alloc.Vec.impl_1__as_slice(done))
  takes causal_trace(facts, Alloc.Vec.impl_1__as_slice(done))
  gives forall(i: FStar.Fin.under(Seq.length(facts))) . member(Alloc.Vec.impl_1__as_slice(done), Seq.index(facts, i).f_id)
{
  const stored = Alloc.Vec.from_seq<#Native.t_Fact, #Alloc.Alloc.t_Global>(facts);
  Nickel.Vector.vector_from_seq<#Native.t_Fact>(facts);
  causal_trace_uses_stored_ids(stored, done);
  proof each(i: FStar.Fin.under(Seq.length(facts))): unit
    gives member(Alloc.Vec.impl_1__as_slice(done), Seq.index(facts, i).f_id)
  {
    const id = Seq.index(facts, i).f_id;
    assert(fact_present(facts, Seq.index(facts, i)));
    assert(fact_id_present(stored, id));
    if Native.has_event(Alloc.Vec.impl_1__as_slice(done), id) { () } else {
      missing_stored_id_leaves_room(stored, done, id);
      assert(Prims.l_False) by {
        Tactics.prune("Nickel.EditSchedule.causal_trace");
        Tactics.prune("Nickel.EditPastTotal.unique_selection");
        Tactics.smt_sync'(1, 1)
      }
    }
  };
  FStar.Classical.forall_intro(each);
  ()
}
function erase_schedule(out: Result.t_Result((Native.t_Tree, ids_vec), Native.t_Error)): Result.t_Result(Native.t_Tree, Native.t_Error) {
  match out { Result.Result_Err(error) => Result.Result_Err(error), Result.Result_Ok((tree, _)) => Result.Result_Ok(tree) }
}
proof interpret_erases_only_schedule(facts: t_Slice(Native.t_Fact)): unit
  gives Native.interpret(facts) == erase_schedule(Native.interpret_scheduled(facts))
{
  proof shape(): unit
    gives result_shape(Native.interpret_scheduled(facts))
  { () };
  shape();
  assert(Native.interpret(facts) == erase_schedule(Native.interpret_scheduled(facts))) by {
    Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
    Tactics.prune("Nickel_crdt.Event_shell.scheduled");
    Tactics.smt_sync'(1, 1)
  }
}
// Successful interpretation through the wrapper has this actual trace, without
// assuming tree-building helpers succeed. This does not assert total interpret.
function interpretation_schedule(facts: t_Slice(Native.t_Fact), tree: Native.t_Tree): Type0 {
  exists(done: ids_vec) . Native.interpret_scheduled(facts) == Result.Result_Ok((tree, done)) and
    complete_causal_trace(facts, (tree, done)) and
    (forall(i: FStar.Fin.under(Seq.length(facts))) . member(Alloc.Vec.impl_1__as_slice(done), Seq.index(facts, i).f_id))
}
proof successful_interpretation_has_causal_schedule(facts: t_Slice(Native.t_Fact), tree: Native.t_Tree): unit
  takes Native.interpret(facts) == Result.Result_Ok(tree)
  gives interpretation_schedule(facts, tree)
{
  successful_schedule_is_once_only_and_causal(facts);
  interpret_erases_only_schedule(facts);
  proof each(done: ids_vec): unit
    takes Native.interpret_scheduled(facts) == Result.Result_Ok((tree, done))
    takes complete_causal_trace(facts, (tree, done))
    gives interpretation_schedule(facts, tree)
  {
    full_trace_covers_storage(facts, done);
    assert(interpretation_schedule(facts, tree)) by {
      Tactics.prune("Nickel_crdt.Edit.interpret");
      Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
      Tactics.prune("Nickel_crdt.Event_shell.scheduled");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each));
  proof shape(): unit
    gives result_shape(Native.interpret_scheduled(facts))
  { () };
  shape();
  assert(interpretation_schedule(facts, tree)) by {
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
    Tactics.prune("Nickel_crdt.Event_shell.scheduled");
    Tactics.smt_sync'(1, 1)
  }
}

// Restricting an actual execution to its exact past keeps predecessor order.
// This is a relative-order statement, not equality of two rebuilt trees.
function strictly_before(ids: t_Slice(Native.t_EventId), first: Native.t_EventId, second: Native.t_EventId): Type0 {
  exists(i: usize where v(i) < Seq.length(ids), j: usize where v(j) < Seq.length(ids)) .
    v(i) < v(j) and Seq.index(ids, v(i)) == first and Seq.index(ids, v(j)) == second
}
proof trace_orders_stored_dependencies(facts: t_Slice(Native.t_Fact), ids: t_Slice(Native.t_EventId),
  index: FStar.Fin.under(Seq.length(facts)), at: FStar.Fin.under(Seq.length(ids))): unit
  takes Nickel.EditIdentity.unique_ids(facts)
  takes causal_trace(facts, ids)
  takes Seq.index(facts, index).f_id == Seq.index(ids, at)
  gives all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, index).f_after),
    ((id: Native.t_EventId) => not absent_prefix(ids, id, at)))
{
  assert(causal_position(facts, ids, at));
  proof each(k: FStar.Fin.under(Seq.length(facts))): unit
    takes Seq.index(facts, k).f_id == Seq.index(ids, at)
    takes all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, k).f_after),
      ((id: Native.t_EventId) => not absent_prefix(ids, id, at)))
    gives all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(facts, index).f_after),
      ((id: Native.t_EventId) => not absent_prefix(ids, id, at)))
  {
    unique_slice_nat_positions(facts, index, k);
    assert(index == k);
    ()
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each));
  ()
}
proof earlier_member_has_strict_order(ids: t_Slice(Native.t_EventId), id: Native.t_EventId, at: FStar.Fin.under(Seq.length(ids))): unit
  takes not absent_prefix(ids, id, at)
  gives strictly_before(ids, id, Seq.index(ids, at))
{
  assert(v(mk_usize(at)) == at);
  proof each(i: usize where v(i) < Seq.length(ids)): unit
    gives (v(i) < at and Seq.index(ids, v(i)) == id) ==> strictly_before(ids, id, Seq.index(ids, at))
  { () };
  FStar.Classical.forall_intro(each);
  ()
}
proof exact_cut_keeps_dependencies(facts: facts_vec, roots: t_Slice(Native.t_EventId), selected: ids_vec,
  index: FStar.Fin.under(Seq.length(Alloc.Vec.impl_1__as_slice(facts)))): unit
  takes exact_past_result(facts, roots, Result.Result_Ok(selected))
  takes member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(facts), index).f_id)
  gives all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(Alloc.Vec.impl_1__as_slice(facts), index).f_after), member(Alloc.Vec.impl_1__as_slice(selected)))
{
  const fact = Seq.index(Alloc.Vec.impl_1__as_slice(facts), index);
  assert(ancestor(facts, roots, fact.f_id));
  proof each(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after))): unit
    gives member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)))
  {
    const id = Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j));
    assert(fact_present(Alloc.Vec.impl_1__as_slice(facts), fact));
    assert(Nickel.EditCausal.causal_edge(facts, fact.f_id, id));
    ancestor_follows_edge(facts, roots, fact.f_id, id);
    assert(member(Alloc.Vec.impl_1__as_slice(selected), id)) by {
      Tactics.prune("Nickel.EditPast.ancestor");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro(each);
  ()
}
function cut_order(facts: facts_vec, selected: ids_vec, done: ids_vec): Type0 {
  all_ids(Alloc.Vec.impl_1__as_slice(selected), member(Alloc.Vec.impl_1__as_slice(done))) and
  (forall(index: FStar.Fin.under(Seq.length(Alloc.Vec.impl_1__as_slice(facts)))) .
    member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(facts), index).f_id) ==>
      all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(Alloc.Vec.impl_1__as_slice(facts), index).f_after),
        ((id: Native.t_EventId) => member(Alloc.Vec.impl_1__as_slice(selected), id) and
          strictly_before(Alloc.Vec.impl_1__as_slice(done), id, Seq.index(Alloc.Vec.impl_1__as_slice(facts), index).f_id))))
}
proof full_execution_orders_exact_cut(facts: facts_vec, roots: t_Slice(Native.t_EventId), selected: ids_vec, done: ids_vec): unit
  takes ids_unique(facts)
  takes stored_selection(facts, selected)
  takes exact_past_result(facts, roots, Result.Result_Ok(selected))
  takes Seq.length(Alloc.Vec.impl_1__as_slice(done)) == Seq.length(Alloc.Vec.impl_1__as_slice(facts))
  takes unique_selection(Alloc.Vec.impl_1__as_slice(done))
  takes causal_trace(Alloc.Vec.impl_1__as_slice(facts), Alloc.Vec.impl_1__as_slice(done))
  gives cut_order(facts, selected, done)
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  const ids = Alloc.Vec.impl_1__as_slice(done);
  full_trace_covers_storage(input, done);
  proof selected_member(i: usize where v(i) < Seq.length(Alloc.Vec.impl_1__as_slice(selected))): unit
    gives member(ids, Seq.index(Alloc.Vec.impl_1__as_slice(selected), v(i)))
  {
    const id = Seq.index(Alloc.Vec.impl_1__as_slice(selected), v(i));
    const index = parent_fact_position(facts, id);
    assert(member(ids, Seq.index(input, index).f_id));
    ()
  };
  FStar.Classical.forall_intro(selected_member);
  proof selected_fact(index: FStar.Fin.under(Seq.length(input))): unit
    takes member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(input, index).f_id)
    gives all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(input, index).f_after),
      ((id: Native.t_EventId) => member(Alloc.Vec.impl_1__as_slice(selected), id) and strictly_before(ids, id, Seq.index(input, index).f_id)))
  {
    const at = done_position(ids, Seq.index(input, index).f_id);
    trace_orders_stored_dependencies(input, ids, index, at);
    exact_cut_keeps_dependencies(facts, roots, selected, index);
    proof dependency(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(Seq.index(input, index).f_after))): unit
      gives member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(Seq.index(input, index).f_after), v(j))) and
        strictly_before(ids, Seq.index(Alloc.Vec.impl_1__as_slice(Seq.index(input, index).f_after), v(j)), Seq.index(input, index).f_id)
    {
      earlier_member_has_strict_order(ids, Seq.index(Alloc.Vec.impl_1__as_slice(Seq.index(input, index).f_after), v(j)), at)
    };
    FStar.Classical.forall_intro(dependency);
    ()
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(selected_fact));
  ()
}
function interpreted_cut(facts: facts_vec, roots: t_Slice(Native.t_EventId), tree: Native.t_Tree): Type0 {
  exists(selected: ids_vec, done: ids_vec) .
    Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) == Result.Result_Ok(selected) and
    Native.interpret_scheduled(Alloc.Vec.impl_1__as_slice(facts)) == Result.Result_Ok((tree, done)) and
    stored_selection(facts, selected) and
    complete_causal_trace(Alloc.Vec.impl_1__as_slice(facts), (tree, done)) and
    cut_order(facts, selected, done)
}
proof successful_execution_orders_its_exact_past_cut(facts: facts_vec, roots: t_Slice(Native.t_EventId), tree: Native.t_Tree): unit
  takes Nickel.EditWellFormed.facts_causally_closed(facts)
  takes Nickel.EditWellFormed.dependencies_present(Alloc.Vec.impl_1__as_slice(facts), roots)
  takes Native.duplicate_events(roots) == false
  takes ids_unique(facts)
  takes Native.interpret(Alloc.Vec.impl_1__as_slice(facts)) == Result.Result_Ok(tree)
  gives interpreted_cut(facts, roots, tree)
{
  proof shape(): unit
    gives result_shape(Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
  { () };
  shape();
  assert(history_references_present(facts));
  assert(all_ids(roots, fact_id_present(facts)));
  scanned_roots_compute_exact_past(facts, roots);
  successful_interpretation_has_causal_schedule(Alloc.Vec.impl_1__as_slice(facts), tree);
  proof combine(selected: ids_vec, done: ids_vec): unit
    takes Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) == Result.Result_Ok(selected)
    takes stored_selection(facts, selected)
    takes exact_past_result(facts, roots, Result.Result_Ok(selected))
    takes Native.interpret_scheduled(Alloc.Vec.impl_1__as_slice(facts)) == Result.Result_Ok((tree, done))
    takes complete_causal_trace(Alloc.Vec.impl_1__as_slice(facts), (tree, done))
    gives interpreted_cut(facts, roots, tree)
  {
    full_execution_orders_exact_cut(facts, roots, selected, done);
    assert(interpreted_cut(facts, roots, tree)) by {
      Tactics.prune("Nickel.EditSchedule.cut_order");
      Tactics.prune("Nickel_crdt.Edit.duplicate_events");
      Tactics.prune("Nickel_crdt.Event_layer.duplicate_ids");
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
      Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
      Tactics.prune("Nickel_crdt.Event_shell.scheduled");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(combine));
  assert(interpreted_cut(facts, roots, tree)) by {
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
    Tactics.prune("Nickel_crdt.Event_shell.scheduled");
    Tactics.smt_sync'(1, 1)
  }
}

unfold type operation_pair = (Native.t_EventId, Alloc.Vec.t_Vec(Native.t_Node, Alloc.Alloc.t_Global))
unfold type node_vec = Alloc.Vec.t_Vec(Native.t_Node, Alloc.Alloc.t_Global)
unfold type event_work_step = (ids_vec, operations_vec, Native.t_Tree, node_vec, usize)
function prefix_step_valid(facts: t_Slice(Native.t_Fact), done: ids_vec, operations: operations_vec,
  tree: Native.t_Tree, step: event_work_step): Type0 {
  match step { (previous_done, previous_operations, previous_tree, new_operations, index) =>
    if v(index) < Seq.length(facts) {
      Native.choose_ready(facts, Alloc.Vec.impl_1__as_slice(previous_done)) == Option.Option_Some(index) and
      Native.interpret_event(facts, Seq.index(facts, v(index)), Alloc.Vec.impl_1__as_slice(previous_operations), previous_tree) == Result.Result_Ok((tree, new_operations)) and
      Alloc.Vec.impl_1__as_slice(done) == Seq.append(Alloc.Vec.impl_1__as_slice(previous_done), Seq.create(1, Seq.index(facts, v(index)).f_id)) and
      Alloc.Vec.impl_1__as_slice(operations) == Seq.append(Alloc.Vec.impl_1__as_slice(previous_operations), Seq.create(1, (Seq.index(facts, v(index)).f_id, new_operations)))
    } else { Prims.l_False }
  }
}
// A predecessor contains the actual helper input state, output operations and
// chosen index. Packing it gives the constructor proof one explicit witness.
function! event_work_prefix(facts: t_Slice(Native.t_Fact), count: nat,
  done: ids_vec, operations: operations_vec, tree: Native.t_Tree): Type0
  decreases count
{
  if count ==? 0 {
    Alloc.Vec.impl_1__as_slice(done) == Seq.empty and
    Alloc.Vec.impl_1__as_slice(operations) == Seq.empty and
    tree == Core_models.Default.f_default<#Native.t_Tree, #Native.impl_5>(())
  } else {
    exists(step: event_work_step) .
      (match step { (previous_done, previous_operations, previous_tree, _, _) =>
        event_work_prefix(facts, count - 1, previous_done, previous_operations, previous_tree) }) and
      prefix_step_valid(facts, done, operations, tree, step)
  }
}
function prefix_can_extend_at(facts: t_Slice(Native.t_Fact), count: nat,
  done: ids_vec, operations: operations_vec, tree: Native.t_Tree,
  index: usize where v(index) < Seq.length(facts)): Type0 {
  forall(next_tree: Native.t_Tree, new_operations: node_vec, next_done: ids_vec, next_operations: operations_vec) .
    (Native.choose_ready(facts, Alloc.Vec.impl_1__as_slice(done)) == Option.Option_Some(index) and
     Native.interpret_event(facts, Seq.index(facts, v(index)), Alloc.Vec.impl_1__as_slice(operations), tree) == Result.Result_Ok((next_tree, new_operations)) and
     Alloc.Vec.impl_1__as_slice(next_done) == Seq.append(Alloc.Vec.impl_1__as_slice(done), Seq.create(1, Seq.index(facts, v(index)).f_id)) and
     Alloc.Vec.impl_1__as_slice(next_operations) == Seq.append(Alloc.Vec.impl_1__as_slice(operations), Seq.create(1, (Seq.index(facts, v(index)).f_id, new_operations)))) ==>
    event_work_prefix(facts, count + 1, next_done, next_operations, next_tree)
}
proof prefix_extension_is_actual_work(facts: t_Slice(Native.t_Fact), count: nat,
  done: ids_vec, operations: operations_vec, tree: Native.t_Tree,
  index: usize where v(index) < Seq.length(facts)): unit
  takes event_work_prefix(facts, count, done, operations, tree)
  gives prefix_can_extend_at(facts, count, done, operations, tree, index)
{
  proof next(next_tree: Native.t_Tree, new_operations: node_vec, next_done: ids_vec, next_operations: operations_vec): unit
    takes Native.choose_ready(facts, Alloc.Vec.impl_1__as_slice(done)) == Option.Option_Some(index)
    takes Native.interpret_event(facts, Seq.index(facts, v(index)), Alloc.Vec.impl_1__as_slice(operations), tree) == Result.Result_Ok((next_tree, new_operations))
    takes Alloc.Vec.impl_1__as_slice(next_done) == Seq.append(Alloc.Vec.impl_1__as_slice(done), Seq.create(1, Seq.index(facts, v(index)).f_id))
    takes Alloc.Vec.impl_1__as_slice(next_operations) == Seq.append(Alloc.Vec.impl_1__as_slice(operations), Seq.create(1, (Seq.index(facts, v(index)).f_id, new_operations)))
    gives event_work_prefix(facts, count + 1, next_done, next_operations, next_tree)
  {
    const witness = ((done, operations, tree, new_operations, index) : event_work_step);
    assert(prefix_step_valid(facts, next_done, next_operations, next_tree, witness));
    FStar.Classical.exists_intro(
      ((step: event_work_step) =>
        (match step { (previous_done, previous_operations, previous_tree, _, _) =>
          event_work_prefix(facts, count, previous_done, previous_operations, previous_tree) }) and
        prefix_step_valid(facts, next_done, next_operations, next_tree, step)), witness);
    assert(event_work_prefix(facts, count + 1, next_done, next_operations, next_tree)) by {
      Tactics.prune("Nickel_crdt.Edit.interpret_event");
      Tactics.prune("Nickel_crdt.Edit.choose_ready");
      Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_4(FStar.Classical.move_requires_4(next))
}
proof prefix_starts_at_actual_empty(facts: t_Slice(Native.t_Fact)): unit
  gives event_work_prefix(facts, 0, Alloc.Vec.impl__new<#Native.t_EventId>(()),
    Alloc.Vec.impl__new<#operation_pair>(()),
    Core_models.Default.f_default<#Native.t_Tree, #Native.impl_5>(()))
{ () }
// Any outer error on ranked distinct facts is explained by event/tree work,
// rather than scheduler choice, the index guard or the two bookkeeping pushes.
function tree_work_failed(facts: facts_vec, error: Native.t_Error): Type0 {
  exists(done: ids_vec, operations: operations_vec, tree: Native.t_Tree,
    index: FStar.Fin.under(Seq.length(Alloc.Vec.impl_1__as_slice(facts)))) .
    Seq.length(Alloc.Vec.impl_1__as_slice(done)) < Seq.length(Alloc.Vec.impl_1__as_slice(facts)) and
    Seq.length(Alloc.Vec.impl_1__as_slice(operations)) == Seq.length(Alloc.Vec.impl_1__as_slice(done)) and
    unique_selection(Alloc.Vec.impl_1__as_slice(done)) and
    causal_trace(Alloc.Vec.impl_1__as_slice(facts), Alloc.Vec.impl_1__as_slice(done)) and
    eligible(Alloc.Vec.impl_1__as_slice(facts), Alloc.Vec.impl_1__as_slice(done), index) and
    event_work_prefix(Alloc.Vec.impl_1__as_slice(facts), Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree) and
    Native.choose_ready(Alloc.Vec.impl_1__as_slice(facts), Alloc.Vec.impl_1__as_slice(done)) == Option.Option_Some(mk_usize(index)) and
    Native.interpret_event(Alloc.Vec.impl_1__as_slice(facts), Seq.index(Alloc.Vec.impl_1__as_slice(facts), index),
      Alloc.Vec.impl_1__as_slice(operations), tree) == Result.Result_Err(error)
}
function schedule_progress_invariant(facts: t_Slice(Native.t_Fact), at: nat, state: schedule_state): Type0 {
  schedule_invariant(facts, at, state) and
    (match state { (done, operations, tree) => Seq.length(Alloc.Vec.impl_1__as_slice(operations)) == at and event_work_prefix(facts, at, done, operations, tree) })
}
proof ranked_outer_errors_come_from_tree_work(facts: facts_vec, rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(facts, rank, bound)
  takes ids_unique(facts)
  gives Nickel.LoopUtil.result_safe(complete_causal_trace(Alloc.Vec.impl_1__as_slice(facts)),
    tree_work_failed(facts), Native.interpret_scheduled(Alloc.Vec.impl_1__as_slice(facts)))
{
  const input = Alloc.Vec.impl_1__as_slice(facts);
  proof progress(done: t_Slice(Native.t_EventId)): unit
    takes Seq.length(done) < Seq.length(input)
    gives not (Native.choose_ready(input, done) == Option.Option_None) and chosen_is_first(input, done, Native.choose_ready(input, done))
    hint Native.choose_ready(input, done)
  {
    ranked_incomplete_scan_progress(facts, done, rank, bound);
    scheduler_choice_is_exact(input, done);
    assert(not (Native.choose_ready(input, done) == Option.Option_None) and
      chosen_is_first(input, done, Native.choose_ready(input, done))) by {
      Tactics.prune("Nickel.EditCausal.causal_rank");
      Tactics.prune("Nickel_crdt.Edit.choose_ready");
      Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
      Tactics.smt_sync'(1, 1)
    }
  };
  proof choice_shape(done: t_Slice(Native.t_EventId)): unit
    gives Native.choose_ready(input, done) == Option.Option_None or
      (exists(index: usize) . Native.choose_ready(input, done) == Option.Option_Some(index))
    hint Native.choose_ready(input, done)
  { () };
  proof event_shape(event: Native.t_Fact, operations: t_Slice((Native.t_EventId, Alloc.Vec.t_Vec(Native.t_Node, Alloc.Alloc.t_Global))), tree: Native.t_Tree): unit
    gives result_shape(Native.interpret_event(input, event, operations, tree))
    hint Native.interpret_event(input, event, operations, tree)
  { () };
  proof extend_at_call(done: ids_vec, operations: operations_vec, tree: Native.t_Tree,
    index: usize where v(index) < Seq.length(input)): unit
    takes event_work_prefix(input, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree)
    takes Seq.length(Alloc.Vec.impl_1__as_slice(done)) < Seq.length(input)
    gives prefix_can_extend_at(input, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree, index)
    hint Native.choose_ready(input, Alloc.Vec.impl_1__as_slice(done)),
      Native.interpret_event(input, Seq.index(input, v(index)), Alloc.Vec.impl_1__as_slice(operations), tree)
  {
    prefix_extension_is_actual_work(input, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree, index);
    assert(prefix_can_extend_at(input, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree, index)) by {
      Tactics.prune("Nickel.EditCausal.causal_rank");
      Tactics.prune("Nickel.EditSchedule.event_work_prefix");
      Tactics.prune("Nickel_crdt.Edit.interpret_event");
      Tactics.prune("Nickel_crdt.Edit.choose_ready");
      Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
      Tactics.smt_sync'(0, 0)
    }
  };
  prefix_starts_at_actual_empty(input);
  empty_trace_is_valid(input);
  Nickel.Vector.empty_vector_contents<#Native.t_EventId>();
  Nickel.Vector.empty_vector_contents<#operation_pair>();
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(input),
    schedule_progress_invariant(input), schedule_done, complete_causal_trace(input), tree_work_failed(facts));
  assert(Nickel.LoopUtil.result_safe(complete_causal_trace(input), tree_work_failed(facts), Native.interpret_scheduled(input))) by {
    Tactics.prune("Nickel.EditSchedule.event_work_prefix");
    Tactics.prune("Nickel.EditCausal.causal_rank");
    Tactics.prune("Nickel.EditSchedule.causal_trace");
    Tactics.prune("Nickel_crdt.Edit.interpret_event");
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
proof interpret_errors_come_from_tree_work(facts: facts_vec, rank: Native.t_EventId => nat, bound: nat, error: Native.t_Error): unit
  takes causal_rank(facts, rank, bound)
  takes ids_unique(facts)
  takes Native.interpret(Alloc.Vec.impl_1__as_slice(facts)) == Result.Result_Err(error)
  gives tree_work_failed(facts, error)
{
  ranked_outer_errors_come_from_tree_work(facts, rank, bound);
  interpret_erases_only_schedule(Alloc.Vec.impl_1__as_slice(facts));
  proof shape(): unit
    gives result_shape(Native.interpret_scheduled(Alloc.Vec.impl_1__as_slice(facts)))
  { () };
  shape();
  assert(tree_work_failed(facts, error)) by {
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
    Tactics.prune("Nickel_crdt.Event_shell.scheduled");
    Tactics.smt_sync'(1, 1)
  }
}

// The completed run retains all helper-produced groups, including empty ones.
// This is actual execution provenance, not independent document semantics.
function complete_event_work(facts: t_Slice(Native.t_Fact), pair: (Native.t_Tree, ids_vec)): Type0 {
  match pair { (tree, done) =>
    complete_causal_trace(facts, pair) and
    exists(operations: operations_vec) .
      Seq.length(Alloc.Vec.impl_1__as_slice(operations)) == Seq.length(facts) and
      event_work_prefix(facts, Seq.length(facts), done, operations, tree)
  }
}
proof successful_schedule_has_complete_event_work(facts: t_Slice(Native.t_Fact)): unit
  gives Nickel.LoopUtil.result_safe(complete_event_work(facts), ((_: Native.t_Error) => Prims.l_True), Native.interpret_scheduled(facts))
{
  proof choice_shape(done: t_Slice(Native.t_EventId)): unit
    gives Native.choose_ready(facts, done) == Option.Option_None or (exists(i: usize) . Native.choose_ready(facts, done) == Option.Option_Some(i))
    hint Native.choose_ready(facts, done)
  { () };
  proof event_shape(event: Native.t_Fact, operations: t_Slice(operation_pair), tree: Native.t_Tree): unit
    gives result_shape(Native.interpret_event(facts, event, operations, tree))
    hint Native.interpret_event(facts, event, operations, tree)
  { () };
  proof extend_at_call(done: ids_vec, operations: operations_vec, tree: Native.t_Tree,
    index: usize where v(index) < Seq.length(facts)): unit
    takes event_work_prefix(facts, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree)
    takes Seq.length(Alloc.Vec.impl_1__as_slice(done)) < Seq.length(facts)
    gives prefix_can_extend_at(facts, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree, index)
    hint Native.choose_ready(facts, Alloc.Vec.impl_1__as_slice(done)),
      Native.interpret_event(facts, Seq.index(facts, v(index)), Alloc.Vec.impl_1__as_slice(operations), tree)
  {
    prefix_extension_is_actual_work(facts, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree, index);
    assert(prefix_can_extend_at(facts, Seq.length(Alloc.Vec.impl_1__as_slice(done)), done, operations, tree, index)) by {
      Tactics.prune("Nickel.EditSchedule.event_work_prefix");
      Tactics.prune("Nickel_crdt.Edit.interpret_event");
      Tactics.prune("Nickel_crdt.Edit.choose_ready");
      Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
      Tactics.smt_sync'(0, 0)
    }
  };
  prefix_starts_at_actual_empty(facts);
  empty_trace_is_valid(facts);
  Nickel.Vector.empty_vector_contents<#Native.t_EventId>();
  Nickel.Vector.empty_vector_contents<#operation_pair>();
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    schedule_progress_invariant(facts), schedule_done, complete_event_work(facts), ((_: Native.t_Error) => Prims.l_True));
  assert(Nickel.LoopUtil.result_safe(complete_event_work(facts), ((_: Native.t_Error) => Prims.l_True), Native.interpret_scheduled(facts))) by {
    Tactics.prune("Nickel.EditSchedule.event_work_prefix");
    Tactics.prune("Nickel.EditSchedule.causal_trace");
    Tactics.prune("Nickel_crdt.Edit.interpret_event");
    Tactics.prune("Nickel_crdt.Edit.choose_ready");
    Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

function operation_labels_match(done: ids_vec, operations: operations_vec): Type0 {
  const ids = Alloc.Vec.impl_1__as_slice(done);
  const groups = Alloc.Vec.impl_1__as_slice(operations);
  Seq.length(ids) == Seq.length(groups) and
  (forall(i: FStar.Fin.under(Seq.length(ids))) .
    (match Seq.index(groups, i) { (id, _) => id }) == Seq.index(ids, i))
}
proof! actual_prefix_groups_match_trace(facts: t_Slice(Native.t_Fact), count: nat,
  done: ids_vec, operations: operations_vec, tree: Native.t_Tree): unit
  decreases count
  takes event_work_prefix(facts, count, done, operations, tree)
  gives operation_labels_match(done, operations)
{
  if count ==? 0 { () } else {
    proof transfer(step: event_work_step): unit
      takes (match step { (previous_done, previous_operations, previous_tree, _, _) =>
        event_work_prefix(facts, count - 1, previous_done, previous_operations, previous_tree) })
      takes prefix_step_valid(facts, done, operations, tree, step)
      gives operation_labels_match(done, operations)
    {
      match step { (previous_done, previous_operations, previous_tree, new_operations, index) =>
        if v(index) < Seq.length(facts) {
          actual_prefix_groups_match_trace(facts, count - 1, previous_done, previous_operations, previous_tree);
          assert(operation_labels_match(previous_done, previous_operations)) by {
            Tactics.prune("Nickel.EditSchedule.event_work_prefix");
            Tactics.prune("Nickel_crdt.Edit.interpret_event");
            Tactics.prune("Nickel_crdt.Edit.choose_ready");
            Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
            Tactics.smt_sync'(0, 0)
          };
          ()
        } else { () }
      }
    };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(transfer));
    assert(operation_labels_match(done, operations)) by {
      Tactics.prune("Nickel_crdt.Edit.interpret_event");
      Tactics.prune("Nickel_crdt.Edit.choose_ready");
      Tactics.prune("Nickel_crdt.Event_layer.choose_ready");
      Tactics.smt_sync'(1, 1)
    }
  }
}

function interpretation_event_work(facts: t_Slice(Native.t_Fact), tree: Native.t_Tree): Type0 {
  exists(done: ids_vec, operations: operations_vec) .
    Native.interpret_scheduled(facts) == Result.Result_Ok((tree, done)) and
    complete_causal_trace(facts, (tree, done)) and
    (forall(i: FStar.Fin.under(Seq.length(facts))) . member(Alloc.Vec.impl_1__as_slice(done), Seq.index(facts, i).f_id)) and
    Seq.length(Alloc.Vec.impl_1__as_slice(operations)) == Seq.length(facts) and
    operation_labels_match(done, operations) and
    event_work_prefix(facts, Seq.length(facts), done, operations, tree)
}
// The wrapper erases storage for the groups; it does not weaken their provenance.
// No rank, causal-closure or helper-success premise is needed for this conditional.
proof successful_interpretation_has_operation_provenance(facts: t_Slice(Native.t_Fact), tree: Native.t_Tree): unit
  takes Native.interpret(facts) == Result.Result_Ok(tree)
  gives interpretation_event_work(facts, tree)
{
  successful_schedule_has_complete_event_work(facts);
  interpret_erases_only_schedule(facts);
  proof each(done: ids_vec, operations: operations_vec): unit
    takes Native.interpret_scheduled(facts) == Result.Result_Ok((tree, done))
    takes complete_causal_trace(facts, (tree, done))
    takes Seq.length(Alloc.Vec.impl_1__as_slice(operations)) == Seq.length(facts)
    takes event_work_prefix(facts, Seq.length(facts), done, operations, tree)
    gives interpretation_event_work(facts, tree)
  {
    full_trace_covers_storage(facts, done);
    actual_prefix_groups_match_trace(facts, Seq.length(facts), done, operations, tree);
    assert(interpretation_event_work(facts, tree)) by {
      Tactics.prune("Nickel.EditSchedule.event_work_prefix");
      Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
      Tactics.prune("Nickel_crdt.Event_shell.scheduled");
      Tactics.prune("Nickel_crdt.Edit.interpret");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each));
  proof shape(): unit
    gives result_shape(Native.interpret_scheduled(facts))
  { () };
  shape();
  assert(interpretation_event_work(facts, tree)) by {
    Tactics.prune("Nickel.EditSchedule.event_work_prefix");
    Tactics.prune("Nickel_crdt.Edit.interpret_scheduled");
    Tactics.prune("Nickel_crdt.Event_shell.scheduled");
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.smt_sync'(1, 1)
  }
}
