proof whole_selection_covers(input: t_Slice(Native.t_Fact), out: facts_vec): unit
  takes content_invariant(input, v(Nickel.EditIdentity.length(input)), out)
  takes ids_unique(out)
  gives forall(at: nat where at < Seq.length(input)) . fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at))
{
  proof no_missing(at: nat where at < Seq.length(input)): unit
    takes Prims.l_not(fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at)))
    gives Prims.l_False
    hint fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at))
  {
    if Seq.length(input) > 1 {
      const positions = Seq.init(Seq.length(input), squeezed_position(input, out, at));
      Seq.lemma_init_len(Seq.length(input), squeezed_position(input, out, at));
      Seq.init_index(Seq.length(input), squeezed_position(input, out, at));
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j);
          assert(squeezed_position(input, out, at, i) == squeezed_position(input, out, at, j));
          squeezed_equal_facts(input, out, at, i, j);
          unique_nat_positions(out, i, j)
        }
      }
    } else {
      assert(Seq.length(input) == 1);
      assert(fact_present(input, Seq.index(Alloc.Vec.impl_1__as_slice(out), 0)));
      assert(Seq.index(Alloc.Vec.impl_1__as_slice(out), 0) == Seq.index(input, at));
      assert(fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at)))
    }
  };
  ()
}
