proof event_key_identifies_event(a: Native.t_EventId, b: Native.t_EventId): unit
  takes event_key(a) == event_key(b)
  gives a == b
{
  ()
}
function facts_strictly_ordered(facts: facts_vec): Type0 {
  forall(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts))), j: usize where v(j) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts)))) .
    v(i) < v(j) ==> Native.event_lt(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), i).f_id, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), j).f_id) == true
}
proof ordered_unique_is_strict(facts: facts_vec): unit
  takes ids_unique(facts)
  takes facts_ordered(facts)
  gives facts_strictly_ordered(facts)
{
  proof each_pair(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts))), j: usize where v(j) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts)))): unit
    gives v(i) < v(j) ==> Native.event_lt(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), i).f_id, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), j).f_id) == true
  {
    const a = Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), i).f_id;
    const b = Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), j).f_id;
    if v(i) < v(j) {
      assert(event_key(a) <= event_key(b));
      if event_key(a) ==? event_key(b) { event_key_identifies_event(a, b); unique_positions(facts, i, j) } else { () };
      event_order_is_key_order(a, b)
    } else { () }
  };
  FStar.Classical.forall_intro_2(each_pair);
  ()
}
function strict_canonical_result(result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(facts) => facts_strictly_ordered(facts), _ => Prims.l_True }
}
proof canonical_facts_are_strictly_ordered(input: t_Slice(Native.t_Fact)): unit
  gives strict_canonical_result(Native.canonical(input))
{
  canonical_has_unique_ids(input);
  canonical_orders_facts(input);
  match Native.canonical(input) {
    Result.Result_Ok(out) => ordered_unique_is_strict(out), _ => ()
  };
  ()
}

// Equality of sorted whole-fact vectors, before lifting to actual canonicalization.
function prefix_equal(left: facts_vec, right: facts_vec, at: nat): Type0 {
  forall(i: nat where i < Seq.length(Alloc.Vec.impl_1__as_slice(left)) and i < Seq.length(Alloc.Vec.impl_1__as_slice(right))) .
    i < at ==> Seq.index(Alloc.Vec.impl_1__as_slice(left), i) == Seq.index(Alloc.Vec.impl_1__as_slice(right), i)
}
proof strict_nat_pair(facts: facts_vec, i: nat where i < Seq.length(Alloc.Vec.impl_1__as_slice(facts)), j: nat where j < Seq.length(Alloc.Vec.impl_1__as_slice(facts))): unit
  takes facts_strictly_ordered(facts)
  takes i < j
  gives event_key(Seq.index(Alloc.Vec.impl_1__as_slice(facts), i).f_id) < event_key(Seq.index(Alloc.Vec.impl_1__as_slice(facts), j).f_id)
{
  const ii = mk_usize(i);
  const jj = mk_usize(j);
  assert(Native.event_lt(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), ii).f_id, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), jj).f_id) == true);
  event_order_is_key_order(Seq.index(Alloc.Vec.impl_1__as_slice(facts), i).f_id, Seq.index(Alloc.Vec.impl_1__as_slice(facts), j).f_id)
}
proof ordered_vectors_next(left: facts_vec, right: facts_vec,
  at: nat where at < Seq.length(Alloc.Vec.impl_1__as_slice(left)) and at < Seq.length(Alloc.Vec.impl_1__as_slice(right))): unit
  takes ids_unique(left) and ids_unique(right)
  takes facts_strictly_ordered(left) and facts_strictly_ordered(right)
  takes same_fact_contents(Alloc.Vec.impl_1__as_slice(left), right)
  takes prefix_equal(left, right, at)
  gives Seq.index(Alloc.Vec.impl_1__as_slice(left), at) == Seq.index(Alloc.Vec.impl_1__as_slice(right), at)
{
  const a = Seq.index(Alloc.Vec.impl_1__as_slice(left), at);
  const b = Seq.index(Alloc.Vec.impl_1__as_slice(right), at);
  assert(fact_present(Alloc.Vec.impl_1__as_slice(left), a));
  assert(fact_present(Alloc.Vec.impl_1__as_slice(right), b));
  const j = find_fact_position(Alloc.Vec.impl_1__as_slice(right), a);
  const k = find_fact_position(Alloc.Vec.impl_1__as_slice(left), b);
  if j < at { unique_nat_positions(left, j, at) } else { () };
  if k < at { unique_nat_positions(right, k, at) } else { () };
  if at < j {
    strict_nat_pair(right, at, j);
    if at < k { strict_nat_pair(left, at, k) } else { assert(k == at) };
    assert(Prims.l_False)
  } else { assert(j == at) }
}
proof! ordered_vectors_prefix(left: facts_vec, right: facts_vec,
  at: nat where at <= Seq.length(Alloc.Vec.impl_1__as_slice(left))): unit
  decreases Seq.length(Alloc.Vec.impl_1__as_slice(left)) - at
  takes Seq.length(Alloc.Vec.impl_1__as_slice(left)) == Seq.length(Alloc.Vec.impl_1__as_slice(right))
  takes ids_unique(left) and ids_unique(right)
  takes facts_strictly_ordered(left) and facts_strictly_ordered(right)
  takes same_fact_contents(Alloc.Vec.impl_1__as_slice(left), right)
  takes prefix_equal(left, right, at)
  gives prefix_equal(left, right, Seq.length(Alloc.Vec.impl_1__as_slice(left)))
{
  if at < Seq.length(Alloc.Vec.impl_1__as_slice(left)) {
    ordered_vectors_next(left, right, at);
    assert(prefix_equal(left, right, at + 1));
    ordered_vectors_prefix(left, right, at + 1)
  } else { () }
}
proof ordered_contents_determine_vector(left: facts_vec, right: facts_vec): unit
  takes Seq.length(Alloc.Vec.impl_1__as_slice(left)) == Seq.length(Alloc.Vec.impl_1__as_slice(right))
  takes ids_unique(left) and ids_unique(right)
  takes facts_strictly_ordered(left) and facts_strictly_ordered(right)
  takes same_fact_contents(Alloc.Vec.impl_1__as_slice(left), right)
  gives left == right
{
  ordered_vectors_prefix(left, right, 0);
  Seq.lemma_eq_intro(Alloc.Vec.impl_1__as_slice(left), Alloc.Vec.impl_1__as_slice(right));
  Seq.lemma_eq_elim(Alloc.Vec.impl_1__as_slice(left), Alloc.Vec.impl_1__as_slice(right))
}
function same_input_contents_and_length(left: t_Slice(Native.t_Fact), right: t_Slice(Native.t_Fact)): Type0 {
  Seq.length(left) == Seq.length(right) and
  (forall(fact: Native.t_Fact) . fact_present(left, fact) <==> fact_present(right, fact))
}
function canonical_agreement(left: Result.t_Result(facts_vec, Native.t_Error), right: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match (left, right) { (Result.Result_Ok(a), Result.Result_Ok(b)) => a == b, _ => Prims.l_True }
}
proof canonical_is_permutation_independent(left: t_Slice(Native.t_Fact), right: t_Slice(Native.t_Fact)): unit
  takes same_input_contents_and_length(left, right)
  gives canonical_agreement(Native.canonical(left), Native.canonical(right))
{
  canonical_preserves_exact_contents(left);
  canonical_preserves_exact_contents(right);
  canonical_has_unique_ids(left);
  canonical_has_unique_ids(right);
  canonical_facts_are_strictly_ordered(left);
  canonical_facts_are_strictly_ordered(right);
  match (Native.canonical(left), Native.canonical(right)) {
    (Result.Result_Ok(a), Result.Result_Ok(b)) => {
      ordered_contents_determine_vector(a, b)
    }, _ => ()
  };
  ()
}
function plan_interpretation(outcome: Result.t_Result(Option.t_Option(Native.t_Replica), Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(Option.Option_Some(next)) => Native.interpret(Alloc.Vec.impl_1__as_slice(next.f_facts)) == Result.Result_Ok(next.f_tree), _ => Prims.l_True }
}
proof plan_publishes_interpretation(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives plan_interpretation(Native.impl_Replica__plan(before, fact))
{
  proof each_tree_facts(state: Native.t_Replica, tree: Native.t_Tree): unit
    gives Native.impl_Replica__with_tree(state, tree).f_facts == state.f_facts
    hint Native.impl_Replica__with_tree(state, tree)
  { tree_installation_preserves_facts(state, tree) };
  proof each_tree(state: Native.t_Replica, tree: Native.t_Tree): unit
    gives Native.impl_Replica__with_tree(state, tree).f_tree == tree
    hint Native.impl_Replica__with_tree(state, tree)
  { tree_installation_installs_tree(state, tree) };
  assert(plan_interpretation(Native.impl_Replica__plan(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__with_tree");
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__duplicate");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
function added_shared_agreement(left: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error)), right: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match left {
    (a, Result.Result_Ok(Native.Admission_Added)) => match right {
      (b, Result.Result_Ok(Native.Admission_Added)) => a.f_facts == b.f_facts and a.f_tree == b.f_tree,
      _ => Prims.l_True
    }, _ => Prims.l_True
  }
}
proof receive_added_shared_state_agrees(left: Native.t_Replica, left_fact: Native.t_Fact, right: Native.t_Replica, right_fact: Native.t_Fact): unit
  takes same_input_contents_and_length(Alloc.Vec.impl_1__as_slice(candidate_facts(left, left_fact)), Alloc.Vec.impl_1__as_slice(candidate_facts(right, right_fact)))
  gives added_shared_agreement(Native.impl_Replica__receive(left, left_fact), Native.impl_Replica__receive(right, right_fact))
{
  plan_publishes_canonical_facts(left, left_fact);
  plan_publishes_canonical_facts(right, right_fact);
  plan_publishes_interpretation(left, left_fact);
  plan_publishes_interpretation(right, right_fact);
  canonical_is_permutation_independent(Alloc.Vec.impl_1__as_slice(candidate_facts(left, left_fact)), Alloc.Vec.impl_1__as_slice(candidate_facts(right, right_fact)))
}

// A non-vacuous success law for canonical fact storage. Replay progress is separate.
function choice_total(result: Result.t_Result(Option.t_Option(usize), Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => Prims.l_True, _ => Prims.l_False }
}
function choice_bounds(input: t_Slice(Native.t_Fact), at: nat, choice: Option.t_Option(usize)): Type0 {
  match choice { Option.Option_None => Prims.l_True, Option.Option_Some(k) => v(k) < at and v(k) < Seq.length(input) }
}
proof choice_always_returns(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): unit
  gives choice_total(Native.choose_unseen(input, out))
{
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(input),
    choice_bounds(input), ((choice: Option.t_Option(usize)) => choice), ((_: Option.t_Option(usize)) => Prims.l_True),
    ((_: Native.t_Error) => Prims.l_False));
  assert(choice_total(Native.choose_unseen(input, out))) by {
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
function find_id_position(input: t_Slice(Native.t_Fact), id: Native.t_EventId where Native.has_fact(input, id)):
  i: nat where i < Seq.length(input) and Seq.index(input, i).f_id == id
{
  membership_absence_exact(input, id);
  match FStar.Fin.find(input, old => old.f_id ==? id, 0) {
    Some(i) => i,
    None => { 0 }
  }
}
proof unique_slice_nat_positions(input: t_Slice(Native.t_Fact), i: nat where i < Seq.length(input), j: nat where j < Seq.length(input)): unit
  takes Nickel.EditIdentity.unique_ids(input)
  takes Seq.index(input, i).f_id == Seq.index(input, j).f_id
  gives i == j
{
  assert(Rust_primitives.Slice.slice_index(input, mk_usize(i)).f_id == Rust_primitives.Slice.slice_index(input, mk_usize(j)).f_id);
  assert(mk_usize(i) == mk_usize(j))
}
function mapped_id_position(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact) where Seq.length(out) > 0 and Seq.length(out) < Seq.length(input) and (forall(i: nat where i < Seq.length(input)) . Native.has_fact(out, Seq.index(input, i).f_id)),
  i: nat where i < Seq.length(out) + 1): FStar.Fin.under(Seq.length(out)) {
  find_id_position(out, Seq.index(input, i).f_id)
}
proof shorter_output_has_unseen(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)) : unit
  takes Nickel.EditIdentity.unique_ids(input)
  takes Seq.length(out) < Seq.length(input)
  gives Prims.l_not(forall(i: nat where i < Seq.length(input)) . Native.has_fact(out, Seq.index(input, i).f_id))
{
  proof impossible(): unit
    takes forall(i: nat where i < Seq.length(input)) . Native.has_fact(out, Seq.index(input, i).f_id)
    gives Prims.l_False
  {
    if Seq.length(out) ==? 0 {
      membership_absence_exact(out, Seq.index(input, 0).f_id)
    } else {
      const position = mapped_id_position(input, out);
      const positions = Seq.init(Seq.length(out) + 1, position);
      Seq.lemma_init_len(Seq.length(out) + 1, position);
      Seq.init_index(Seq.length(out) + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j);
          assert(position(i) == position(j));
          unique_slice_nat_positions(input, i, j)
        }
      }
    }
  };
  FStar.Classical.move_requires(impossible, ())
}
function canonical_total(result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => Prims.l_True, _ => Prims.l_False }
}
proof canonical_step_succeeds(input: t_Slice(Native.t_Fact), out: facts_vec): unit
  takes Nickel.EditIdentity.unique_ids(input)
  takes Seq.length(Alloc.Vec.impl_1__as_slice(out)) < Seq.length(input)
  gives canonical_total(Native.canonical_step(input, out))
{
  Nickel.EventGraphText.text_graph_policy_is_exact();
  Nickel.EventGraphText.text_graph_callbacks_are_exact();
  choice_always_returns(input, Alloc.Vec.impl_1__as_slice(out));
  selected_id_is_least(input, Alloc.Vec.impl_1__as_slice(out));
  shorter_output_has_unseen(input, Alloc.Vec.impl_1__as_slice(out));
  match Native.choose_unseen(input, Alloc.Vec.impl_1__as_slice(out)) {
    Result.Result_Ok(Option.Option_Some(k)) => {
      assert(v(k) < Seq.length(input));
      push_result_is_exact(out, Native.clone_selected_fact(Rust_primitives.Slice.slice_index(input, k)));
      assert(canonical_total(Native.canonical_step(input, out))) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
        Tactics.prune("Nickel_crdt.Edit.choose_unseen");
    Tactics.prune("Nickel_crdt.Event_layer.choose_unseen");
        Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
        Tactics.prune("Nickel_crdt.Edit.clone_selected_fact");
        Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
        Tactics.smt_sync'(1, 1)
      }
    },
    Result.Result_Ok(Option.Option_None) => {
      proof all_seen(i: nat where i < Seq.length(input)): unit
        gives Native.has_fact(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, i).f_id)
        hint Native.has_fact(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, i).f_id)
      {
        assert(Native.has_fact(Alloc.Vec.impl_1__as_slice(out), Rust_primitives.Slice.slice_index(input, mk_usize(i)).f_id))
      };
      assert(Prims.l_False)
    },
    _ => ()
  }
}
function progress_invariant(input: t_Slice(Native.t_Fact), at: nat, out: facts_vec): Type0 { content_invariant(input, at, out) }
proof canonical_succeeds_for_unique_ids(input: t_Slice(Native.t_Fact)): unit
  takes Nickel.EditIdentity.unique_ids(input)
  gives canonical_total(Native.canonical(input))
{
  canonical_uses_complete_range(input);
  Nickel.Vector.empty_vector_value<#Native.t_Fact>();
  proof each_step(out: facts_vec): unit
    takes Seq.length(Alloc.Vec.impl_1__as_slice(out)) < Seq.length(input)
    takes selected_whole_facts(input, out)
    gives canonical_total(Native.canonical_step(input, out)) and
      (match Native.canonical_step(input, out) { Result.Result_Ok(next) => progress_invariant(input, Seq.length(Alloc.Vec.impl_1__as_slice(out)) + 1, next), _ => Prims.l_False })
    hint Native.canonical_step(input, out)
  {
    canonical_step_succeeds(input, out);
    canonical_step_selects_whole_facts(input, out, v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))))
  };
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(input),
    progress_invariant(input), ((out: facts_vec) => out), ((_: facts_vec) => Prims.l_True),
    ((_: Native.t_Error) => Prims.l_False));
  assert(canonical_total(Native.canonical(input))) by {
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Nickel_crdt.Edit.choose_unseen");
    Tactics.prune("Nickel_crdt.Event_layer.choose_unseen");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
function total_canonical_agreement(left: Result.t_Result(facts_vec, Native.t_Error), right: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match left { Result.Result_Ok(a) => match right { Result.Result_Ok(b) => a == b, _ => Prims.l_False }, _ => Prims.l_False }
}
proof unique_inputs_canonicalize_identically(left: t_Slice(Native.t_Fact), right: t_Slice(Native.t_Fact)): unit
  takes Nickel.EditIdentity.unique_ids(left)
  takes Nickel.EditIdentity.unique_ids(right)
  takes same_input_contents_and_length(left, right)
  gives total_canonical_agreement(Native.canonical(left), Native.canonical(right))
{
  canonical_succeeds_for_unique_ids(left);
  canonical_succeeds_for_unique_ids(right);
  canonical_is_permutation_independent(left, right);
  ()
}
