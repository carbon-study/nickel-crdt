import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.LoopUtil
import Nickel.LoopEquality
import Nickel.EventGraphText
import Nickel.EditIdentity
import Native = Nickel_crdt.Edit
import Result = Core_models.Result
import Option = Core_models.Option
import Tactics = FStar.Tactics.V2
import Nickel.Vector
import Seq = FStar.Seq

// Accepted-ID uniqueness and exact successful fact contents, not full edit WF.
unfold type facts_vec = Alloc.Vec.t_Vec(Native.t_Fact, Alloc.Alloc.t_Global)
function ids_unique(facts: facts_vec): Type0 { Nickel.EditIdentity.unique_ids(Alloc.Vec.impl_1__as_slice(facts)) }
function member_next(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): Nickel.LoopUtil.transition(unit, Nickel.EditIdentity.length(facts)) {
  (_, at) => if Rust_primitives.Slice.slice_index(facts, at).f_id ==? id { Option.Option_None } else { Option.Option_Some(()) }
}
function member_stop(value: unit, at: usize): bool { true }
function member_done(value: unit): bool { false }
function member_value(found: Option.t_Option(Native.t_Fact)): bool {
  match found { Option.Option_None => false, Option.Option_Some(_) => true }
}
function member_run(facts: t_Slice(Native.t_Fact), id: Native.t_EventId, at: usize where v(at) <= v(Nickel.EditIdentity.length(facts))): bool {
  Nickel.LoopUtil.option_run(Nickel.EditIdentity.length(facts), at, (), member_next(facts, id), member_stop, member_done)
}
proof! member_lookup(facts: t_Slice(Native.t_Fact), id: Native.t_EventId, at: usize where v(at) <= v(Nickel.EditIdentity.length(facts))): unit
  decreases v(Nickel.EditIdentity.length(facts)) - v(at)
  gives member_run(facts, id, at) == member_value(Nickel.EditIdentity.first_id(facts, id, at))
{
  if v(at) < v(Nickel.EditIdentity.length(facts)) {
    Nickel.LoopUtil.option_run_step(Nickel.EditIdentity.length(facts), at, (), member_next(facts, id), member_stop, member_done);
    if !(Rust_primitives.Slice.slice_index(facts, at).f_id ==? id) {
      member_lookup(facts, id, at +! mk_int(1));
      assert(member_run(facts, id, at) == member_value(Nickel.EditIdentity.first_id(facts, id, at))) by {
        Tactics.prune("Nickel.LoopUtil.option_run");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    } else {
      assert(member_run(facts, id, at) == member_value(Nickel.EditIdentity.first_id(facts, id, at))) by {
        Tactics.prune("Nickel.LoopUtil.option_run");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    }
  } else {
    Nickel.LoopUtil.option_run_end(Nickel.EditIdentity.length(facts), at, (), member_next(facts, id), member_stop, member_done);
    assert(member_run(facts, id, at) == member_value(Nickel.EditIdentity.first_id(facts, id, at))) by {
        Tactics.prune("Nickel.LoopUtil.option_run");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
  }
}
proof membership_exact(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  gives Native.has_fact(facts, id) == member_value(Nickel.EditIdentity.first_id(facts, id, mk_usize(0)))
{
  Nickel.LoopUtil.option_interpret_any(mk_usize(0), Nickel.EditIdentity.length(facts), member_next(facts, id), member_stop, member_done);
  member_lookup(facts, id, mk_usize(0));
  assert(Native.has_fact(facts, id) == member_value(Nickel.EditIdentity.first_id(facts, id, mk_usize(0)))) by {
    Tactics.prune("Nickel.LoopUtil.option_run");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
proof membership_absent(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  takes Native.has_fact(facts, id) == false
  gives Nickel.EditIdentity.prefix_absent(facts, id, mk_usize(0), Nickel.EditIdentity.length(facts))
{
  membership_exact(facts, id);
  Nickel.EditIdentity.lookup_none(facts, id, mk_usize(0))
}

function choice_safe(facts: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact), choice: Option.t_Option(usize)): Type0 {
  match choice {
    Option.Option_None => Prims.l_True,
    Option.Option_Some(i) => if v(i) < v(Nickel.EditIdentity.length(facts)) {
      Native.has_fact(out, Rust_primitives.Slice.slice_index(facts, i).f_id) == false
    } else { Prims.l_False }
  }
}
function choice_invariant(facts: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): nat => Option.t_Option(usize) => Type0 {
  (_, choice) => choice_safe(facts, out, choice)
}
function choice_post(facts: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): Option.t_Option(usize) => Type0 {
  choice => choice_safe(facts, out, choice)
}
function choice_returned(facts: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): Result.t_Result(Option.t_Option(usize), Native.t_Error) => Type0 {
  result => match result { Result.Result_Err(_) => Prims.l_True, Result.Result_Ok(choice) => choice_safe(facts, out, choice) }
}
proof selected_id_is_unseen(facts: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): unit
  gives choice_returned(facts, out)(Native.choose_unseen(facts, out))
{
  Nickel.EventGraphText.text_graph_policy_is_exact();
  Nickel.EventGraphText.text_graph_callbacks_are_exact();
  // Keep the callee's declared Boolean range when its definition facts are hidden.
  proof each_membership_boolean(xs: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
    gives Native.has_fact(xs, id) == true or Native.has_fact(xs, id) == false
    hint Native.has_fact(xs, id)
  { () };
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(facts),
    choice_invariant(facts, out), ((choice: Option.t_Option(usize)) => choice), choice_post(facts, out),
    ((_: Native.t_Error) => Prims.l_True));
  assert(choice_returned(facts, out)(Native.choose_unseen(facts, out))) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

// Exact source-function contract: failure is neutral; success appends one fact.
function push_outcome<item: Type0>(before: Alloc.Vec.t_Vec(item, Alloc.Alloc.t_Global), fact: item): (Alloc.Vec.t_Vec(item, Alloc.Alloc.t_Global), Result.t_Result(unit, Native.t_Error)) {
  if v(Alloc.Vec.impl_1__len(before)) ==? max_usize {
    (before, Result.Result_Err(Native.Error_Internal))
  } else {
    (Alloc.Vec.from_seq(Seq.append(Alloc.Vec.impl_1__as_slice(before), Seq.create(1, fact))), Result.Result_Ok(()))
  }
}
proof push_result_is_exact<item: Type0>(before: Alloc.Vec.t_Vec(item, Alloc.Alloc.t_Global), fact: item): unit
  gives Native.push(before, fact) == push_outcome(before, fact)
  hint Native.push(before, fact)
{
  proof length_value(): unit
    gives Alloc.Vec.impl_1__len(before) == mk_usize(Seq.length(Alloc.Vec.impl_1__as_slice(before)))
  { () };
  length_value();
  if v(Alloc.Vec.impl_1__len(before)) ==? max_usize {
    assert(Native.push(before, fact) == push_outcome(before, fact)) by {
      Tactics.prune("Alloc.Vec.from_seq");
      Tactics.prune("Alloc.Vec.impl_1__as_slice");
      Tactics.prune("Alloc.Vec.impl_1__len");
      Tactics.prune("Core_models.Slice.impl__len");
      Tactics.prune("Rust_primitives.Slice.slice_index");
      Tactics.prune("Alloc.Vec.impl__new");
      Tactics.smt_sync'(1, 1)
    }
  } else {
    Nickel.Vector.vector_from_seq_value(Seq.append(Alloc.Vec.impl_1__as_slice(before), Seq.create(1, fact)));
    assert(Native.push(before, fact) == push_outcome(before, fact)) by {
      Tactics.prune("Alloc.Vec.from_seq");
      Tactics.prune("Alloc.Vec.impl_1__as_slice");
      Tactics.prune("Alloc.Vec.impl_1__len");
      Tactics.prune("Core_models.Slice.impl__len");
      Tactics.prune("Rust_primitives.Slice.slice_index");
      Tactics.prune("Alloc.Vec.impl__new");
      Tactics.smt_sync'(1, 1)
    }
  }
}
function push_result_unique(outcome: (facts_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(_)) => ids_unique(next), _ => Prims.l_True }
}
proof append_fresh_preserves_unique(facts: facts_vec, fact: Native.t_Fact): unit
  takes ids_unique(facts)
  takes Native.has_fact(Alloc.Vec.impl_1__as_slice(facts), fact.f_id) == false
  gives push_result_unique(Native.push(facts, fact))
{
  membership_absent(Alloc.Vec.impl_1__as_slice(facts), fact.f_id);
  assert(push_result_unique(Native.push(facts, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}

function unique_invariant(at: nat, facts: facts_vec): Type0 { ids_unique(facts) }
function canonical_result_unique(result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(facts) => ids_unique(facts), _ => Prims.l_True }
}
proof selected_fact_keeps_id(fact: Native.t_Fact): unit
  gives Native.clone_selected_fact(fact).f_id == fact.f_id
{ () }
proof canonical_step_preserves_unique(facts: t_Slice(Native.t_Fact), out: facts_vec): unit
  takes ids_unique(out)
  gives canonical_result_unique(Native.canonical_step(facts, out))
{
  selected_id_is_unseen(facts, Alloc.Vec.impl_1__as_slice(out));
  match Native.choose_unseen(facts, Alloc.Vec.impl_1__as_slice(out)) {
    Result.Result_Ok(Option.Option_Some(i)) => if v(i) < v(Nickel.EditIdentity.length(facts)) {
      selected_fact_keeps_id(Rust_primitives.Slice.slice_index(facts, i));
      append_fresh_preserves_unique(out, Native.clone_selected_fact(Rust_primitives.Slice.slice_index(facts, i)))
    } else { () },
    _ => ()
  }
}
proof empty_has_unique_ids(): unit
  gives ids_unique(Alloc.Vec.impl__new(()))
{
  Nickel.Vector.empty_vector_contents<#Native.t_Fact>();
  assert(ids_unique(Alloc.Vec.impl__new(()))) by {
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
// Exact loop frame: source-bound range, initial state and one fallible step.
// Keep the interpreter encoding here; the owners below use its Result rule.
// The transparent alias keeps the loop result type aligned with native code.
function canonical_loop_result(input: t_Slice(Native.t_Fact)): Result.t_Result(facts_vec, Native.t_Error) {
  const loop = Rust_primitives.Hax.Folds.fold_range_return(mk_usize(0), Core_models.Slice.impl__len(input),
    ((_, _) => true),
    (Alloc.Vec.impl__new(()) : facts_vec),
    ((out, _) => match Native.canonical_step(input, out) {
      Result.Result_Ok(next) => Core_models.Ops.Control_flow.ControlFlow_Continue(next),
      Result.Result_Err(error) => Core_models.Ops.Control_flow.ControlFlow_Break(Core_models.Ops.Control_flow.ControlFlow_Break(Result.Result_Err(error))),
    }));
  match loop {
    Core_models.Ops.Control_flow.ControlFlow_Break(ret) => ret,
    Core_models.Ops.Control_flow.ControlFlow_Continue(out) => Result.Result_Ok(out),
  }
}
proof canonical_uses_complete_range(input: t_Slice(Native.t_Fact)): unit
  gives Native.canonical(input) == canonical_loop_result(input)
{
  Nickel.EventGraphText.text_graph_policy_is_exact();
  Nickel.LoopEquality.pointwise_callbacks_any<#facts_vec, #Result.t_Result(facts_vec, Native.t_Error)>(mk_usize(0), Core_models.Slice.impl__len(input));
  assert(Native.canonical(input) == canonical_loop_result(input)) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
proof canonical_has_unique_ids(facts: t_Slice(Native.t_Fact)): unit
  gives canonical_result_unique(Native.canonical(facts))
{
  canonical_uses_complete_range(facts);
  Nickel.Vector.empty_vector_value<#Native.t_Fact>();
  proof each_step(out: facts_vec): unit
    takes ids_unique(out)
    gives canonical_result_unique(Native.canonical_step(facts, out))
    hint Native.canonical_step(facts, out)
  {
    canonical_step_preserves_unique(facts, out);
    assert(canonical_result_unique(Native.canonical_step(facts, out))) by {
      Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
      Tactics.smt_sync'(1, 1)
    }
  };
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(facts),
    unique_invariant, ((out: facts_vec) => out), ids_unique,
    ((_: Native.t_Error) => Prims.l_True));
  assert(canonical_result_unique(Native.canonical(facts))) by {
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

// The with_tree setter contract for the installed tree.
proof tree_installation_installs_tree(state: Native.t_Replica, tree: Native.t_Tree): unit
  gives Native.impl_Replica__with_tree(state, tree).f_tree == tree
{
  ()
}
proof tree_installation_preserves_facts(state: Native.t_Replica, tree: Native.t_Tree): unit
  gives Native.impl_Replica__with_tree(state, tree).f_facts == state.f_facts
{
  ()
}

// Bind the private successful trial to the exact canonicalization input/output.
function candidate_facts(before: Native.t_Replica, fact: Native.t_Fact): facts_vec {
  match Native.push(before.f_facts, fact) { (facts, _) => facts }
}
function canonical_publication(before: Native.t_Replica, fact: Native.t_Fact, outcome: Result.t_Result(Option.t_Option(Native.t_Replica), Native.t_Error)): Type0 {
  match outcome {
    Result.Result_Ok(Option.Option_Some(next)) =>
      Native.canonical(Alloc.Vec.impl_1__as_slice(candidate_facts(before, fact))) == Result.Result_Ok(next.f_facts),
    _ => Prims.l_True
  }
}
// Expose the result constructors when the planner's callee bodies are withheld,
// as plan_has_result_shape does for plan itself. These state only the declared
// result type; withholding a function also withholds its typing facts.
function result_shape<value: Type0>(result: Result.t_Result(value, Native.t_Error)): Type0 {
  (exists(error: Native.t_Error) . result == Result.Result_Err(error)) or
  (exists(out: value) . result == Result.Result_Ok(out))
}
proof canonical_has_result_shape(input: t_Slice(Native.t_Fact)): unit
  gives result_shape(Native.canonical(input))
  hint Native.canonical(input)
{ () }
proof interpret_has_result_shape(input: t_Slice(Native.t_Fact)): unit
  gives result_shape(Native.interpret(input))
  hint Native.interpret(input)
{ () }
proof plan_publishes_canonical_facts(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives canonical_publication(before, fact, Native.impl_Replica__plan(before, fact))
{
  proof each_tree_facts(state: Native.t_Replica, tree: Native.t_Tree): unit
    gives Native.impl_Replica__with_tree(state, tree).f_facts == state.f_facts
    hint Native.impl_Replica__with_tree(state, tree)
  { tree_installation_preserves_facts(state, tree) };
  assert(canonical_publication(before, fact, Native.impl_Replica__plan(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__with_tree");
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__duplicate");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}

function added_state_unique(outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(Native.Admission_Added)) => ids_unique(next.f_facts), _ => Prims.l_True }
}
// Successful publication passes through the checked canonicalizer, even when
// the arbitrary supplied before-state was not well formed.
proof receive_added_ids_are_unique(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives added_state_unique(Native.impl_Replica__receive(before, fact))
{
  plan_publishes_canonical_facts(before, fact);
  canonical_has_unique_ids(Alloc.Vec.impl_1__as_slice(candidate_facts(before, fact)))
}
function receive_state_unique(outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (next, _) => ids_unique(next.f_facts) }
}
proof receive_preserves_unique_ids(before: Native.t_Replica, fact: Native.t_Fact): unit
  takes ids_unique(before.f_facts)
  gives receive_state_unique(Native.impl_Replica__receive(before, fact))
{
  Nickel.EditAtomic.receive_rejection_unchanged(before, fact);
  receive_added_ids_are_unique(before, fact);
  ()
}
function edit_state_unique(outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome { (next, _) => ids_unique(next.f_facts) }
}
proof edit_preserves_unique_ids(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  takes ids_unique(before.f_facts)
  gives edit_state_unique(Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditAtomic.edit_rejection_or_empty_unchanged(before, gap, insert, delete);
  Nickel.EditCommit.authored_fact_replays_same_commit(before, gap, insert, delete);
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (_, Result.Result_Ok(Native.Local_Authored(fact))) => receive_added_ids_are_unique(before, fact),
    _ => ()
  };
  ()
}

function new_state_unique(outcome: Result.t_Result(Native.t_Replica, Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(state) => ids_unique(state.f_facts), _ => Prims.l_True }
}
proof new_establishes_unique_ids(writer: Option.t_Option(Native.t_Writer), limits: Native.t_Limits): unit
  gives new_state_unique(Native.impl_Replica__new(writer, limits))
{
  empty_has_unique_ids()
}

// A successful canonical result selects whole original facts and has exactly
// the input length. Together with unique IDs this is the publication's finite
// permutation certificate; the finite coverage implication is proved below.
proof selected_fact_is_exact(fact: Native.t_Fact): unit
  gives Native.clone_selected_fact(fact) == fact
{ () }
function fact_present(facts: t_Slice(Native.t_Fact), fact: Native.t_Fact): Type0 {
  exists(i: nat) . i < FStar.Seq.length(facts) and FStar.Seq.index(facts, i) == fact
}
function selected_whole_facts(input: t_Slice(Native.t_Fact), output: facts_vec): Type0 {
  forall(i: nat) . i < FStar.Seq.length(Alloc.Vec.impl_1__as_slice(output)) ==>
    fact_present(input, FStar.Seq.index(Alloc.Vec.impl_1__as_slice(output), i))
}
function content_invariant(input: t_Slice(Native.t_Fact), at: nat, out: facts_vec): Type0 {
  v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))) == at and selected_whole_facts(input, out)
}
function content_step_result(input: t_Slice(Native.t_Fact), at: nat, result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(out) => content_invariant(input, at + 1, out), _ => Prims.l_True }
}
function append_content_result(input: t_Slice(Native.t_Fact), out: facts_vec, outcome: (facts_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(_)) => content_invariant(input, v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))) + 1, next),
    _ => Prims.l_True
  }
}
proof append_whole_fact(input: t_Slice(Native.t_Fact), out: facts_vec, fact: Native.t_Fact): unit
  takes selected_whole_facts(input, out)
  takes fact_present(input, fact)
  gives append_content_result(input, out, Native.push(out, fact))
{
  assert(append_content_result(input, out, Native.push(out, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
proof canonical_step_selects_whole_facts(input: t_Slice(Native.t_Fact), out: facts_vec, at: nat): unit
  takes content_invariant(input, at, out)
  gives content_step_result(input, at, Native.canonical_step(input, out))
{
  match Native.choose_unseen(input, Alloc.Vec.impl_1__as_slice(out)) {
    Result.Result_Ok(Option.Option_Some(i)) => if v(i) < v(Nickel.EditIdentity.length(input)) {
      selected_fact_is_exact(Rust_primitives.Slice.slice_index(input, i));
      assert(fact_present(input, Rust_primitives.Slice.slice_index(input, i)));
      append_whole_fact(input, out, Rust_primitives.Slice.slice_index(input, i))
    } else { () },
    _ => ()
  }
}
function canonical_content_result(input: t_Slice(Native.t_Fact), result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(out) => content_invariant(input, v(Nickel.EditIdentity.length(input)), out), _ => Prims.l_True }
}
proof canonical_selects_whole_facts(input: t_Slice(Native.t_Fact)): unit
  gives canonical_content_result(input, Native.canonical(input))
{
  canonical_uses_complete_range(input);
  Nickel.Vector.empty_vector_value<#Native.t_Fact>();
  proof each_content_step(out: facts_vec): unit
    takes selected_whole_facts(input, out)
    gives content_step_result(input, v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))), Native.canonical_step(input, out))
    hint Native.canonical_step(input, out)
  {
    canonical_step_selects_whole_facts(input, out, v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))));
    assert(content_step_result(input, v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))), Native.canonical_step(input, out))) by {
      Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
      Tactics.smt_sync'(1, 1)
    }
  };
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(input),
    content_invariant(input), ((out: facts_vec) => out), content_invariant(input, v(Nickel.EditIdentity.length(input))),
    ((_: Native.t_Error) => Prims.l_True));
  assert(canonical_content_result(input, Native.canonical(input))) by {
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}

// Finite coverage is proved by the standard checked pigeonhole principle,
// applied to original positions with one supposedly missing position removed.
import FStar.Classical
import FStar.Fin

type fact_position(input: t_Slice(Native.t_Fact), fact: Native.t_Fact) = i: nat where
  i < Seq.length(input) and Seq.index(input, i) == fact
function find_fact_position(input: t_Slice(Native.t_Fact), fact: Native.t_Fact where fact_present(input, fact)): fact_position(input, fact) {
  match FStar.Fin.find(input, old => old ==? fact, 0) {
    Some(i) => i,
    None => 0
  }
}
function squeezed_position(input: t_Slice(Native.t_Fact) where Seq.length(input) > 1,
  out: facts_vec where selected_whole_facts(input, out),
  missing: nat where missing < Seq.length(input) and Prims.l_not(fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, missing))),
  at: nat where at < Seq.length(Alloc.Vec.impl_1__as_slice(out))): FStar.Fin.under(Seq.length(input) - 1) {
  const position = find_fact_position(input, Seq.index(Alloc.Vec.impl_1__as_slice(out), at));
  if position < missing { position } else { position - 1 }
}
proof squeezed_equal_facts(input: t_Slice(Native.t_Fact) where Seq.length(input) > 1,
  out: facts_vec where selected_whole_facts(input, out),
  missing: nat where missing < Seq.length(input) and Prims.l_not(fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, missing))),
  i: nat where i < Seq.length(Alloc.Vec.impl_1__as_slice(out)), j: nat where j < Seq.length(Alloc.Vec.impl_1__as_slice(out))): unit
  takes squeezed_position(input, out, missing, i) == squeezed_position(input, out, missing, j)
  gives Seq.index(Alloc.Vec.impl_1__as_slice(out), i) == Seq.index(Alloc.Vec.impl_1__as_slice(out), j)
{
  ()
}
proof unique_positions(out: facts_vec, i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))), j: usize where v(j) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out)))): unit
  takes ids_unique(out)
  takes Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i).f_id == Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), j).f_id
  gives i == j
{
  ()
}
proof unique_nat_positions(out: facts_vec, i: nat where i < Seq.length(Alloc.Vec.impl_1__as_slice(out)), j: nat where j < Seq.length(Alloc.Vec.impl_1__as_slice(out))): unit
  takes ids_unique(out)
  takes Seq.index(Alloc.Vec.impl_1__as_slice(out), i) == Seq.index(Alloc.Vec.impl_1__as_slice(out), j)
  gives i == j
{
  unique_positions(out, mk_usize(i), mk_usize(j))
}
proof whole_selection_covers(input: t_Slice(Native.t_Fact), out: facts_vec): unit
  takes content_invariant(input, v(Nickel.EditIdentity.length(input)), out)
  takes ids_unique(out)
  gives forall(at: nat where at < Seq.length(input)) . fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at))
{
  proof no_missing(at: nat where at < Seq.length(input)): unit
    takes Prims.l_not(fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at)))
    gives Prims.l_False
    hint fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at))
  {
    if Seq.length(input) > 1 {
      const positions = Seq.init(Seq.length(input), squeezed_position(input, out, at));
      Seq.lemma_init_len(Seq.length(input), squeezed_position(input, out, at));
      Seq.init_index(Seq.length(input), squeezed_position(input, out, at));
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j);
          assert(squeezed_position(input, out, at, i) == squeezed_position(input, out, at, j));
          squeezed_equal_facts(input, out, at, i, j);
          unique_nat_positions(out, i, j)
        }
      }
    } else {
      assert(Seq.length(input) == 1);
      assert(fact_present(input, Seq.index(Alloc.Vec.impl_1__as_slice(out), 0)));
      assert(Seq.index(Alloc.Vec.impl_1__as_slice(out), 0) == Seq.index(input, at));
      assert(fact_present(Alloc.Vec.impl_1__as_slice(out), Seq.index(input, at)))
    }
  };
  ()
}
function same_fact_contents(input: t_Slice(Native.t_Fact), out: facts_vec): Type0 {
  forall(fact: Native.t_Fact) . fact_present(input, fact) <==> fact_present(Alloc.Vec.impl_1__as_slice(out), fact)
}
function canonical_exact_result(input: t_Slice(Native.t_Fact), result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result {
    Result.Result_Ok(out) => same_fact_contents(input, out) and v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))) == v(Nickel.EditIdentity.length(input)),
    _ => Prims.l_True
  }
}
proof canonical_preserves_exact_contents(input: t_Slice(Native.t_Fact)): unit
  gives canonical_exact_result(input, Native.canonical(input))
{
  canonical_selects_whole_facts(input);
  canonical_has_unique_ids(input);
  match Native.canonical(input) {
    Result.Result_Ok(out) => whole_selection_covers(input, out),
    _ => ()
  };
  ()
}
function appended_contents(before: facts_vec, fact: Native.t_Fact, next: facts_vec): Type0 {
  v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(next))) == v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(before))) + 1 and
  forall(item: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(next), item) <==>
    (fact_present(Alloc.Vec.impl_1__as_slice(before), item) or item == fact)
}
function push_exact_result(before: facts_vec, fact: Native.t_Fact, outcome: (facts_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(_)) => appended_contents(before, fact, next), _ => Prims.l_True }
}
proof push_has_exact_contents(before: facts_vec, fact: Native.t_Fact): unit
  gives push_exact_result(before, fact, Native.push(before, fact))
{
  assert(push_exact_result(before, fact, Native.push(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function plan_push_succeeded(before: Native.t_Replica, fact: Native.t_Fact, outcome: Result.t_Result(Option.t_Option(Native.t_Replica), Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(Option.Option_Some(_)) => (match Native.push(before.f_facts, fact) { (_, result) => result == Result.Result_Ok(()) }), _ => Prims.l_True }
}
proof successful_plan_pushed_fact(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives plan_push_succeeded(before, fact, Native.impl_Replica__plan(before, fact))
{
  ()
}
function plan_exact_contents(before: Native.t_Replica, fact: Native.t_Fact, outcome: Result.t_Result(Option.t_Option(Native.t_Replica), Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(Option.Option_Some(next)) => appended_contents(before.f_facts, fact, next.f_facts), _ => Prims.l_True }
}
proof successful_plan_has_exact_contents(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives plan_exact_contents(before, fact, Native.impl_Replica__plan(before, fact))
{
  successful_plan_pushed_fact(before, fact);
  push_has_exact_contents(before.f_facts, fact);
  plan_publishes_canonical_facts(before, fact);
  canonical_preserves_exact_contents(Alloc.Vec.impl_1__as_slice(candidate_facts(before, fact)));
  ()
}
function added_exact_contents(before: Native.t_Replica, fact: Native.t_Fact, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(Native.Admission_Added)) => appended_contents(before.f_facts, fact, next.f_facts), _ => Prims.l_True }
}
proof receive_added_has_exact_contents(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives added_exact_contents(before, fact, Native.impl_Replica__receive(before, fact))
{
  successful_plan_has_exact_contents(before, fact)
}
function authored_exact_contents(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(Native.Local_Authored(fact))) => appended_contents(before.f_facts, fact, next.f_facts), _ => Prims.l_True }
}
proof edit_authored_has_exact_contents(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives authored_exact_contents(before, Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditCommit.authored_fact_replays_same_commit(before, gap, insert, delete);
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (_, Result.Result_Ok(Native.Local_Authored(fact))) => receive_added_has_exact_contents(before, fact),
    _ => ()
  };
  ()
}

// Canonical fact order is event-ID order, not causal replay order or text order.
function event_key(id: Native.t_EventId): nat {
  const rank = match id.f_writer { Native.Writer_Alice => 0, Native.Writer_Bo => 18446744073709551616 };
  rank + v(id.f_counter)
}
proof event_order_is_key_order(a: Native.t_EventId, b: Native.t_EventId): unit
  gives (Native.event_lt(a, b) == true <==> event_key(a) < event_key(b))
{
  assert(Native.event_lt(a, b) == true <==> event_key(a) < event_key(b)) by {
    Tactics.prune("Nickel_crdt.Edit.writer_index");
    Tactics.smt_sync'(1, 1)
  }
}
function least_choice(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact), at: nat, choice: Option.t_Option(usize)): Type0 {
  match choice {
    Option.Option_None => forall(j: usize where v(j) < v(Nickel.EditIdentity.length(input))) .
      v(j) < at ==> Native.has_fact(out, Rust_primitives.Slice.slice_index(input, j).f_id),
    Option.Option_Some(k) => v(k) < v(Nickel.EditIdentity.length(input)) and
      Native.has_fact(out, Rust_primitives.Slice.slice_index(input, k).f_id) == false and
      (forall(j: usize where v(j) < v(Nickel.EditIdentity.length(input))) .
        (v(j) < at and Native.has_fact(out, Rust_primitives.Slice.slice_index(input, j).f_id) == false) ==>
          event_key(Rust_primitives.Slice.slice_index(input, k).f_id) <= event_key(Rust_primitives.Slice.slice_index(input, j).f_id))
  }
}
function least_result(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact), result: Result.t_Result(Option.t_Option(usize), Native.t_Error)): Type0 {
  match result { Result.Result_Ok(choice) => least_choice(input, out, v(Nickel.EditIdentity.length(input)), choice), _ => Prims.l_True }
}
// One loop step in spec terms; the loop owner only matches the native body to it.
function least_next(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact), j: usize where v(j) < v(Nickel.EditIdentity.length(input)), choice: Option.t_Option(usize)): Option.t_Option(usize) {
  if Native.has_fact(out, Rust_primitives.Slice.slice_index(input, j).f_id) { choice } else {
    match choice {
      Option.Option_None => Option.Option_Some(j),
      Option.Option_Some(k) => if v(k) < v(Nickel.EditIdentity.length(input)) && event_key(Rust_primitives.Slice.slice_index(input, j).f_id) < event_key(Rust_primitives.Slice.slice_index(input, k).f_id) { Option.Option_Some(j) } else { choice },
    }
  }
}
proof least_extends_all(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): unit
  gives forall(j: usize where v(j) < v(Nickel.EditIdentity.length(input)), choice: Option.t_Option(usize)) .
    least_choice(input, out, v(j), choice) ==> least_choice(input, out, v(j) + 1, least_next(input, out, j, choice))
{
  proof each(j: usize where v(j) < v(Nickel.EditIdentity.length(input)), choice: Option.t_Option(usize)): unit
    gives least_choice(input, out, v(j), choice) ==> least_choice(input, out, v(j) + 1, least_next(input, out, j, choice))
  { () };
  FStar.Classical.forall_intro_2(each)
}
proof selected_id_is_least(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)): unit
  gives least_result(input, out, Native.choose_unseen(input, out))
{
  Nickel.EventGraphText.text_graph_policy_is_exact();
  Nickel.EventGraphText.text_graph_callbacks_are_exact();
  proof each_order(a: Native.t_EventId, b: Native.t_EventId): unit
    gives (Native.event_lt(a, b) == true <==> event_key(a) < event_key(b))
    hint Native.event_lt(a, b)
  { event_order_is_key_order(a, b) };
  least_extends_all(input, out);
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(input),
    least_choice(input, out), ((choice: Option.t_Option(usize)) => choice), least_choice(input, out, v(Nickel.EditIdentity.length(input))),
    ((_: Native.t_Error) => Prims.l_True));
  assert(least_result(input, out, Native.choose_unseen(input, out))) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
    Tactics.prune("Nickel_crdt.Edit.event_lt");
    Tactics.smt_sync'(1, 1)
  }
}

proof! absent_lookup(input: t_Slice(Native.t_Fact), id: Native.t_EventId,
  at: usize where v(at) <= v(Nickel.EditIdentity.length(input))): unit
  decreases v(Nickel.EditIdentity.length(input)) - v(at)
  takes Nickel.EditIdentity.prefix_absent(input, id, at, Nickel.EditIdentity.length(input))
  gives Nickel.EditIdentity.first_id(input, id, at) == Option.Option_None
{
  if v(at) < v(Nickel.EditIdentity.length(input)) {
    absent_lookup(input, id, at +! mk_int(1))
  } else { () }
}
proof membership_absence_exact(input: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  gives (Native.has_fact(input, id) == false <==> Nickel.EditIdentity.prefix_absent(input, id, mk_usize(0), Nickel.EditIdentity.length(input)))
{
  proof reverse(dummy: unit): unit
    takes Nickel.EditIdentity.prefix_absent(input, id, mk_usize(0), Nickel.EditIdentity.length(input))
    gives Native.has_fact(input, id) == false
  {
    membership_exact(input, id);
    absent_lookup(input, id, mk_usize(0));
    assert(Native.has_fact(input, id) == false) by {
      Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
      Tactics.prune("Core_models.Slice.impl__len");
      Tactics.prune("Rust_primitives.Slice.slice_index");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.move_requires(reverse, ());
  if Native.has_fact(input, id) {
    assert((Native.has_fact(input, id) == false <==> Nickel.EditIdentity.prefix_absent(input, id, mk_usize(0), Nickel.EditIdentity.length(input)))) by {
      Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
      Tactics.prune("Core_models.Slice.impl__len");
      Tactics.prune("Rust_primitives.Slice.slice_index");
      Tactics.smt_sync'(1, 1)
    }
  } else {
    membership_absent(input, id);
    assert((Native.has_fact(input, id) == false <==> Nickel.EditIdentity.prefix_absent(input, id, mk_usize(0), Nickel.EditIdentity.length(input)))) by {
      Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
      Tactics.prune("Core_models.Slice.impl__len");
      Tactics.prune("Rust_primitives.Slice.slice_index");
      Tactics.smt_sync'(1, 1)
    }
  }
}
function facts_ordered(facts: facts_vec): Type0 {
  forall(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts))), j: usize where v(j) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts)))) .
    v(i) < v(j) ==> event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(facts), j).f_id)
}
function order_frontier(input: t_Slice(Native.t_Fact), out: facts_vec): Type0 {
  facts_ordered(out) and
  (forall(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))), j: usize where v(j) < v(Nickel.EditIdentity.length(input))) .
    Native.has_fact(Alloc.Vec.impl_1__as_slice(out), Rust_primitives.Slice.slice_index(input, j).f_id) == false ==>
      event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(input, j).f_id))
}
function ordered_push_result(input: t_Slice(Native.t_Fact), result: (facts_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match result { (next, Result.Result_Ok(_)) => order_frontier(input, next), _ => Prims.l_True }
}
function absent_after_push(out: facts_vec, fact: Native.t_Fact, id: Native.t_EventId, result: (facts_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match result { (next, Result.Result_Ok(_)) =>
    (Native.has_fact(Alloc.Vec.impl_1__as_slice(next), id) == false <==>
      (Native.has_fact(Alloc.Vec.impl_1__as_slice(out), id) == false and Prims.l_not(fact.f_id == id))),
    _ => Prims.l_True }
}
proof push_membership(out: facts_vec, fact: Native.t_Fact, id: Native.t_EventId): unit
  gives absent_after_push(out, fact, id, Native.push(out, fact))
{
  membership_absence_exact(Alloc.Vec.impl_1__as_slice(out), id);
  match Native.push(out, fact) {
    (next, Result.Result_Ok(_)) => {
      membership_absence_exact(Alloc.Vec.impl_1__as_slice(next), id);
      assert(absent_after_push(out, fact, id, Native.push(out, fact))) by {
        Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
        Tactics.prune("Alloc.Vec.impl_1__as_slice");
        Tactics.prune("Alloc.Vec.from_seq");
        Tactics.prune("Alloc.Vec.impl_1__len");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    }, _ => ()
  }
}
// Instantiate the frontier contract before exposing a native append's arrays.
proof frontier_bounds_unseen(input: t_Slice(Native.t_Fact), out: facts_vec,
  i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))),
  k: usize where v(k) < v(Nickel.EditIdentity.length(input))): unit
  takes order_frontier(input, out)
  takes Native.has_fact(Alloc.Vec.impl_1__as_slice(out), Rust_primitives.Slice.slice_index(input, k).f_id) == false
  gives event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(input, k).f_id)
{
  ()
}
proof append_least_preserves_frontier(input: t_Slice(Native.t_Fact), out: facts_vec,
  k: usize where v(k) < v(Nickel.EditIdentity.length(input))): unit
  takes order_frontier(input, out)
  takes least_choice(input, Alloc.Vec.impl_1__as_slice(out), v(Nickel.EditIdentity.length(input)), Option.Option_Some(k))
  gives ordered_push_result(input, Native.push(out, Rust_primitives.Slice.slice_index(input, k)))
{
  const fact = Rust_primitives.Slice.slice_index(input, k);
  match Native.push(out, fact) {
    (next, Result.Result_Ok(_)) => {
      proof each_frontier(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(next))), j: usize where v(j) < v(Nickel.EditIdentity.length(input))): unit
        takes Native.has_fact(Alloc.Vec.impl_1__as_slice(next), Rust_primitives.Slice.slice_index(input, j).f_id) == false
        gives event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(input, j).f_id)
      {
        push_membership(out, fact, Rust_primitives.Slice.slice_index(input, j).f_id);
        assert(Native.push(out, fact) == (next, Result.Result_Ok(())));
        assert(Native.has_fact(Alloc.Vec.impl_1__as_slice(out), Rust_primitives.Slice.slice_index(input, j).f_id) == false) by {
          // Consume push_membership without reopening either membership scan.
          Tactics.prune("Nickel_crdt.Edit.has_fact");
          Tactics.prune("Nickel_crdt.Event_layer.has_fact");
          Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
          Tactics.smt_sync'(1, 1)
        };
        if v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))) {
          assert(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), i) == Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i));
          frontier_bounds_unseen(input, out, i, j);
          assert(event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(input, j).f_id))
        } else {
          assert(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), i) == fact);
          assert(event_key(fact.f_id) <= event_key(Rust_primitives.Slice.slice_index(input, j).f_id))
        }
      };
      proof each_frontier_imp(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(next))), j: usize where v(j) < v(Nickel.EditIdentity.length(input))): unit
        gives Native.has_fact(Alloc.Vec.impl_1__as_slice(next), Rust_primitives.Slice.slice_index(input, j).f_id) == false ==>
          event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(input, j).f_id)
      { FStar.Classical.move_requires_2(each_frontier, i, j) };
      FStar.Classical.forall_intro_2(each_frontier_imp);
      proof each_pair(i: usize where v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(next))), j: usize where v(j) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(next)))): unit
        gives v(i) < v(j) ==> event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), j).f_id)
      {
        assert(Alloc.Vec.impl_1__as_slice(next) == Seq.append(Alloc.Vec.impl_1__as_slice(out), Seq.create(1, fact))) by {
          Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
          Tactics.prune("Alloc.Vec.impl_1__as_slice");
          Tactics.prune("Alloc.Vec.from_seq");
          Tactics.prune("Alloc.Vec.impl_1__len");
          Tactics.smt_sync'(1, 1)
        };
        if v(i) < v(j) {
          assert(v(i) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))));
          assert(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), i) == Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i));
          if v(j) < v(Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(out))) {
            assert(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), j) == Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), j));
            assert(event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i).f_id) <= event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), j).f_id))
          } else {
            assert(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(next), j) == fact);
            frontier_bounds_unseen(input, out, i, k);
            assert(event_key(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(out), i).f_id) <= event_key(fact.f_id))
          }
        } else { () }
      };
      FStar.Classical.forall_intro_2(each_pair)
    }, _ => ()
  }
}
function order_step_result(input: t_Slice(Native.t_Fact), result: Result.t_Result(facts_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(next) => order_frontier(input, next), _ => Prims.l_True }
}
proof canonical_step_preserves_order(input: t_Slice(Native.t_Fact), out: facts_vec): unit
  takes order_frontier(input, out)
  gives order_step_result(input, Native.canonical_step(input, out))
{
  selected_id_is_least(input, Alloc.Vec.impl_1__as_slice(out));
  match Native.choose_unseen(input, Alloc.Vec.impl_1__as_slice(out)) {
    Result.Result_Ok(Option.Option_Some(k)) => if v(k) < v(Nickel.EditIdentity.length(input)) {
      selected_fact_is_exact(Rust_primitives.Slice.slice_index(input, k));
      append_least_preserves_frontier(input, out, k)
    } else { () },
    _ => ()
  }
}
function order_invariant(input: t_Slice(Native.t_Fact), at: nat, out: facts_vec): Type0 { order_frontier(input, out) }
proof canonical_orders_facts(input: t_Slice(Native.t_Fact)): unit
  gives order_step_result(input, Native.canonical(input))
{
  canonical_uses_complete_range(input);
  Nickel.Vector.empty_vector_value<#Native.t_Fact>();
  proof each_order_step(out: facts_vec): unit
    takes order_frontier(input, out)
    gives order_step_result(input, Native.canonical_step(input, out))
    hint Native.canonical_step(input, out)
  { canonical_step_preserves_order(input, out) };
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Nickel.EditIdentity.length(input),
    order_invariant(input), ((out: facts_vec) => out), order_frontier(input),
    ((_: Native.t_Error) => Prims.l_True));
  assert(order_step_result(input, Native.canonical(input))) by {
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.canonical_step");
    Tactics.prune("Nickel_crdt.Event_layer.canonical_step");
    Tactics.prune("Nickel_crdt.Edit.choose_unseen");
    Tactics.prune("Nickel_crdt.Event_layer.choose_unseen");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
function added_ordered(outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
