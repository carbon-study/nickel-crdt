proof ordered_vectors_next(left: facts_vec, right: facts_vec,
  at: nat where at < Seq.length(Alloc.Vec.impl_1__as_slice(left)) and at < Seq.length(Alloc.Vec.impl_1__as_slice(right))): unit
  takes ids_unique(left) and ids_unique(right)
  takes facts_strictly_ordered(left) and facts_strictly_ordered(right)
  takes same_fact_contents(Alloc.Vec.impl_1__as_slice(left), right)
  takes prefix_equal(left, right, at)
