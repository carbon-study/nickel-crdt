{
  const a = Seq.index(Alloc.Vec.impl_1__as_slice(left), at);
  const b = Seq.index(Alloc.Vec.impl_1__as_slice(right), at);
  assert(fact_present(Alloc.Vec.impl_1__as_slice(left), a));
  assert(fact_present(Alloc.Vec.impl_1__as_slice(right), b));
  const j = find_fact_position(Alloc.Vec.impl_1__as_slice(right), a);
  const k = find_fact_position(Alloc.Vec.impl_1__as_slice(left), b);
  if j < at { unique_nat_positions(left, j, at) } else { () };
  if k < at { unique_nat_positions(right, k, at) } else { () };
  if at < j {
    strict_nat_pair(right, at, j);
    if at < k { strict_nat_pair(left, at, k) } else { assert(k == at) };
    assert(Prims.l_False)
  } else { assert(j == at) }
}
