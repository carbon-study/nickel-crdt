proof shorter_output_has_unseen(input: t_Slice(Native.t_Fact), out: t_Slice(Native.t_Fact)) : unit
  takes Nickel.EditIdentity.unique_ids(input)
  takes Seq.length(out) < Seq.length(input)
  gives Prims.l_not(forall(i: nat where i < Seq.length(input)) . Native.has_fact(out, Seq.index(input, i).f_id))
{
  proof impossible(): unit
    takes forall(i: nat where i < Seq.length(input)) . Native.has_fact(out, Seq.index(input, i).f_id)
    gives Prims.l_False
  {
    if Seq.length(out) ==? 0 {
      membership_absence_exact(out, Seq.index(input, 0).f_id);
      norm_spec([delta_only(["Nickel.EditIdentity.prefix_absent", "Nickel.EditIdentity.length", "Core_models.Slice.impl__len"]), iota, zeta_full, primops], Nickel.EditIdentity.prefix_absent(out, Seq.index(input, 0).f_id, mk_usize(0), Nickel.EditIdentity.length(out)))
    } else {
      const position = mapped_id_position(input, out);
      const positions = Seq.init(Seq.length(out) + 1, position);
      Seq.lemma_init_len(Seq.length(out) + 1, position);
      Seq.init_index(Seq.length(out) + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j);
          assert(position(i) == position(j));
