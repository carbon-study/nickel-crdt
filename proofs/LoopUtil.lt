import Rust_primitives
import Core_models.Ops.Control_flow
import Rust_primitives.Hax.Folds
import FStar.Pervasives

type output(state: Type0, result: Type0) = t_ControlFlow(result, state)
type iter_output(state: Type0, result: Type0) = t_ControlFlow(t_ControlFlow(result, (unit, state)), state)
type position(start: usize, finish: usize) = i: usize where
  (v(i) <= v(finish) and fold_range_wf_index(start, finish, true, v(i)))
type inv_position(start: usize, finish: usize) = i: usize where
  fold_range_wf_index(start, finish, false, v(i))
// This is hax's annotation argument, not an enforced invariant at this pin.
type invariant(state: Type0, start: usize, finish: usize) = state => inv_position(start, finish) => Type0
type callback(state: Type0, result: Type0, start: usize, finish: usize) = state => position(start, finish) => iter_output(state, result)

proof unroll<state: Type0, result: Type0>(start: usize, finish: usize where v(start) < v(finish),
  inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish)): unit
  gives fold_range_return(start, finish, inv, value, f) ==
    (match f(value, start) {
      ControlFlow_Break(ControlFlow_Break(ret)) => ControlFlow_Break(ret),
      ControlFlow_Break(ControlFlow_Continue((_, next))) => ControlFlow_Continue(next),
      ControlFlow_Continue(next) => fold_range_return(start +! mk_int(1), finish, inv, next, f),
    } : output(state, result))
{ () }

proof empty<state: Type0, result: Type0>(start: usize, finish: usize where v(start) == v(finish),
  inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish)): unit
  gives fold_range_return(start, finish, inv, value, f) == ControlFlow_Continue(value)
{ () }

function output_safe<state: Type0, result: Type0>(post: state => Type0, returned: result => Type0,
  out: output(state, result)): Type0 {
  match out { ControlFlow_Break(ret) => returned(ret), ControlFlow_Continue(next) => post(next), }
}
function step_safe<state: Type0, result: Type0>(p: nat => state => Type0,
  post: state => Type0, returned: result => Type0, at: nat, out: iter_output(state, result)): Type0 {
  match out {
    ControlFlow_Break(ControlFlow_Break(ret)) => returned(ret),
    ControlFlow_Break(ControlFlow_Continue((_, next))) => post(next),
    ControlFlow_Continue(next) => p(at + 1, next),
  }
}

// Preservation is a premise proved by each caller, independent of hax's inv.
proof! preserve<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish),
  p: nat => state => Type0, post: state => Type0, returned: result => Type0): unit
  decreases v(finish) - v(start)
  takes p(v(start), value)
  takes forall(s: state, i: position(start, finish)) . p(v(i), s) ==>
    step_safe(p, post, returned, v(i), f(s, i))
  takes forall(s: state) . p(v(finish), s) ==> post(s)
  gives output_safe(post, returned, fold_range_return(start, finish, inv, value, f))
{
  if v(start) < v(finish) {
    unroll(start, finish, inv, value, f);
    assert(step_safe(p, post, returned, v(start), f(value, start)));
    match f(value, start) {
      ControlFlow_Break(_) => (),
      ControlFlow_Continue(next) => preserve(start +! mk_int(1), finish, inv, next, f, p, post, returned),
    }
  } else { empty(start, finish, inv, value, f) }
}

// One interpreter for Option transitions with state/index-dependent early results.
import Option = Core_models.Option

type transition(state: Type0, finish: usize) = state => (i: usize where v(i) < v(finish)) => Option.t_Option(state)
function option_finish<state: Type0, result: Type0>(done: state => result, out: output(state, result)): result {
  match out { ControlFlow_Break(ret) => ret, ControlFlow_Continue(next) => done(next), }
}
function! option_run<state: Type0, result: Type0>(finish: usize, at: usize where v(at) <= v(finish), value: state,
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): result
  decreases v(finish) - v(at)
{
  if v(at) < v(finish) {
    match next(value, at) {
      Option.Option_None => stop(value, at),
      Option.Option_Some(value) => option_run(finish, at +! mk_int(1), value, next, stop, done),
    }
  } else { done(value) }
}
proof option_run_end<state: Type0, result: Type0>(finish: usize, at: usize where v(at) == v(finish), value: state,
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  gives option_run(finish, at, value, next, stop, done) == done(value)
{ () }

proof option_run_step<state: Type0, result: Type0>(finish: usize, at: usize where v(at) < v(finish), value: state,
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  gives option_run(finish, at, value, next, stop, done) ==
    (match next(value, at) {
      Option.Option_None => stop(value, at),
      Option.Option_Some(value) => option_run(finish, at +! mk_int(1), value, next, stop, done),
    } : result)
{ () }

// Both function-return and loop-break terminate this interpreter step.
function option_agrees<state: Type0, result: Type0>(start: usize, finish: usize, f: callback(state, result, start, finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): Type0 {
  forall(value: state, i: position(start, finish)) .
    (match f(value, i) {
      ControlFlow_Break(ControlFlow_Break(ret)) => (next(value, i) == Option.Option_None and stop(value, i) == ret),
      ControlFlow_Break(ControlFlow_Continue((_, out))) => (next(value, i) == Option.Option_None and stop(value, i) == done(out)),
      ControlFlow_Continue(out) => next(value, i) == Option.Option_Some(out),
    } : Type0)
}
proof! option_interpret<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  decreases v(finish) - v(start)
  takes option_agrees(start, finish, f, next, stop, done)
  gives option_finish(done, fold_range_return(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
{
  if v(start) < v(finish) {
    unroll(start, finish, inv, value, f);
    option_run_step(finish, start, value, next, stop, done);
    match f(value, start) {
      ControlFlow_Break(ControlFlow_Break(ret)) => {
        assert(next(value, start) == Option.Option_None);
        assert(stop(value, start) == ret)
      },
      ControlFlow_Break(ControlFlow_Continue((_, out))) => {
        assert(next(value, start) == Option.Option_None);
        assert(stop(value, start) == done(out))
      },
      ControlFlow_Continue(out) => {
        assert(next(value, start) == Option.Option_Some(out));
        option_interpret(start +! mk_int(1), finish, inv, out, f, next, stop, done)
      },
    }
  } else {
    empty(start, finish, inv, value, f);
    option_run_end(finish, start, value, next, stop, done)
  }
}

// Quantify over the produced callback: callers need not give it a new name/copy.
proof option_interpret_any<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  gives forall(inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish))
    hint fold_range_return(start, finish, inv, value, f) .
    option_agrees(start, finish, f, next, stop, done) ==>
      option_finish(done, fold_range_return(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
{
  proof each(inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish)): unit
    takes option_agrees(start, finish, f, next, stop, done)
    gives option_finish(done, fold_range_return(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
    hint fold_range_return(start, finish, inv, value, f)
  { option_interpret(start, finish, inv, value, f, next, stop, done) }
}

// These adapters cover the default true-invariant plain/break range encodings.
// Nontrivial user-supplied invariants need their own preservation contract.
type total_invariant(state: Type0, start: usize, finish: usize) = inv: invariant(state, start, finish) where
  forall(value: state, at: inv_position(start, finish)) . inv(value, at)
type plain_callback(state: Type0, start: usize, finish: usize) = state => position(start, finish) => state
type break_callback(state: Type0, start: usize, finish: usize) = state => position(start, finish) => t_ControlFlow((unit, state), state)
function plain_agrees<state: Type0>(start: usize, finish: usize, f: plain_callback(state, start, finish), next: transition(state, finish)): Type0 {
  forall(value: state, at: position(start, finish)) . next(value, at) == Option.Option_Some(f(value, at))
}
proof! plain_interpret<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  decreases v(finish) - v(start)
  takes plain_agrees(start, finish, f, next)
  gives done(fold_range(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
{
  if v(start) < v(finish) {
    option_run_step(finish, start, value, next, stop, done);
    assert(next(value, start) == Option.Option_Some(f(value, start)));
    plain_interpret(start +! mk_int(1), finish, inv, f(value, start), f, next, stop, done)
  } else { option_run_end(finish, start, value, next, stop, done) }
}
proof plain_interpret_any<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  gives forall(inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish))
    hint fold_range(start, finish, inv, value, f) . plain_agrees(start, finish, f, next) ==>
      done(fold_range(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
{
  proof each(inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish)): unit
    takes plain_agrees(start, finish, f, next)
    gives done(fold_range(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
    hint fold_range(start, finish, inv, value, f)
  { plain_interpret(start, finish, inv, value, f, next, stop, done) }
}

function break_agrees<state: Type0, result: Type0>(start: usize, finish: usize, f: break_callback(state, start, finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): Type0 {
  forall(value: state, at: position(start, finish)) .
    (match f(value, at) {
      ControlFlow_Break((_, out)) => (next(value, at) == Option.Option_None and stop(value, at) == done(out)),
      ControlFlow_Continue(out) => next(value, at) == Option.Option_Some(out),
    } : Type0)
}
proof! break_interpret<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  inv: total_invariant(state, start, finish), value: state, f: break_callback(state, start, finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  decreases v(finish) - v(start)
  takes break_agrees(start, finish, f, next, stop, done)
  gives done(fold_range_cf(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
{
  if v(start) < v(finish) {
    option_run_step(finish, start, value, next, stop, done);
    match f(value, start) {
      ControlFlow_Break((_, out)) => {
        assert(next(value, start) == Option.Option_None);
        assert(stop(value, start) == done(out))
      },
      ControlFlow_Continue(out) => {
        assert(next(value, start) == Option.Option_Some(out));
        break_interpret(start +! mk_int(1), finish, inv, out, f, next, stop, done)
      },
    }
  } else { option_run_end(finish, start, value, next, stop, done) }
}
proof break_interpret_any<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  next: transition(state, finish), stop: state => (i: usize where v(i) < v(finish)) => result, done: state => result): unit
  gives forall(inv: total_invariant(state, start, finish), value: state, f: break_callback(state, start, finish))
    hint fold_range_cf(start, finish, inv, value, f) . break_agrees(start, finish, f, next, stop, done) ==>
      done(fold_range_cf(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
{
  proof each(inv: total_invariant(state, start, finish), value: state, f: break_callback(state, start, finish)): unit
    takes break_agrees(start, finish, f, next, stop, done)
    gives done(fold_range_cf(start, finish, inv, value, f)) == option_run(finish, start, value, next, stop, done)
    hint fold_range_cf(start, finish, inv, value, f)
  { break_interpret(start, finish, inv, value, f, next, stop, done) }
}

// Universal adapter for the implementation callback, with explicit semantic premises.
proof preserve_any<state: Type0, result: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  p: nat => state => Type0, post: state => Type0, returned: result => Type0): unit
  gives forall(inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish))
    hint fold_range_return(start, finish, inv, value, f) .
    (p(v(start), value) and
     (forall(s: state, i: position(start, finish)) . p(v(i), s) ==> step_safe(p, post, returned, v(i), f(s, i))) and
     (forall(s: state) . p(v(finish), s) ==> post(s))) ==>
      output_safe(post, returned, fold_range_return(start, finish, inv, value, f))
{
  proof each(inv: invariant(state, start, finish), value: state, f: callback(state, result, start, finish)): unit
    takes p(v(start), value)
    takes forall(s: state, i: position(start, finish)) . p(v(i), s) ==> step_safe(p, post, returned, v(i), f(s, i))
    takes forall(s: state) . p(v(finish), s) ==> post(s)
    gives output_safe(post, returned, fold_range_return(start, finish, inv, value, f))
    hint fold_range_return(start, finish, inv, value, f)
  { preserve(start, finish, inv, value, f, p, post, returned) }
}

// Ordinary for loops: one state, one invariant, one step, one final condition.
// The hax annotation remains separate: it does not supply preservation.
type for_invariant(state: Type0, finish: usize) = (at: nat where at <= v(finish)) => state => Type0
proof plain_step<state: Type0>(start: usize, finish: usize where v(start) < v(finish),
  inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish)): unit
  gives fold_range(start, finish, inv, value, f) ==
    fold_range(start +! mk_int(1), finish, inv, f(value, start), f)
{ () }
proof plain_end<state: Type0>(start: usize, finish: usize where v(start) == v(finish),
  inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish)): unit
  gives fold_range(start, finish, inv, value, f) == value
{ () }
proof! plain_preserve<state: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish),
  p: for_invariant(state, finish), post: state => Type0): unit
  decreases v(finish) - v(start)
  takes p(v(start), value)
  takes forall(s: state, i: position(start, finish) where v(i) < v(finish)) . p(v(i), s) ==> p(v(i) + 1, f(s, i))
  takes forall(s: state) . p(v(finish), s) ==> post(s)
  gives post(fold_range(start, finish, inv, value, f))
{
  if v(start) < v(finish) {
    plain_step(start, finish, inv, value, f);
    plain_preserve(start +! mk_int(1), finish, inv, f(value, start), f, p, post)
  } else { plain_end(start, finish, inv, value, f) }
}
// Match the actual extracted anonymous callback without naming or copying it.
proof plain_preserve_any<state: Type0>(start: usize, finish: usize where v(start) <= v(finish),
  p: for_invariant(state, finish), post: state => Type0): unit
  gives forall(inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish))
    hint fold_range(start, finish, inv, value, f) .
    (p(v(start), value) and
     (forall(s: state, i: position(start, finish) where v(i) < v(finish)) . p(v(i), s) ==> p(v(i) + 1, f(s, i))) and
     (forall(s: state) . p(v(finish), s) ==> post(s))) ==>
      post(fold_range(start, finish, inv, value, f))
{
  proof each(inv: total_invariant(state, start, finish), value: state, f: plain_callback(state, start, finish)): unit
    takes p(v(start), value)
    takes forall(s: state, i: position(start, finish) where v(i) < v(finish)) . p(v(i), s) ==> p(v(i) + 1, f(s, i))
    takes forall(s: state) . p(v(finish), s) ==> post(s)
    gives post(fold_range(start, finish, inv, value, f))
    hint fold_range(start, finish, inv, value, f)
  { plain_preserve(start, finish, inv, value, f, p, post) }
}
