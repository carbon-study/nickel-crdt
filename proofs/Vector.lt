import Rust_primitives
import Rust_primitives.Slice
import Core_models
import FStar.Pervasives
import Seq = FStar.Seq

// Checked equations for the pinned hax vector/slice models. No new model axioms.
proof vector_contents<item: Type0>(items: Rust_primitives.Sequence.t_Seq(item), allocator: Core_models.Marker.t_PhantomData(Alloc.Alloc.t_Global)): unit
  gives Alloc.Vec.impl_1__as_slice(Alloc.Vec.Vec(items, allocator)) == items
  hint Alloc.Vec.impl_1__as_slice(Alloc.Vec.Vec(items, allocator))
{ () }

// Match the sequence constructor directly; callers need not unfold it first.
proof vector_from_seq<item: Type0>(items: Rust_primitives.Sequence.t_Seq(item)): unit
  gives Alloc.Vec.impl_1__as_slice(Alloc.Vec.from_seq<#item, #Alloc.Alloc.t_Global>(items)) == items
  hint Alloc.Vec.impl_1__as_slice(Alloc.Vec.from_seq<#item, #Alloc.Alloc.t_Global>(items))
{ () }

proof vector_length<item: Type0>(items: Alloc.Vec.t_Vec(item, Alloc.Alloc.t_Global)): unit
  gives v(Alloc.Vec.impl_1__len(items)) == Seq.length(Alloc.Vec.impl_1__as_slice(items))
  hint Alloc.Vec.impl_1__len(items)
{ () }

proof slice_length<item: Type0>(items: t_Slice(item)): unit
  gives v(Core_models.Slice.impl__len(items)) == Seq.length(items)
  hint Core_models.Slice.impl__len(items)
{ () }

proof slice_index<item: Type0>(items: t_Slice(item), at: usize where v(at) < Seq.length(items)): unit
  gives Rust_primitives.Slice.slice_index(items, at) == Seq.index(items, v(at))
  hint Rust_primitives.Slice.slice_index(items, at)
{ () }

// Empty construction exposes its contents without opening the model in callers.
proof empty_vector_contents<item: Type0>(): unit
  gives Alloc.Vec.impl_1__as_slice(Alloc.Vec.impl__new<#item>(())) == Seq.empty
{ () }

// Exact values retain both contents and the constructor range under opacity.
proof vector_from_seq_value<item: Type0>(items: Rust_primitives.Sequence.t_Seq(item)): unit
  gives Alloc.Vec.from_seq<#item, #Alloc.Alloc.t_Global>(items) ==
    Alloc.Vec.Vec(items, (Core_models.Marker.PhantomData : Core_models.Marker.t_PhantomData(Alloc.Alloc.t_Global)))
{ () }
proof empty_vector_value<item: Type0>(): unit
  gives Alloc.Vec.impl__new<#item>(()) ==
    Alloc.Vec.Vec(Seq.empty, (Core_models.Marker.PhantomData : Core_models.Marker.t_PhantomData(Alloc.Alloc.t_Global)))
{ () }
