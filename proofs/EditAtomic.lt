import Rust_primitives
import Core_models
import FStar.Pervasives
import Tactics = FStar.Tactics.V2
import Native = Nickel_crdt.Edit
import Result = Core_models.Result
import Option = Core_models.Option
import Nickel.Vector
import Nickel.EventShell

// Expose the result constructors when plan's implementation facts are withheld.
type plan_result = Result.t_Result(Option.t_Option(Native.t_Replica), Native.t_Error)
function plan_result_shape(result: plan_result): Type0 {
  (exists(error: Native.t_Error) . result == Result.Result_Err(error)) or
  result == Result.Result_Ok(Option.Option_None) or
  (exists(next: Native.t_Replica) . result == Result.Result_Ok(Option.Option_Some(next)))
}
proof plan_has_result_shape(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives plan_result_shape(Native.impl_Replica__plan(before, fact))
  hint Native.impl_Replica__plan(before, fact)
{ () }

// Planning propagates the classifier's errors and duplicate result immediately.
function plan_duplicate_prefix(duplicate: Result.t_Result(bool, Native.t_Error), result: plan_result): Type0 {
  match duplicate {
    Result.Result_Err(error) => result == Result.Result_Err(error),
    Result.Result_Ok(found) => if found { result == Result.Result_Ok(Option.Option_None) } else { Prims.l_True }
  }
}
proof plan_preserves_duplicate_result(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives plan_duplicate_prefix(Native.impl_Replica__duplicate(Alloc.Vec.impl_1__as_slice(before.f_facts), fact), Native.impl_Replica__plan(before, fact))
  hint Native.impl_Replica__plan(before, fact)
{
  assert(plan_duplicate_prefix(Native.impl_Replica__duplicate(Alloc.Vec.impl_1__as_slice(before.f_facts), fact), Native.impl_Replica__plan(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__duplicate");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.smt_sync'(1, 1)
  }
}

// A successful plan can only follow the actual validator's successful return.
// This constructor/control-flow contract leaves validation and rebuild opaque.
function validation_succeeded(result: Result.t_Result(unit, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => Prims.l_True, _ => Prims.l_False }
}
function plan_was_validated(validation: Result.t_Result(unit, Native.t_Error), result: plan_result): Type0 {
  match result { Result.Result_Ok(Option.Option_Some(_)) => validation_succeeded(validation), _ => Prims.l_True }
}
proof successful_plan_requires_validation(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives plan_was_validated(Native.impl_Replica__validate_new(Alloc.Vec.impl_1__as_slice(before.f_facts), fact), Native.impl_Replica__plan(before, fact))
{
  assert(plan_was_validated(Native.impl_Replica__validate_new(Alloc.Vec.impl_1__as_slice(before.f_facts), fact), Native.impl_Replica__plan(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__validate_new");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__duplicate");
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Nickel_crdt.Edit.canonical");
    Tactics.prune("Nickel_crdt.Event_layer.canonical");
    Tactics.prune("Nickel_crdt.Edit.interpret");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__with_tree");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.smt_sync'(1, 1)
  }
}

function receive_neutral(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Err(_)) => next == before,
    (next, Result.Result_Ok(Native.Admission_Duplicate)) => next == before,
    _ => Prims.l_True
  }
}
proof receive_rejection_unchanged(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives receive_neutral(before, Native.impl_Replica__receive(before, fact))
{
  assert(receive_neutral(before, Native.impl_Replica__receive(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__plan");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
    Tactics.smt_sync'(1, 1)
  }
}

function edit_neutral(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (_, Result.Result_Ok(Native.Local_Authored(_))) => Prims.l_True,
    (next, _) => next == before
  }
}
proof edit_rejection_or_empty_unchanged(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives edit_neutral(before, Native.impl_Replica__edit(before, gap, insert, delete))
{
  assert(edit_neutral(before, Native.impl_Replica__edit(before, gap, insert, delete))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__plan");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.prune("Nickel_crdt.Edit.frontier");
    Tactics.prune("Nickel_crdt.Event_layer.frontier");
    Tactics.prune("Nickel_crdt.Edit.next_counter_after");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__with_counter");
    Tactics.smt_sync'(1, 1)
  }
}

function edit_counter_step(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) =>
      v(next.f_next_counter) == v(before.f_next_counter) + 1 and
      fact.f_id.f_counter == before.f_next_counter,
    _ => Prims.l_True
  }
}
// Check the actual pure allocation step without replay/admission in its context.
// The public theorem below still covers the complete edit call.
function counter_result_step(counter: u64, result: Result.t_Result(u64, Native.t_Error)): Type0 {
  match result {
    Result.Result_Ok(next) => v(counter) <= v(Native.v_MAX_COUNTER) and v(next) == v(counter) + 1,
    Result.Result_Err(error) => v(counter) > v(Native.v_MAX_COUNTER) and error == Native.Error_Capacity(Native.Capacity_Counter)
  }
}
proof counter_result_advances_once(counter: u64): unit
  gives counter_result_step(counter, Native.next_counter_after(counter))
  hint Native.next_counter_after(counter)
{ () }
// Check the actual state installation, separately from calculating a successor.
proof counter_installation_is_exact(state: Native.t_Replica, counter: u64): unit
  gives Native.impl_Replica__with_counter(state, counter).f_next_counter == counter and
    Native.impl_Replica__with_counter(state, counter).f_writer == state.f_writer and
    Native.impl_Replica__with_counter(state, counter).f_facts == state.f_facts and
    Native.impl_Replica__with_counter(state, counter).f_tree == state.f_tree
  hint Native.impl_Replica__with_counter(state, counter)
{ () }
// Give callers the complete result, including its constructor. The weaker
// predicate above alone does not replace the pruned function's typing facts.
function counter_outcome(counter: u64): Result.t_Result(u64, Native.t_Error) {
  if v(counter) > v(Native.v_MAX_COUNTER) {
    Result.Result_Err(Native.Error_Capacity(Native.Capacity_Counter))
  } else { Result.Result_Ok(counter +! mk_u64(1)) }
}
proof counter_result_is_exact(counter: u64): unit
  gives Native.next_counter_after(counter) == counter_outcome(counter)
{ () }

// Constructor information is independent of the function producing a Result.
proof result_has_constructor<ok: Type0, err: Type0>(out: Result.t_Result(ok, err)): unit
  gives (exists(value: ok) . out == Result.Result_Ok(value)) or
    (exists(error: err) . out == Result.Result_Err(error))
{ match out { Result.Result_Ok(_) => (), Result.Result_Err(_) => () } }

// This is the source boundary for edit, using contracts for its callees.
// The counter helpers and plan are withheld here; the latter exposes only
// result constructors. Frontier contributes only generic Result constructors.
// Keep automatic solver unfolding shallow; no implementation reduction list.
proof authored_edit_advances_once(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives edit_counter_step(before, Native.impl_Replica__edit(before, gap, insert, delete))
{
  counter_result_is_exact(before.f_next_counter);
  result_has_constructor(Native.frontier(Alloc.Vec.impl_1__as_slice(before.f_facts)));
  assert(edit_counter_step(before, Native.impl_Replica__edit(before, gap, insert, delete))) by {
    Tactics.prune("Nickel_crdt.Edit.frontier");
    Tactics.prune("Nickel_crdt.Event_layer.frontier");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__with_counter");
    Tactics.prune("Nickel_crdt.Edit.next_counter_after");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__plan");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.smt_sync'(1, 1)
  }
}

// Constructor-owned storage fact; callers need not inspect the constructor.
function constructed_empty(result: Result.t_Result(Native.t_Replica, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(state) => Alloc.Vec.impl_1__as_slice(state.f_facts) == FStar.Seq.empty, _ => Prims.l_True }
}
proof new_has_empty_facts(writer: Option.t_Option(Native.t_Writer)): unit
  gives constructed_empty(Native.impl_Replica__new(writer))
{
  Nickel.Vector.empty_vector_contents<#Native.t_Fact>();
  assert(constructed_empty(Native.impl_Replica__new(writer))) by {
    Tactics.prune("Alloc.Vec.impl__new");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.smt_sync'(1, 1)
  }
}
