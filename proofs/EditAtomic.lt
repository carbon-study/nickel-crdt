import Rust_primitives
import Core_models
import FStar.Pervasives
import Tactics = FStar.Tactics.V2
import Native = Nickel_crdt.Edit
import Result = Core_models.Result

function receive_neutral(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Err(_)) => next == before,
    (next, Result.Result_Ok(Native.Admission_Duplicate)) => next == before,
    _ => Prims.l_True
  }
}
proof receive_rejection_unchanged(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives receive_neutral(before, Native.impl_Replica__receive(before, fact))
{ () }

function edit_neutral(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (_, Result.Result_Ok(Native.Local_Authored(_))) => Prims.l_True,
    (next, _) => next == before
  }
}
proof edit_rejection_or_empty_unchanged(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives edit_neutral(before, Native.impl_Replica__edit(before, gap, insert, delete))
{ () }

function edit_counter_step(before: Native.t_Replica, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) =>
      v(next.f_next_counter) == v(before.f_next_counter) + 1 and
      fact.f_id.f_counter == before.f_next_counter,
    _ => Prims.l_True
  }
}
// Check the actual pure allocation step without replay/admission in its context.
// The public theorem below still covers the complete edit call.
function counter_result_step(counter: u64, result: Result.t_Result(u64, Native.t_Error)): Type0 {
  match result {
    Result.Result_Ok(next) => v(counter) <= v(Native.v_MAX_COUNTER) and v(next) == v(counter) + 1,
    Result.Result_Err(error) => v(counter) > v(Native.v_MAX_COUNTER) and error == Native.Error_Capacity(Native.Capacity_Counter)
  }
}
proof counter_result_advances_once(counter: u64): unit
  gives counter_result_step(counter, Native.next_counter_after(counter))
  hint Native.next_counter_after(counter)
{ () }
// Check the actual state installation, separately from calculating a successor.
proof counter_installation_is_exact(state: Native.t_Replica, counter: u64): unit
  gives Native.impl_Replica__with_counter(state, counter).f_next_counter == counter and
    Native.impl_Replica__with_counter(state, counter).f_writer == state.f_writer and
    Native.impl_Replica__with_counter(state, counter).f_limits == state.f_limits and
    Native.impl_Replica__with_counter(state, counter).f_facts == state.f_facts and
    Native.impl_Replica__with_counter(state, counter).f_tree == state.f_tree
  hint Native.impl_Replica__with_counter(state, counter)
{ () }
// Give callers the complete result, including its constructor. The weaker
// predicate above alone does not replace the pruned function's typing facts.
function counter_outcome(counter: u64): Result.t_Result(u64, Native.t_Error) {
  if v(counter) > v(Native.v_MAX_COUNTER) {
    Result.Result_Err(Native.Error_Capacity(Native.Capacity_Counter))
  } else { Result.Result_Ok(counter +! mk_u64(1)) }
}
proof counter_result_is_exact(counter: u64): unit
  gives Native.next_counter_after(counter) == counter_outcome(counter)
{ () }

// This is the source boundary for edit, using contracts for its callees.
// Only next_counter_after/with_counter facts are withheld here, including typing.
// Keep automatic solver unfolding shallow; no implementation reduction list.
proof authored_edit_advances_once(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives edit_counter_step(before, Native.impl_Replica__edit(before, gap, insert, delete))
{
  counter_result_is_exact(before.f_next_counter);
  assert(edit_counter_step(before, Native.impl_Replica__edit(before, gap, insert, delete))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__with_counter");
    Tactics.prune("Nickel_crdt.Edit.next_counter_after");
    Tactics.smt_sync'(1, 1)
  }
}
