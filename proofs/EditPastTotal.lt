import Nickel.EventGraphText
import Rust_primitives
import Core_models
import FStar.Pervasives
import FStar.Classical
import Nickel.Vector
import Nickel.LoopUtil
import Nickel.EditAccepted
import Nickel.EditCausal
import List = FStar.List.Tot
import Native = Nickel_crdt.Edit
import Result = Core_models.Result
import Seq = FStar.Seq

import Nickel.EditPast
import FStar.Fin

// Appending a missing stored ID leaves room even at maximum history length.
import Nickel.EditWellFormed
// The capacity proof counts whole facts; the existing guard uses ID absence.
proof stored_id_presence_agrees(facts: facts_vec, id: Native.t_EventId): unit
  gives fact_id_present(facts, id) <==> Nickel.EditWellFormed.event_present(Alloc.Vec.impl_1__as_slice(facts), id)
  hint fact_id_present(facts, id)
{
  Nickel.EditWellFormed.absence_on_whole_facts(Alloc.Vec.impl_1__as_slice(facts), id);
  ()
}
proof stored_roots_are_present(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes all_ids(roots, fact_id_present(facts))
  gives Nickel.EditWellFormed.dependencies_present(Alloc.Vec.impl_1__as_slice(facts), roots)
{ () }
function unique_selection(ids: Seq.seq(Native.t_EventId)): Type0 {
  forall(i: FStar.Fin.under(Seq.length(ids)), j: FStar.Fin.under(Seq.length(ids))) . i < j ==> not (Seq.index(ids, i) == Seq.index(ids, j))
}
proof unique_positions_differ(ids: Seq.seq(Native.t_EventId), i: nat where i < Seq.length(ids), j: nat where i < j and j < Seq.length(ids)): unit
  takes unique_selection(ids)
  gives not (Seq.index(ids, i) == Seq.index(ids, j))
{ () }
// Positive domain witnesses catch accidentally impossible uniqueness predicates.
proof empty_and_singleton_roots_are_unique(id: Native.t_EventId): unit
  gives unique_selection(Seq.empty) and unique_selection(Seq.create(1, id))
{ () }
function stored_selection(facts: facts_vec, selected: ids_vec): Type0 {
  unique_selection(Alloc.Vec.impl_1__as_slice(selected)) and
  all_ids(Alloc.Vec.impl_1__as_slice(selected), fact_id_present(facts))
}
function selected_fact_position(facts: facts_vec, ids: t_Slice(Native.t_EventId) where
  all_ids(ids, fact_id_present(facts)), at: nat where at < Seq.length(ids)): position: FStar.Fin.under(Seq.length(Alloc.Vec.impl_1__as_slice(facts))) where
  Seq.index(Alloc.Vec.impl_1__as_slice(facts), position).f_id == Seq.index(ids, at)
{
  assert(fact_id_present(facts, Rust_primitives.Slice.slice_index(ids, mk_usize(at))));
  assert(fact_id_present(facts, Seq.index(ids, at)));
  parent_fact_position(facts, Seq.index(ids, at))
}
// If one stored ID is still absent, the unique selection is strictly shorter.
function missing_position(facts: facts_vec, selected: ids_vec where stored_selection(facts, selected), id: Native.t_EventId where fact_id_present(facts, id),
  at: nat where at <= Seq.length(Alloc.Vec.impl_1__as_slice(selected))): position: FStar.Fin.under(Seq.length(Alloc.Vec.impl_1__as_slice(facts))) where
  Seq.index(Alloc.Vec.impl_1__as_slice(facts), position).f_id ==
    (if at ==? Seq.length(Alloc.Vec.impl_1__as_slice(selected)) { id } else { Seq.index(Alloc.Vec.impl_1__as_slice(selected), at) })
{
  if at ==? Seq.length(Alloc.Vec.impl_1__as_slice(selected)) { parent_fact_position(facts, id) }
  else { selected_fact_position(facts, Alloc.Vec.impl_1__as_slice(selected), at) }
}
proof missing_stored_id_leaves_room(facts: facts_vec, selected: ids_vec, id: Native.t_EventId): unit
  takes stored_selection(facts, selected)
  takes fact_id_present(facts, id)
  takes not member(Alloc.Vec.impl_1__as_slice(selected), id)
  gives Seq.length(Alloc.Vec.impl_1__as_slice(selected)) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
{
  const ids = Alloc.Vec.impl_1__as_slice(selected);
  const count = Seq.length(ids);
  assert(unique_selection(ids));
  assert(absent_prefix(ids, id, count));
  if count < Seq.length(Alloc.Vec.impl_1__as_slice(facts)) { () } else {
    if count ==? 0 {
      const position = parent_fact_position(facts, id);
      assert(position < count)
    } else {
      const position = ((at: nat where at <= count) => (missing_position(facts, selected, id, at) : FStar.Fin.under(count)));
      const positions = Seq.init(count + 1, position);
      Seq.lemma_init_len(count + 1, position);
      Seq.init_index(count + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j and j <= count);
          assert(position(i) == position(j));
          if j ==? count {
            assert(Seq.index(ids, i) == id);
            assert(Seq.index(ids, v(mk_usize(i))) == id);
            assert(not (Seq.index(ids, v(mk_usize(i))) == id))
          } else {
            assert(j < count);
            assert(Seq.index(ids, i) == Seq.index(ids, j));
            unique_positions_differ(ids, i, j);
            assert(not (Seq.index(ids, i) == Seq.index(ids, j)));
            assert(i == j)
          }
        }
      }
    }
  }
}
function stored_result(facts: facts_vec, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(selected) => stored_selection(facts, selected), _ => Prims.l_False }
}
function stored_push_result(facts: facts_vec, result: (ids_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match result { (selected, Result.Result_Ok(_)) => stored_selection(facts, selected), _ => Prims.l_False }
}
proof fresh_append_is_unique(before: t_Slice(Native.t_EventId), id: Native.t_EventId): unit
  takes unique_selection(before)
  takes not member(before, id)
  gives unique_selection(Seq.append(before, Seq.create(1, id)))
{
  const next = Seq.append(before, Seq.create(1, id));
  assert(absent_prefix(before, id, Seq.length(before)));
  proof pair(i: FStar.Fin.under(Seq.length(next)), j: FStar.Fin.under(Seq.length(next))): unit
    gives i < j ==> not (Seq.index(next, i) == Seq.index(next, j))
  {
    if i < j {
      if j < Seq.length(before) {
        unique_positions_differ(before, i, j);
        assert(Seq.index(next, i) == Seq.index(before, i));
        assert(Seq.index(next, j) == Seq.index(before, j))
      } else {
        assert(j == Seq.length(before));
        assert(i < Seq.length(before));
        assert(not (Seq.index(before, v(mk_usize(i))) == id));
        assert(Seq.index(next, i) == Seq.index(before, i));
        assert(Seq.index(next, j) == id)
      };
      assert(not (Seq.index(next, i) == Seq.index(next, j)))
    } else { () }
  };
  FStar.Classical.forall_intro_2<
    #FStar.Fin.under(Seq.length(next)),
    #((_: FStar.Fin.under(Seq.length(next))) => FStar.Fin.under(Seq.length(next))),
    #((i: FStar.Fin.under(Seq.length(next)), j: FStar.Fin.under(Seq.length(next))) => i < j ==> not (Seq.index(next, i) == Seq.index(next, j)))>(pair);
  assert(unique_selection(next))
}
// Make the nonempty pair domain visible without an additional policy premise.
proof distinct_pair_roots_are_unique(a: Native.t_EventId, b: Native.t_EventId): unit
  takes not (a == b)
  gives unique_selection(Seq.append(Seq.create(1, a), Seq.create(1, b)))
{
  empty_and_singleton_roots_are_unique(a);
  assert(not member(Seq.create(1, a), b));
  fresh_append_is_unique(Seq.create(1, a), b)
}
proof fresh_stored_push_succeeds(facts: facts_vec, selected: ids_vec, id: Native.t_EventId): unit
  takes stored_selection(facts, selected)
  takes fact_id_present(facts, id)
  takes not member(Alloc.Vec.impl_1__as_slice(selected), id)
  gives stored_push_result(facts, Native.push(selected, id))
{
  missing_stored_id_leaves_room(facts, selected, id);
  fresh_append_is_unique(Alloc.Vec.impl_1__as_slice(selected), id);
  selected_push_preserves(Seq.empty, fact_id_present(facts), selected, id);
  push_result_is_exact(selected, id);
  assert(stored_push_result(facts, Native.push(selected, id))) by {
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
proof extend_stored_selection_succeeds(facts: facts_vec, fact: Native.t_Fact, before: ids_vec): unit
  takes stored_selection(facts, before)
  takes all_ids(Alloc.Vec.impl_1__as_slice(fact.f_after), fact_id_present(facts))
  gives stored_result(facts, Native.extend_past(fact, before))
{
  proof each_push(selected: ids_vec, id: Native.t_EventId): unit
    takes stored_selection(facts, selected)
    takes fact_id_present(facts, id)
    takes not member(Alloc.Vec.impl_1__as_slice(selected), id)
    gives stored_push_result(facts, Native.push(selected, id))
  {
    fresh_stored_push_succeeds(facts, selected, id);
    assert(stored_push_result(facts, Native.push(selected, id))) by {
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_push));
  proof membership_boolean(ids: t_Slice(Native.t_EventId), id: Native.t_EventId): unit
    gives Native.has_event(ids, id) == true or Native.has_event(ids, id) == false
    hint Native.has_event(ids, id)
  { () };
  if Native.has_event(Alloc.Vec.impl_1__as_slice(before), fact.f_id) {
    Nickel.LoopUtil.result_preserve_any(mk_usize(0), Alloc.Vec.impl_1__len(fact.f_after),
      ((_: nat, selected: ids_vec) => stored_selection(facts, selected)),
      ((selected: ids_vec) => selected), stored_selection(facts), ((_: Native.t_Error) => Prims.l_False));
    assert(stored_result(facts, Native.extend_past(fact, before))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel.LoopUtil.step_safe");
      Tactics.prune("Nickel.LoopUtil.output_safe");
      Tactics.prune("Nickel_crdt.Edit.has_event");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  } else {
    assert(stored_result(facts, Native.extend_past(fact, before))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Edit.has_event");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  }
}
function history_references_present(facts: facts_vec): Type0 {
  forall(i: nat where i < Seq.length(Alloc.Vec.impl_1__as_slice(facts))) .
    all_ids(Alloc.Vec.impl_1__as_slice(Seq.index(Alloc.Vec.impl_1__as_slice(facts), i).f_after), fact_id_present(facts))
}
proof stored_pass_succeeds(facts: facts_vec, before: ids_vec): unit
  takes history_references_present(facts)
  takes stored_selection(facts, before)
  gives stored_result(facts, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), before))
{
  proof each_extend(selected: ids_vec, i: usize where v(i) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))): unit
    takes stored_selection(facts, selected)
    gives stored_result(facts, Native.extend_past(Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)), selected))
  {
    extend_stored_selection_succeeds(facts, Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)), selected);
    assert(stored_result(facts, Native.extend_past(Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)), selected))) by {
      Tactics.prune("Nickel_crdt.Edit.extend_past");
      Tactics.prune("Nickel_crdt.Event_layer.extend_past");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_extend));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Alloc.Vec.impl_1__len(facts),
    ((_: nat, selected: ids_vec) => stored_selection(facts, selected)),
    ((selected: ids_vec) => selected), stored_selection(facts), ((_: Native.t_Error) => Prims.l_False));
  assert(stored_result(facts, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), before))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Nickel_crdt.Edit.extend_past");
    Tactics.prune("Nickel_crdt.Event_layer.extend_past");
    Tactics.smt_sync'(1, 1)
  }
}
proof fitting_closed_history_computes_past(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes history_references_present(facts)
  takes unique_selection(roots)
  takes all_ids(roots, fact_id_present(facts))
  gives stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  stored_roots_are_present(facts, roots);
  Nickel.EditWellFormed.present_dependencies_pass_guard(Alloc.Vec.impl_1__as_slice(facts), roots);
  assert(stored_selection(facts, Alloc.Slice.impl__to_vec(roots)));
  proof each_pass(selected: ids_vec): unit
    takes stored_selection(facts, selected)
    gives stored_result(facts, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected))
  {
    stored_pass_succeeds(facts, selected);
    assert(stored_result(facts, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected))) by {
      Tactics.prune("Nickel_crdt.Edit.past_pass");
      Tactics.prune("Nickel_crdt.Event_layer.past_pass");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_pass));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Alloc.Vec.impl_1__len(facts),
    ((_: nat, selected: ids_vec) => stored_selection(facts, selected)),
    ((selected: ids_vec) => selected), stored_selection(facts), ((_: Native.t_Error) => Prims.l_False));
  assert(stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Nickel_crdt.Edit.past_pass");
    Tactics.prune("Nickel_crdt.Event_layer.past_pass");
    Tactics.prune("Nickel_crdt.Edit.validate_after");
    Tactics.prune("Nickel_crdt.Event_layer.validate_after");
    Tactics.smt_sync'(1, 1)
  }
}
proof fitting_past_is_total_and_exact(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes history_references_present(facts)
  takes unique_selection(roots)
  takes all_ids(roots, fact_id_present(facts))
  gives stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots)) and
    exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  fitting_closed_history_computes_past(facts, roots);
  successful_past_is_exact_closure(facts, roots);
  assert(stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots)) and
    exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.smt_sync'(1, 1)
  }
}
// Use the already established public-state causal-closure component directly.
proof causally_closed_history_computes_exact_past(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes Nickel.EditWellFormed.facts_causally_closed(facts)
  takes Nickel.EditWellFormed.dependencies_present(Alloc.Vec.impl_1__as_slice(facts), roots)
  takes unique_selection(roots)
  gives stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots)) and
    exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  assert(history_references_present(facts));
  assert(all_ids(roots, fact_id_present(facts)));
  fitting_past_is_total_and_exact(facts, roots);
  assert(stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots)) and
    exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.smt_sync'(1, 1)
  }
}

// Public validation's duplicate scan agrees exactly with root uniqueness.
function earlier_differs(ids: t_Slice(Native.t_EventId), row: nat where row < Seq.length(ids), finish: nat): Type0 {
  forall(j: FStar.Fin.under(Seq.length(ids))) . j < finish ==> not (Seq.index(ids, row) == Seq.index(ids, j))
}
function rows_differ(ids: t_Slice(Native.t_EventId), finish: nat): Type0 {
  forall(i: FStar.Fin.under(Seq.length(ids))) . i < finish ==> earlier_differs(ids, i, i)
}
function scan_found(ids: t_Slice(Native.t_EventId), found: bool): Type0 {
  found == true and not unique_selection(ids)
}
proof duplicate_scan_is_exact(ids: t_Slice(Native.t_EventId)): unit
  gives Native.duplicate_events(ids) == false <==> unique_selection(ids)
{
  proof each_row(i: usize where v(i) < Seq.length(ids)): unit
    gives forall(inv: Nickel.LoopUtil.invariant(unit, mk_usize(0), i), value: unit, f: Nickel.LoopUtil.callback(unit, bool, mk_usize(0), i)) .
      (earlier_differs(ids, v(i), 0) and
       (forall(s: unit, j: Nickel.LoopUtil.position(mk_usize(0), i)) . earlier_differs(ids, v(i), v(j)) ==>
         Nickel.LoopUtil.step_safe(((at: nat, _: unit) => earlier_differs(ids, v(i), at)), ((_: unit) => earlier_differs(ids, v(i), v(i))), scan_found(ids), v(j), f(s, j))) and
       (forall(s: unit) . earlier_differs(ids, v(i), v(i)) ==> earlier_differs(ids, v(i), v(i)))) ==>
        Nickel.LoopUtil.output_safe(((_: unit) => earlier_differs(ids, v(i), v(i))), scan_found(ids), Rust_primitives.Hax.Folds.fold_range_return(mk_usize(0), i, inv, value, f))
  {
    Nickel.LoopUtil.preserve_any(mk_usize(0), i, ((at: nat, _: unit) => earlier_differs(ids, v(i), at)),
      ((_: unit) => earlier_differs(ids, v(i), v(i))), scan_found(ids))
  };
  FStar.Classical.forall_intro(each_row);
  Nickel.LoopUtil.preserve_any(mk_usize(0), Core_models.Slice.impl__len(ids), ((at: nat, _: unit) => rows_differ(ids, at)),
    ((_: unit) => rows_differ(ids, Seq.length(ids))), scan_found(ids));
  assert(Native.duplicate_events(ids) == false <==> unique_selection(ids)) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.smt_sync'(1, 1)
  }
}
// The public scan supplies #76's uniqueness premise; the scan body stays withheld.
proof scanned_roots_compute_exact_past(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes history_references_present(facts)
  takes Native.duplicate_events(roots) == false
  takes all_ids(roots, fact_id_present(facts))
  gives stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots)) and
    exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  duplicate_scan_is_exact(roots);
  fitting_past_is_total_and_exact(facts, roots);
  assert(stored_result(facts, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots)) and
    exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
    Tactics.prune("Nickel_crdt.Edit.duplicate_events");
    Tactics.prune("Nickel_crdt.Event_layer.duplicate_ids");
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.smt_sync'(1, 1)
  }
}

// Two receivers select the same past IDs for the same roots. This is the
// selected-ID part of author reconstruction only: equal selected sets do not
// establish equal interpreted placements, which remain a separate obligation.
function same_parents(into: facts_vec, other: facts_vec, id: Native.t_EventId): Type0 {
  forall(older: Native.t_EventId) . Nickel.EditCausal.causal_edge(into, id, older) <==> Nickel.EditCausal.causal_edge(other, id, older)
}
function shared_ancestry(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId)): Type0 {
  forall(id: Native.t_EventId) . ancestor(into, roots, id) ==> same_parents(into, other, id)
}
proof! shared_path_stays_shared(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId), start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId): unit
  decreases steps
  takes shared_ancestry(into, other, roots)
  takes ancestor(into, roots, start)
  takes ancestor(other, roots, start)
  takes Nickel.EditCausal.causal_path(into, start, steps, finish) or Nickel.EditCausal.causal_path(other, start, steps, finish)
  gives ancestor(into, roots, finish) and ancestor(other, roots, finish)
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => {
      assert(Nickel.EditCausal.causal_edge(into, start, next) and Nickel.EditCausal.causal_edge(other, start, next)) by {
        Tactics.prune("Nickel.EditPast.ancestor");
        Tactics.smt_sync'(1, 1)
      };
      ancestor_follows_edge(into, roots, start, next);
      ancestor_follows_edge(other, roots, start, next);
      assert(ancestor(into, roots, next) and ancestor(other, roots, next) and
        (Nickel.EditCausal.causal_path(into, next, rest, finish) or Nickel.EditCausal.causal_path(other, next, rest, finish))) by {
        Tactics.prune("Nickel.EditPast.ancestor");
        Tactics.prune("Nickel.EditPastTotal.shared_ancestry");
        Tactics.smt_sync'(1, 1)
      };
      shared_path_stays_shared(into, other, roots, next, rest, finish);
      assert(ancestor(into, roots, finish) and ancestor(other, roots, finish)) by {
        Tactics.prune("Nickel.EditPast.ancestor");
        Tactics.prune("Nickel.EditPastTotal.shared_ancestry");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
proof shared_ancestry_agrees(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes shared_ancestry(into, other, roots)
  gives forall(id: Native.t_EventId) . ancestor(into, roots, id) <==> ancestor(other, roots, id)
{
  proof each_path(root: Native.t_EventId, steps: Prims.list(Native.t_EventId), id: Native.t_EventId): unit
    takes member(roots, root)
    takes Nickel.EditCausal.causal_path(into, root, steps, id) or Nickel.EditCausal.causal_path(other, root, steps, id)
    gives ancestor(into, roots, id) and ancestor(other, roots, id)
  {
    assert(Nickel.EditCausal.causal_path(into, root, Prims.Nil, root));
    assert(Nickel.EditCausal.causal_path(other, root, Prims.Nil, root));
    shared_path_stays_shared(into, other, roots, root, steps, id);
    assert(ancestor(into, roots, id) and ancestor(other, roots, id)) by {
      Tactics.prune("Nickel.EditPast.ancestor");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_3(FStar.Classical.move_requires_3(each_path))
}
// Receiver-facing premise: every fact in into's past of roots is also stored in other.
function shared_past_facts(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId)): Type0 {
  forall(fact: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(into), fact) and ancestor(into, roots, fact.f_id) ==>
    fact_present(Alloc.Vec.impl_1__as_slice(other), fact)
}
proof! path_end_is_present(facts: facts_vec, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId): unit
  decreases steps
  takes history_references_present(facts)
  takes fact_id_present(facts, start)
  takes Nickel.EditCausal.causal_path(facts, start, steps, finish)
  gives fact_id_present(facts, finish)
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => {
      assert(fact_id_present(facts, next));
      path_end_is_present(facts, next, rest, finish);
      assert(fact_id_present(facts, finish)) by {
        Tactics.prune("Nickel.EditPast.fact_id_present");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
proof ancestor_is_present(facts: facts_vec, roots: t_Slice(Native.t_EventId), id: Native.t_EventId): unit
  takes history_references_present(facts)
  takes all_ids(roots, fact_id_present(facts))
  takes ancestor(facts, roots, id)
  gives fact_id_present(facts, id)
{
  proof each_path(root: Native.t_EventId, steps: Prims.list(Native.t_EventId)): unit
    takes member(roots, root)
    takes Nickel.EditCausal.causal_path(facts, root, steps, id)
    gives fact_id_present(facts, id)
  {
    path_end_is_present(facts, root, steps, id);
    assert(fact_id_present(facts, id)) by {
      Tactics.prune("Nickel.EditPast.fact_id_present");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_path))
}
proof unique_present_facts_agree(facts: facts_vec, left: Native.t_Fact, right: Native.t_Fact): unit
  takes ids_unique(facts)
  takes fact_present(Alloc.Vec.impl_1__as_slice(facts), left)
  takes fact_present(Alloc.Vec.impl_1__as_slice(facts), right)
  takes left.f_id == right.f_id
  gives left == right
{
  proof each(i: nat, j: nat): unit
    takes i < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
    takes j < Seq.length(Alloc.Vec.impl_1__as_slice(facts))
    takes Seq.index(Alloc.Vec.impl_1__as_slice(facts), i) == left
    takes Seq.index(Alloc.Vec.impl_1__as_slice(facts), j) == right
    gives left == right
  { unique_slice_nat_positions(Alloc.Vec.impl_1__as_slice(facts), i, j) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each))
}
// Whole-fact agreement on into's past, with unique IDs in other, gives the edge premise.
proof whole_facts_give_shared_ancestry(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes history_references_present(into)
  takes all_ids(roots, fact_id_present(into))
  takes ids_unique(other)
  takes shared_past_facts(into, other, roots)
  gives shared_ancestry(into, other, roots)
{
  proof each(id: Native.t_EventId, older: Native.t_EventId): unit
    takes ancestor(into, roots, id)
    gives Nickel.EditCausal.causal_edge(into, id, older) <==> Nickel.EditCausal.causal_edge(other, id, older)
  {
    ancestor_is_present(into, roots, id);
    assert(fact_id_present(into, id)) by {
      Tactics.prune("Nickel.EditPast.fact_id_present");
      Tactics.smt_sync'(1, 1)
    };
    proof backward(fact: Native.t_Fact, stored: Native.t_Fact): unit
      takes fact_present(Alloc.Vec.impl_1__as_slice(other), fact)
      takes fact.f_id == id
      takes fact_present(Alloc.Vec.impl_1__as_slice(into), stored)
      takes stored.f_id == id
      gives fact == stored
    { unique_present_facts_agree(other, fact, stored) };
    FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(backward))
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each))
}
function same_members(left: Result.t_Result(ids_vec, Native.t_Error), right: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match (left, right) {
    (Result.Result_Ok(l), Result.Result_Ok(r)) => forall(id: Native.t_EventId) . member(Alloc.Vec.impl_1__as_slice(l), id) <==> member(Alloc.Vec.impl_1__as_slice(r), id),
    _ => Prims.l_True
  }
}
function both_ok(left: Result.t_Result(ids_vec, Native.t_Error), right: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match (left, right) {
    (Result.Result_Ok(_), Result.Result_Ok(_)) => Prims.l_True,
    _ => Prims.l_False
  }
}
proof shared_ancestry_selects_same_past(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes shared_ancestry(into, other, roots)
  gives same_members(Native.past(Alloc.Vec.impl_1__as_slice(into), roots), Native.past(Alloc.Vec.impl_1__as_slice(other), roots))
{
  successful_past_is_exact_closure(into, roots);
  successful_past_is_exact_closure(other, roots);
  shared_ancestry_agrees(into, other, roots);
  assert(exact_past_result(into, roots, Native.past(Alloc.Vec.impl_1__as_slice(into), roots)) and
    exact_past_result(other, roots, Native.past(Alloc.Vec.impl_1__as_slice(other), roots)) and
    (forall(id: Native.t_EventId) . ancestor(into, roots, id) <==> ancestor(other, roots, id))) by {
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.prune("Nickel.EditPast.exact_past_result");
    Tactics.prune("Nickel.EditPast.ancestor");
    Tactics.smt_sync'(1, 1)
  }
}
// Selected-ID agreement only: interpreted placement equality remains a separate obligation.
proof two_closed_receivers_select_same_past(into: facts_vec, other: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  takes Nickel.EditWellFormed.facts_causally_closed(into)
  takes Nickel.EditWellFormed.facts_causally_closed(other)
  takes Nickel.EditWellFormed.dependencies_present(Alloc.Vec.impl_1__as_slice(into), roots)
  takes Nickel.EditWellFormed.dependencies_present(Alloc.Vec.impl_1__as_slice(other), roots)
  takes unique_selection(roots)
  takes ids_unique(other)
  takes shared_past_facts(into, other, roots)
  gives both_ok(Native.past(Alloc.Vec.impl_1__as_slice(into), roots), Native.past(Alloc.Vec.impl_1__as_slice(other), roots)) and
    same_members(Native.past(Alloc.Vec.impl_1__as_slice(into), roots), Native.past(Alloc.Vec.impl_1__as_slice(other), roots))
{
  assert(history_references_present(into));
  assert(all_ids(roots, fact_id_present(into)));
  whole_facts_give_shared_ancestry(into, other, roots);
  assert(shared_ancestry(into, other, roots)) by {
    Tactics.prune("Nickel.EditPastTotal.shared_ancestry");
    Tactics.smt_sync'(1, 1)
  };
  causally_closed_history_computes_exact_past(into, roots);
  causally_closed_history_computes_exact_past(other, roots);
  shared_ancestry_selects_same_past(into, other, roots);
  assert(both_ok(Native.past(Alloc.Vec.impl_1__as_slice(into), roots), Native.past(Alloc.Vec.impl_1__as_slice(other), roots)) and
    same_members(Native.past(Alloc.Vec.impl_1__as_slice(into), roots), Native.past(Alloc.Vec.impl_1__as_slice(other), roots))) by {
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.prune("Nickel.EditPastTotal.same_members");
    Tactics.smt_sync'(1, 1)
  }
}
