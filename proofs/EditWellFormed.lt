}
function validation_has_dependencies(facts: t_Slice(Native.t_Fact), fact: Native.t_Fact, result: Result.t_Result(unit, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => fact_dependencies_present(facts, fact), _ => Prims.l_True }
}
proof successful_validation_has_direct_dependencies(facts: t_Slice(Native.t_Fact), limits: Native.t_Limits, fact: Native.t_Fact): unit
  gives validation_has_dependencies(facts, fact, Native.impl_Replica__validate_new(facts, limits, fact))
{
  Nickel.EventGraphText.text_graph_policy_is_exact();
  Nickel.EventGraphText.text_graph_callbacks_are_exact();
  // past is checked before the counting loops; their bodies are irrelevant here.
  successful_past_has_direct_dependencies(facts, Alloc.Vec.impl_1__as_slice(fact.f_after));
  assert(validation_has_dependencies(facts, fact, Native.impl_Replica__validate_new(facts, limits, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.smt_sync'(1, 1)
  }
}
function added_dependencies(before: Native.t_Replica, fact: Native.t_Fact, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (_, Result.Result_Ok(Native.Admission_Added)) => fact_dependencies_present(Alloc.Vec.impl_1__as_slice(before.f_facts), fact), _ => Prims.l_True }
}
proof receive_added_has_direct_dependencies(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives added_dependencies(before, fact, Native.impl_Replica__receive(before, fact))
{
  successful_validation_has_direct_dependencies(Alloc.Vec.impl_1__as_slice(before.f_facts), before.f_limits, fact);
  Nickel.EditAtomic.successful_plan_requires_validation(before, fact);
  Nickel.EditCommit.receive_uses_plan(before, fact);
  assert(added_dependencies(before, fact, Native.impl_Replica__receive(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__validate_new");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__plan");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function facts_contained(before: t_Slice(Native.t_Fact), next: t_Slice(Native.t_Fact)): Type0 {
  forall(fact: Native.t_Fact) . fact_present(before, fact) ==> fact_present(next, fact)
}
proof absence_on_whole_facts(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  gives (Nickel.EditIdentity.prefix_absent(facts, id, mk_usize(0), Nickel.EditIdentity.length(facts)) <==>
    (forall(fact: Native.t_Fact) . fact_present(facts, fact) ==> not (fact.f_id == id)))
{
  membership_absence_exact(facts, id);
  proof forward(fact: Native.t_Fact): unit
    takes Nickel.EditIdentity.prefix_absent(facts, id, mk_usize(0), Nickel.EditIdentity.length(facts))
    takes fact_present(facts, fact)
    gives not (fact.f_id == id)
  {
    const i = find_fact_position(facts, fact);
    Nickel.Vector.slice_index(facts, mk_usize(i));
    Nickel.Vector.slice_length(facts);
    assert(not (fact.f_id == id)) by {
      Tactics.prune("Nickel.Vector.slice_index");
      Tactics.prune("Nickel.Vector.slice_length");
      Tactics.prune("Rust_primitives.Slice.slice_index");
      Tactics.prune("Core_models.Slice.impl__len");
      Tactics.prune("Alloc.Vec.from_seq");
      Tactics.prune("Alloc.Vec.impl_1__as_slice");
      Tactics.prune("Alloc.Vec.impl_1__len");
      Tactics.smt_sync'(1, 1)
    }
  };
  proof reverse(dummy: unit): unit
    takes forall(fact: Native.t_Fact) . fact_present(facts, fact) ==> not (fact.f_id == id)
    gives Nickel.EditIdentity.prefix_absent(facts, id, mk_usize(0), Nickel.EditIdentity.length(facts))
  {
    if Native.has_fact(facts, id) {
      const i = find_id_position(facts, id);
      assert(fact_present(facts, Seq.index(facts, i)));
      assert(Prims.l_False)
    } else { () }
  };
  proof all_forward(fact: Native.t_Fact): unit
    gives (Nickel.EditIdentity.prefix_absent(facts, id, mk_usize(0), Nickel.EditIdentity.length(facts)) and fact_present(facts, fact)) ==> not (fact.f_id == id)
  { FStar.Classical.move_requires(forward, fact) };
  FStar.Classical.forall_intro(all_forward);
  FStar.Classical.move_requires(reverse, ())
}
proof presence_survives_containment(before: t_Slice(Native.t_Fact), next: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  takes facts_contained(before, next)
  takes event_present(before, id)
  gives event_present(next, id)
{
  event_membership_is_presence(before, id);
  const i = find_id_position(before, id);
  const witness = Seq.index(before, i);
  assert(fact_present(before, witness));
  assert(fact_present(next, witness));
  absence_on_whole_facts(next, id);
  assert(event_present(next, id)) by {
    Tactics.prune("Nickel.EditIdentity.prefix_absent");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
proof dependencies_survive_containment(before: t_Slice(Native.t_Fact), next: t_Slice(Native.t_Fact), fact: Native.t_Fact): unit
  takes facts_contained(before, next)
  takes fact_dependencies_present(before, fact)
  gives fact_dependencies_present(next, fact)
{
  proof each_id(id: Native.t_EventId): unit
    takes event_present(before, id)
    gives event_present(next, id)
  { presence_survives_containment(before, next, id) };
  proof all_id(id: Native.t_EventId): unit gives event_present(before, id) ==> event_present(next, id)
  { FStar.Classical.move_requires(each_id, id) };
  FStar.Classical.forall_intro(all_id)
}
function facts_causally_closed(facts: facts_vec): Type0 {
  forall(fact: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(facts), fact) ==> fact_dependencies_present(Alloc.Vec.impl_1__as_slice(facts), fact)
}
proof exact_extension_preserves_causal_closure(before: facts_vec, fact: Native.t_Fact, next: facts_vec): unit
  takes facts_causally_closed(before)
  takes fact_dependencies_present(Alloc.Vec.impl_1__as_slice(before), fact)
  takes appended_contents(before, fact, next)
  gives facts_causally_closed(next)
{
  assert(facts_contained(Alloc.Vec.impl_1__as_slice(before), Alloc.Vec.impl_1__as_slice(next)));
  proof each_fact(item: Native.t_Fact): unit
    takes fact_present(Alloc.Vec.impl_1__as_slice(next), item)
    gives fact_dependencies_present(Alloc.Vec.impl_1__as_slice(next), item)
  {
    assert(fact_dependencies_present(Alloc.Vec.impl_1__as_slice(before), item));
    dependencies_survive_containment(Alloc.Vec.impl_1__as_slice(before), Alloc.Vec.impl_1__as_slice(next), item)
  };
  proof all_fact(item: Native.t_Fact): unit
    gives fact_present(Alloc.Vec.impl_1__as_slice(next), item) ==> fact_dependencies_present(Alloc.Vec.impl_1__as_slice(next), item)
  { FStar.Classical.move_requires(each_fact, item) };
  FStar.Classical.forall_intro(all_fact)
}
function receive_causally_closed(outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (next, _) => facts_causally_closed(next.f_facts) }
}
proof receive_preserves_causal_closure(before: Native.t_Replica, fact: Native.t_Fact): unit
  takes facts_causally_closed(before.f_facts)
  gives receive_causally_closed(Native.impl_Replica__receive(before, fact))
{
  Nickel.EditAtomic.receive_rejection_unchanged(before, fact);
  receive_added_has_exact_contents(before, fact);
  receive_added_has_direct_dependencies(before, fact);
  match Native.impl_Replica__receive(before, fact) {
    (next, Result.Result_Ok(Native.Admission_Added)) => exact_extension_preserves_causal_closure(before.f_facts, fact, next.f_facts),
    _ => ()
  };
  assert(receive_causally_closed(Native.impl_Replica__receive(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__edit");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function edit_causally_closed(outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome { (next, _) => facts_causally_closed(next.f_facts) }
}
proof edit_preserves_causal_closure(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  takes facts_causally_closed(before.f_facts)
  gives edit_causally_closed(Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditAtomic.edit_rejection_or_empty_unchanged(before, gap, insert, delete);
  edit_authored_has_exact_contents(before, gap, insert, delete);
  Nickel.EditCommit.authored_fact_replays_same_commit(before, gap, insert, delete);
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) => {
      receive_added_has_direct_dependencies(before, fact);
      exact_extension_preserves_causal_closure(before.f_facts, fact, next.f_facts)
    },
    _ => ()
  };
  assert(edit_causally_closed(Native.impl_Replica__edit(before, gap, insert, delete))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__edit");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function new_causally_closed(outcome: Result.t_Result(Native.t_Replica, Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(state) => facts_causally_closed(state.f_facts), _ => Prims.l_True }
}
proof new_establishes_causal_closure(writer: Option.t_Option(Native.t_Writer), limits: Native.t_Limits): unit
  gives new_causally_closed(Native.impl_Replica__new(writer, limits))
{
  Nickel.EditAtomic.new_has_empty_facts(writer, limits);
  assert(new_causally_closed(Native.impl_Replica__new(writer, limits))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__new");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
