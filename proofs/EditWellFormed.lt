function past_has_dependencies(facts: t_Slice(Native.t_Fact), after: t_Slice(Native.t_EventId), result: Result.t_Result(Alloc.Vec.t_Vec(Native.t_EventId, Alloc.Alloc.t_Global), Native.t_Error)): Type0 {
