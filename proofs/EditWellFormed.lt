import Nickel.EventGraphText
import Rust_primitives
import Core_models
import FStar.Pervasives
import Nickel.LoopUtil
import Nickel.Vector
import Nickel.EditIdentity
import Native = Nickel_crdt.Edit
import Result = Core_models.Result
import Option = Core_models.Option
import Tactics = FStar.Tactics.V2

import Nickel.EditAccepted
import FStar.Classical
import FStar.Fin
import Seq = FStar.Seq

// Independent scalar domain: Unicode scalar values, not arbitrary UTF-32 words.
function unicode_scalar(scalar: u32): Type0 {
  v(scalar) <= 1114111 and (v(scalar) < 55296 or v(scalar) > 57343)
}
function scalar_prefix(scalars: t_Slice(u32), finish: nat): Type0 {
  forall(i: usize where v(i) < v(Core_models.Slice.impl__len(scalars))) .
    v(i) < finish ==> unicode_scalar(Rust_primitives.Slice.slice_index(scalars, i))
}
function scalars_valid(scalars: t_Slice(u32)): Type0 {
  scalar_prefix(scalars, v(Core_models.Slice.impl__len(scalars)))
}
function scalar_check_result(scalars: t_Slice(u32), result: Result.t_Result(unit, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => scalars_valid(scalars), _ => Prims.l_True }
}
function scalar_check_invariant(scalars: t_Slice(u32), at: nat, state: unit): Type0 { scalar_prefix(scalars, at) }
proof scalar_validation_is_sound(scalars: t_Slice(u32)): unit
  gives scalar_check_result(scalars, Native.validate_scalars(scalars))
{
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(scalars),
    scalar_check_invariant(scalars), ((_: unit) => ()),
    ((_: unit) => scalars_valid(scalars)), ((_: Native.t_Error) => Prims.l_True));
  assert(scalar_check_result(scalars, Native.validate_scalars(scalars))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
proof valid_scalar_input_succeeds(scalars: t_Slice(u32)): unit
  takes scalars_valid(scalars)
  gives Native.validate_scalars(scalars) == Result.Result_Ok(())
{
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(scalars),
    ((_: nat, _: unit) => Prims.l_True), ((_: unit) => ()),
    ((_: unit) => Prims.l_True), ((_: Native.t_Error) => Prims.l_False));
  assert(Native.validate_scalars(scalars) == Result.Result_Ok(())) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function fact_scalars_valid(fact: Native.t_Fact): Type0 { scalars_valid(Alloc.Vec.impl_1__as_slice(fact.f_insert)) }
function validated_scalars(fact: Native.t_Fact, result: Result.t_Result(unit, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => fact_scalars_valid(fact), _ => Prims.l_True }
}
function no_validation_success(result: Result.t_Result(unit, Native.t_Error)): Type0 {
  match result { Result.Result_Err(_) => Prims.l_True, _ => Prims.l_False }
}
proof successful_validation_has_valid_scalars(facts: t_Slice(Native.t_Fact), limits: Native.t_Limits, fact: Native.t_Fact): unit
  gives validated_scalars(fact, Native.impl_Replica__validate_new(facts, limits, fact))
{
  Nickel.LoopUtil.early_return_preserve_any(mk_usize(0), Nickel.EditIdentity.length(facts), ((_: nat, _: usize) => Prims.l_True), no_validation_success);
  scalar_validation_is_sound(Alloc.Vec.impl_1__as_slice(fact.f_insert));
  assert(validated_scalars(fact, Native.impl_Replica__validate_new(facts, limits, fact))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Nickel_crdt.Edit.validate_scalars");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function added_scalars(fact: Native.t_Fact, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (_, Result.Result_Ok(Native.Admission_Added)) => fact_scalars_valid(fact), _ => Prims.l_True }
}
proof receive_added_fact_has_valid_scalars(before: Native.t_Replica, fact: Native.t_Fact): unit
  gives added_scalars(fact, Native.impl_Replica__receive(before, fact))
{
  successful_validation_has_valid_scalars(Alloc.Vec.impl_1__as_slice(before.f_facts), before.f_limits, fact);
  Nickel.EditAtomic.successful_plan_requires_validation(before, fact);
  Nickel.EditCommit.receive_uses_plan(before, fact);
  assert(added_scalars(fact, Native.impl_Replica__receive(before, fact))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__validate_new");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__plan");
    Tactics.prune("Nickel_crdt.Event_shell.plan");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function facts_scalars_valid(facts: facts_vec): Type0 {
  forall(fact: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(facts), fact) ==> fact_scalars_valid(fact)
}
// Whole-fact publication preserves a scalar predicate by membership, not replay.
function receive_scalars_preserved(outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome { (next, _) => facts_scalars_valid(next.f_facts) }
}
proof receive_preserves_scalar_validity(before: Native.t_Replica, fact: Native.t_Fact): unit
  takes facts_scalars_valid(before.f_facts)
  gives receive_scalars_preserved(Native.impl_Replica__receive(before, fact))
{
  Nickel.EditAtomic.receive_rejection_unchanged(before, fact);
  receive_added_has_exact_contents(before, fact);
  receive_added_fact_has_valid_scalars(before, fact);
  // Case analysis supplies result constructors, not implementation facts.
  match Native.impl_Replica__receive(before, fact) {
    (next, Result.Result_Ok(Native.Admission_Added)) => {
      assert(receive_scalars_preserved(Native.impl_Replica__receive(before, fact))) by {
        Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
        Tactics.prune("Alloc.Vec.from_seq");
        Tactics.prune("Alloc.Vec.impl_1__as_slice");
        Tactics.prune("Alloc.Vec.impl_1__len");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    },
    _ => {
      assert(receive_scalars_preserved(Native.impl_Replica__receive(before, fact))) by {
        Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
        Tactics.prune("Alloc.Vec.from_seq");
        Tactics.prune("Alloc.Vec.impl_1__as_slice");
        Tactics.prune("Alloc.Vec.impl_1__len");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
function authored_scalars(outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome { (_, Result.Result_Ok(Native.Local_Authored(fact))) => fact_scalars_valid(fact), _ => Prims.l_True }
}
proof edit_authors_only_valid_scalars(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  gives authored_scalars(Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditCommit.authored_fact_replays_same_commit(before, gap, insert, delete);
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (_, Result.Result_Ok(Native.Local_Authored(fact))) => receive_added_fact_has_valid_scalars(before, fact),
    _ => ()
  };
  assert(authored_scalars(Native.impl_Replica__edit(before, gap, insert, delete))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive");
    Tactics.prune("Nickel_crdt.Event_shell.receive_into");
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__edit");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
function edit_scalars_preserved(outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome { (next, _) => facts_scalars_valid(next.f_facts) }
}
proof edit_preserves_scalar_validity(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global)): unit
  takes facts_scalars_valid(before.f_facts)
  gives edit_scalars_preserved(Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditAtomic.edit_rejection_or_empty_unchanged(before, gap, insert, delete);
  edit_authored_has_exact_contents(before, gap, insert, delete);
  edit_authors_only_valid_scalars(before, gap, insert, delete);
  // Case analysis supplies result constructors, not implementation facts.
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) => {
      assert(edit_scalars_preserved(Native.impl_Replica__edit(before, gap, insert, delete))) by {
        Tactics.prune("Nickel_crdt.Edit.impl_Replica__edit");
        Tactics.prune("Alloc.Vec.from_seq");
        Tactics.prune("Alloc.Vec.impl_1__as_slice");
        Tactics.prune("Alloc.Vec.impl_1__len");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    },
    _ => {
      assert(edit_scalars_preserved(Native.impl_Replica__edit(before, gap, insert, delete))) by {
        Tactics.prune("Nickel_crdt.Edit.impl_Replica__edit");
        Tactics.prune("Alloc.Vec.from_seq");
        Tactics.prune("Alloc.Vec.impl_1__as_slice");
        Tactics.prune("Alloc.Vec.impl_1__len");
        Tactics.prune("Core_models.Slice.impl__len");
        Tactics.prune("Rust_primitives.Slice.slice_index");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
function new_scalars_valid(outcome: Result.t_Result(Native.t_Replica, Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(state) => facts_scalars_valid(state.f_facts), _ => Prims.l_True }
}
proof new_establishes_scalar_validity(writer: Option.t_Option(Native.t_Writer), limits: Native.t_Limits): unit
  gives new_scalars_valid(Native.impl_Replica__new(writer, limits))
{
  Nickel.EditAtomic.new_has_empty_facts(writer, limits);
  assert(new_scalars_valid(Native.impl_Replica__new(writer, limits))) by {
    Tactics.prune("Nickel_crdt.Edit.impl_Replica__new");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}

// Direct causal references name accepted facts; this is not acyclicity or replay.
function event_present(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): Type0 {
  not Nickel.EditIdentity.prefix_absent(facts, id, mk_usize(0), Nickel.EditIdentity.length(facts))
}
proof event_membership_is_presence(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  gives (Native.has_fact(facts, id) == true <==> event_present(facts, id))
{
  membership_absence_exact(facts, id)
}
// Constructor-complete boolean contract, usable with has_fact withheld.
function membership_result(facts: t_Slice(Native.t_Fact), id: Native.t_EventId, found: bool): Type0 {
  (found == true and event_present(facts, id)) or
    (found == false and not event_present(facts, id))
}
proof membership_result_is_exact(facts: t_Slice(Native.t_Fact), id: Native.t_EventId): unit
  gives membership_result(facts, id, Native.has_fact(facts, id))
  hint Native.has_fact(facts, id)
{
  event_membership_is_presence(facts, id);
  match Native.has_fact(facts, id) {
    true => {
      assert(membership_result(facts, id, Native.has_fact(facts, id))) by {
        Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
        Tactics.smt_sync'(1, 1)
      }
    },
    false => {
      assert(membership_result(facts, id, Native.has_fact(facts, id))) by {
        Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
function dependency_prefix(facts: t_Slice(Native.t_Fact), after: t_Slice(Native.t_EventId), finish: nat): Type0 {
  forall(i: usize where v(i) < v(Core_models.Slice.impl__len(after))) .
    v(i) < finish ==> event_present(facts, Rust_primitives.Slice.slice_index(after, i))
}
function dependencies_present(facts: t_Slice(Native.t_Fact), after: t_Slice(Native.t_EventId)): Type0 {
  dependency_prefix(facts, after, v(Core_models.Slice.impl__len(after)))
}
function dependency_check_result(facts: t_Slice(Native.t_Fact), after: t_Slice(Native.t_EventId), result: Result.t_Result(unit, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(_) => dependencies_present(facts, after), _ => Prims.l_True }
}
function dependency_check_invariant(facts: t_Slice(Native.t_Fact), after: t_Slice(Native.t_EventId), at: nat, state: unit): Type0 {
  dependency_prefix(facts, after, at)
}
proof dependency_validation_is_sound(facts: t_Slice(Native.t_Fact), after: t_Slice(Native.t_EventId)): unit
  gives dependency_check_result(facts, after, Native.validate_after(facts, after))
{
  Nickel.EventGraphText.text_graph_policy_is_exact();
  Nickel.EventGraphText.text_graph_callbacks_are_exact();
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(after),
    dependency_check_invariant(facts, after), ((_: unit) => ()),
    ((_: unit) => dependencies_present(facts, after)), ((_: Native.t_Error) => Prims.l_True));
  assert(dependency_check_result(facts, after, Native.validate_after(facts, after))) by {
    Tactics.prune("Nickel_crdt.Edit.v_TEXT_OPS");
    Tactics.prune("Nickel_crdt.Event_layer.graph_ops");
    Tactics.prune("Nickel_crdt.Event_layer.event_ops");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.prune("Nickel_crdt.Edit.has_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_fact");
    Tactics.prune("Alloc.Vec.from_seq");
    Tactics.prune("Alloc.Vec.impl_1__as_slice");
    Tactics.prune("Alloc.Vec.impl_1__len");
    Tactics.prune("Core_models.Slice.impl__len");
    Tactics.prune("Rust_primitives.Slice.slice_index");
    Tactics.smt_sync'(1, 1)
  }
}
