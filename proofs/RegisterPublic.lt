// Public-caller statements (positional uniqueness, read, producer bookkeeping and later public
// meaning), split from RegisterHistory.lt for the 60 s per-module budget. Statements unchanged.
// ---------------------------------------------------------------- public callers: positional uniqueness
// #117's positional ID uniqueness is stronger than stored_unique: it also forbids repeated identical
// entries. The arbitrary-slice laws above keep stored_unique and their domains; only public callers
// combine the two.
proof positional_ids_are_stored_unique(facts: Alloc.Vec.t_Vec(Nickel.Register.fact, Alloc.Alloc.t_Global)): unit
  takes Nickel.Register.fact_ids_unique(facts)
  gives stored_unique(Alloc.Vec.impl_1__as_slice(facts))
{
  const items = Alloc.Vec.impl_1__as_slice(facts);
  proof each(f: Nickel.Register.fact, g: Nickel.Register.fact, i: nat, j: nat): unit
    takes i < Seq.length(items) and Seq.index(items, i) == f
    takes j < Seq.length(items) and Seq.index(items, j) == g
    takes f.f_id == g.f_id
    gives f == g
  { () };
  FStar.Classical.forall_intro_4(FStar.Classical.move_requires_4(each))
}
// The public invariant: the history invariant with positional uniqueness (whose stored_unique
// part positional_ids_are_stored_unique also gives).
function public_history(r: Native.t_Replica): Type0 {
  history_invariant(r) and Nickel.Register.fact_ids_unique(r.f_facts)
}
proof receive_preserves_public_history(before: Native.t_Replica, offered: Nickel.Register.fact): unit
  takes public_history(before)
  gives public_history((Native.impl_Replica__receive(before, offered))._1)
{
  receive_preserves_history(before, offered);
  Nickel.Register.receive_preserves_unique_ids(before, offered);
  assert(public_history((Native.impl_Replica__receive(before, offered))._1)) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Register.planned");
    Tactics.prune("Nickel.Register.receive_preserves_private");
    Tactics.prune("Nickel.Register.planned_preserves_private");
    Tactics.prune("Nickel.Register.planned_checks_payload");
    Tactics.prune("Nickel.Register.planned_adds_exact_fact");
    Tactics.prune("Nickel.RegisterValid.history_invariant");
    Tactics.prune("Nickel.Register.fact_ids_unique");
    Tactics.smt_sync'(1, 1)
  }
}
proof write_preserves_public_history(before: Native.t_Replica, key: u64, value: Alloc.Vec.t_Vec(u8, Alloc.Alloc.t_Global)): unit
  takes public_history(before)
  gives public_history((Native.impl_Replica__write(before, key, value))._1)
{
  write_preserves_history(before, key, value);
  Nickel.Register.write_preserves_unique_ids(before, key, value);
  assert(public_history((Native.impl_Replica__write(before, key, value))._1)) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__write");
    Tactics.prune("Nickel.RegisterValid.history_invariant");
    Tactics.prune("Nickel.Register.fact_ids_unique");
    Tactics.smt_sync'(1, 1)
  }
}
proof new_establishes_public_history(writer: u64, initial: Alloc.Vec.t_Vec(u8, Alloc.Alloc.t_Global), limits: Native.t_Limits): unit
  gives forall(r: Native.t_Replica) . Native.impl_Replica__new(writer, initial, limits) == Result.Result_Ok(r) ==> public_history(r)
{
  new_establishes_history(writer, initial, limits);
  Nickel.Register.new_has_unique_ids(writer, initial, limits);
  assert(forall(r: Native.t_Replica) . Native.impl_Replica__new(writer, initial, limits) == Result.Result_Ok(r) ==> public_history(r)) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__new");
    Tactics.prune("Nickel.RegisterValid.history_invariant");
    Tactics.prune("Nickel.Register.fact_ids_unique");
    Tactics.smt_sync'(1, 1)
  }
}

// ---------------------------------------------------------------- public callers: single-valued read
// A slice entry is a member (RegisterPast's absent-prefix form).
proof index_is_member(ids: t_Slice(Envelope.t_Id), k: nat): unit
  takes k < Seq.length(ids)
  gives Nickel.RegisterPast.member(ids, Seq.index(ids, k))
{ assert(v(mk_usize(k)) == k) }
// Id-level parent clocks give the positional parent-clock premise of the read bridge.
proof positional_clocks_from_ids(facts: t_Slice(Nickel.Register.fact)): unit
  takes id_clocks_increase(facts)
  gives clocks_increase(facts)
{
  proof each(newer: nat, older: nat, k: nat): unit
    takes newer < Seq.length(facts) and older < Seq.length(facts)
    takes k < Seq.length(Alloc.Vec.impl_1__as_slice(Seq.index(facts, newer).f_after)) and
      Seq.index(Alloc.Vec.impl_1__as_slice(Seq.index(facts, newer).f_after), k) == Seq.index(facts, older).f_id
    gives clock_below(facts, older, newer)
  {
    index_is_member(Alloc.Vec.impl_1__as_slice(Seq.index(facts, newer).f_after), k);
    assert(stored(facts, Seq.index(facts, newer)));
    assert(stored(facts, Seq.index(facts, older)))
  };
  FStar.Classical.forall_intro_3(FStar.Classical.move_requires_3(each))
}
// The position-free stream clause gives the path-free stream premise of single-valuedness:
// the predecessor is an id ancestor, so its clock is smaller.
proof stream_step_at(h: t_Slice(Nickel.Register.fact), i: nat): unit
  takes stored_unique(h) and id_clocks_increase(h) and streams_ok(h)
  takes i < Seq.length(h) and v(Seq.index(h, i).f_id.f_counter) > 1
  gives exists(j: nat) . predecessor_of(h, i, j) and clock_below(h, j, i)
{
  const f = Seq.index(h, i);
  assert(stored(h, f));
  proof via(g: Nickel.Register.fact, j: nat, root: Envelope.t_Id, steps: Prims.list(Envelope.t_Id)): unit
    takes j < Seq.length(h) and Seq.index(h, j) == g
    takes g.f_id.f_peer == f.f_id.f_peer and v(g.f_id.f_counter) + 1 == v(f.f_id.f_counter)
    takes Nickel.RegisterPast.member(Alloc.Vec.impl_1__as_slice(f.f_after), root) and id_path(h, root, steps, g.f_id)
    gives exists(j: nat) . predecessor_of(h, i, j) and clock_below(h, j, i)
  {
    assert(id_edge(h, f.f_id, root));
    assert(id_path(h, f.f_id, Prims.Cons(root, steps), g.f_id));
    assert(stored(h, g));
    id_path_clock_decreases(h, f, root, steps, g);
    assert(predecessor_of(h, i, j) and clock_below(h, j, i)) by {
      Tactics.prune("Nickel.RegisterHistory.id_path");
      Tactics.prune("Nickel.RegisterHistory.id_edge");
      Tactics.prune("Nickel.RegisterHistory.id_clocks_increase");
      Tactics.prune("Nickel.RegisterHistory.stored_unique");
      Tactics.prune("Nickel.RegisterValid.streams_ok");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_4(FStar.Classical.move_requires_4(via));
  assert(exists(j: nat) . predecessor_of(h, i, j) and clock_below(h, j, i)) by {
    Tactics.prune("Nickel.RegisterHistory.id_path");
    Tactics.prune("Nickel.RegisterHistory.id_clocks_increase");
    Tactics.prune("Nickel.RegisterHistory.stored_unique");
    Tactics.smt_sync'(1, 1)
  }
}
proof counter_positive_at(h: t_Slice(Nickel.Register.fact), i: nat): unit
  takes streams_ok(h)
  takes i < Seq.length(h)
  gives v(Seq.index(h, i).f_id.f_counter) >= 1
{ assert(stored(h, Seq.index(h, i))) }
proof public_single_value_premises(r: Native.t_Replica): unit
  takes public_history(r)
  gives stream_steps(Alloc.Vec.impl_1__as_slice(r.f_facts)) and ids_unique(Alloc.Vec.impl_1__as_slice(r.f_facts)) and
    counters_positive(Alloc.Vec.impl_1__as_slice(r.f_facts))
{
  const h = Alloc.Vec.impl_1__as_slice(r.f_facts);
  positional_ids_are_stored_unique(r.f_facts);
  proof positive(i: nat): unit
    gives i < Seq.length(h) ==> v(Seq.index(h, i).f_id.f_counter) >= 1
  { if i < Seq.length(h) { counter_positive_at(h, i) } else { () } };
  proof step(i: nat): unit
    gives (i < Seq.length(h) and v(Seq.index(h, i).f_id.f_counter) > 1) ==>
      (exists(j: nat) . predecessor_of(h, i, j) and clock_below(h, j, i))
  { if i < Seq.length(h) { if v(Seq.index(h, i).f_id.f_counter) > 1 { stream_step_at(h, i) } else { () } } else { () } };
  FStar.Classical.forall_intro(positive);
  FStar.Classical.forall_intro(step);
  assert(stream_steps(h) and ids_unique(h) and counters_positive(h)) by {
    Tactics.prune("Nickel.RegisterValid.streams_ok");
    Tactics.prune("Nickel.RegisterHistory.stored_unique");
    Tactics.prune("Nickel.RegisterHistory.id_clocks_increase");
    Tactics.smt_sync'(1, 1)
  }
}
// Single-valuedness from the path-free stream premise (the arbitrary-slice law above keeps
// its chained-stream form).
proof causal_read_is_single_valued_by_steps(facts: t_Slice(Nickel.Register.fact), key: u64, initial: t_Slice(u8), x: t_Slice(u8), y: t_Slice(u8)): unit
  takes stream_steps(facts) and ids_unique(facts) and counters_positive(facts)
  takes causal_read(facts, key, initial, x)
  takes causal_read(facts, key, initial, y)
  gives Nickel.Register.bytes_same(x, y)
{
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(maximal_pair_is_one_fact(facts, key)));
  FStar.Classical.forall_intro_3(FStar.Classical.move_requires_3(bytes_same_through))
}
proof public_clocks_increase(r: Native.t_Replica): unit
  takes public_history(r)
  gives clocks_increase(Alloc.Vec.impl_1__as_slice(r.f_facts))
{
  positional_clocks_from_ids(Alloc.Vec.impl_1__as_slice(r.f_facts));
  assert(clocks_increase(Alloc.Vec.impl_1__as_slice(r.f_facts))) by {
    Tactics.prune("Nickel.RegisterHistory.clocks_increase");
    Tactics.prune("Nickel.RegisterHistory.stored_unique");
    Tactics.prune("Nickel.RegisterHistory.closed");
    Tactics.prune("Nickel.RegisterHistory.observations_ok");
    Tactics.prune("Nickel.RegisterValid.clocks_exact");
    Tactics.prune("Nickel.RegisterValid.values_changed");
    Tactics.prune("Nickel.RegisterValid.streams_ok");
    Tactics.prune("Nickel.Register.fact_ids_unique");
    Tactics.prune("Nickel.Register.receive_preserves_private");
    Tactics.prune("Nickel.Register.planned_preserves_private");
    Tactics.prune("Nickel.Register.planned_checks_payload");
    Tactics.prune("Nickel.Register.planned_adds_exact_fact");
    Tactics.smt_sync'(1, 1)
  }
}
// The public read of a public replica is its causal read, and every causal read of that
// history has the same bytes.
proof public_read_is_the_causal_read(r: Native.t_Replica, key: u64, x: t_Slice(u8)): unit
  takes public_history(r)
  gives causal_read(Alloc.Vec.impl_1__as_slice(r.f_facts), key, Alloc.Vec.impl_1__as_slice(r.f_initial),
      Alloc.Vec.impl_1__as_slice(Native.impl_Replica__read(r, key))) and
    (causal_read(Alloc.Vec.impl_1__as_slice(r.f_facts), key, Alloc.Vec.impl_1__as_slice(r.f_initial), x) ==>
      Nickel.Register.bytes_same(Alloc.Vec.impl_1__as_slice(Native.impl_Replica__read(r, key)), x))
{
  const h = Alloc.Vec.impl_1__as_slice(r.f_facts);
  const init = Alloc.Vec.impl_1__as_slice(r.f_initial);
  Nickel.Register.public_read_is_history(r, key);
  public_clocks_increase(r);
  assert(clocks_increase(h)) by {
    Tactics.prune("Nickel.RegisterPublic.public_history");
    Tactics.prune("Nickel.Register.public_read_is_history");
    Tactics.prune("Nickel_crdt.Register.impl_Replica__read");
    Tactics.prune("Nickel_crdt.Register.read_history");
    Tactics.prune("Nickel_crdt.Register.winner");
    Tactics.prune("Nickel.RegisterHistory.id_clocks_increase");
    Tactics.prune("Nickel.RegisterHistory.parent_edge");
    Tactics.prune("Nickel.RegisterHistory.clock_below");
    Tactics.prune("Nickel.RegisterHistory.clocks_increase");
    Tactics.prune("Nickel.RegisterHistory.stored_unique");
    Tactics.prune("Nickel.RegisterHistory.closed");
    Tactics.prune("Nickel.RegisterHistory.observations_ok");
    Tactics.prune("Nickel.RegisterValid.clocks_exact");
    Tactics.prune("Nickel.RegisterValid.values_changed");
    Tactics.prune("Nickel.RegisterValid.streams_ok");
    Tactics.prune("Nickel.Register.fact_ids_unique");
    Tactics.prune("Nickel.Register.receive_preserves_private");
    Tactics.prune("Nickel.Register.planned_preserves_private");
    Tactics.prune("Nickel.Register.planned_checks_payload");
    Tactics.prune("Nickel.Register.planned_adds_exact_fact");
    Tactics.smt_sync'(1, 1)
  };
  read_history_is_causal_read(h, init, key);
  public_single_value_premises(r);
  FStar.Classical.move_requires(causal_read_is_single_valued_by_steps(h, key, init, Alloc.Vec.impl_1__as_slice(Native.impl_Replica__read(r, key))), x);
  assert(causal_read(h, key, init, Alloc.Vec.impl_1__as_slice(Native.impl_Replica__read(r, key))) and
    (causal_read(h, key, init, x) ==> Nickel.Register.bytes_same(Alloc.Vec.impl_1__as_slice(Native.impl_Replica__read(r, key)), x))) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__read");
    Tactics.prune("Nickel.Register.public_read_is_history");
    Tactics.prune("Nickel_crdt.Register.read_history");
    Tactics.prune("Nickel_crdt.Register.winner");
    Tactics.prune("Nickel.RegisterHistory.causal_read");
    Tactics.prune("Nickel.RegisterPublic.public_history");
    Tactics.prune("Nickel.RegisterHistory.clocks_increase");
    Tactics.prune("Nickel.RegisterHistory.id_clocks_increase");
    Tactics.prune("Nickel.RegisterHistory.stream_steps");
    Tactics.smt_sync'(1, 1)
  }
}

// ---------------------------------------------------------------- public callers: producer bookkeeping
// Local producer-state meaning only: this is not an ID-allocation or recovery guarantee, and it
// does not say the counter exceeds any received fact of this writer (receive never restores it).
proof new_public_producer(writer: u64, initial: Alloc.Vec.t_Vec(u8, Alloc.Alloc.t_Global), limits: Native.t_Limits): unit
  gives forall(r: Native.t_Replica) . Native.impl_Replica__new(writer, initial, limits) == Result.Result_Ok(r) ==>
    (public_history(r) and r.f_writer == writer and v(r.f_next_counter) == 1)
{
  new_establishes_public_history(writer, initial, limits);
  proof each(r: Native.t_Replica): unit
    takes Native.impl_Replica__new(writer, initial, limits) == Result.Result_Ok(r)
    gives r.f_writer == writer and v(r.f_next_counter) == 1
  { () };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each));
  assert(forall(r: Native.t_Replica) . Native.impl_Replica__new(writer, initial, limits) == Result.Result_Ok(r) ==>
    (public_history(r) and r.f_writer == writer and v(r.f_next_counter) == 1)) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__new");
    Tactics.prune("Nickel.RegisterPublic.public_history");
    Tactics.smt_sync'(1, 1)
  }
}
// Every receive return keeps public_history, the writer and the private counter (and the
// initial value and limits).
proof receive_public_producer(before: Native.t_Replica, offered: Nickel.Register.fact): unit
  takes public_history(before)
  gives public_history((Native.impl_Replica__receive(before, offered))._1) and
    Nickel.Register.private_frame(before, (Native.impl_Replica__receive(before, offered))._1)
{
  receive_preserves_public_history(before, offered);
  Nickel.Register.receive_preserves_private(before, offered);
  assert(public_history((Native.impl_Replica__receive(before, offered))._1) and
    Nickel.Register.private_frame(before, (Native.impl_Replica__receive(before, offered))._1)) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__receive");
    Tactics.prune("Nickel_crdt.Register.planned");
    Tactics.prune("Nickel.RegisterPublic.public_history");
    Tactics.prune("Nickel.Register.private_frame");
    Tactics.prune("Nickel.Register.receive_preserves_private");
    Tactics.prune("Nickel.Register.planned_preserves_private");
    Tactics.prune("Nickel.Register.planned_checks_payload");
    Tactics.prune("Nickel.Register.planned_adds_exact_fact");
    Tactics.smt_sync'(1, 1)
  }
}
// Every write return keeps public_history. An error or equal-value no-edit leaves the whole
// replica unchanged; a counted write authors (writer, old counter), advances the private counter
// by exactly one and installs the checked successful candidate.
proof write_public_producer(before: Native.t_Replica, key: u64, value: Alloc.Vec.t_Vec(u8, Alloc.Alloc.t_Global)): unit
  takes public_history(before)
  gives public_history((Native.impl_Replica__write(before, key, value))._1) and
    Nickel.Register.write_outcome(before, Native.impl_Replica__write(before, key, value)) and
    Nickel.Register.write_installation(before, key, value, Native.impl_Replica__write(before, key, value))
{
  write_preserves_public_history(before, key, value);
  Nickel.Register.write_publication_on_every_return(before, key, value);
  Nickel.Register.write_installs_successful_candidate(before, key, value);
  assert(public_history((Native.impl_Replica__write(before, key, value))._1) and
    Nickel.Register.write_outcome(before, Native.impl_Replica__write(before, key, value)) and
    Nickel.Register.write_installation(before, key, value, Native.impl_Replica__write(before, key, value))) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__write");
    Tactics.prune("Nickel.RegisterPublic.public_history");
    Tactics.prune("Nickel.Register.write_outcome");
    Tactics.prune("Nickel.Register.write_installation");
    Tactics.smt_sync'(1, 1)
  }
}
// Exhaustion: a counted write never wraps (its old counter is below the u64 maximum). The
// equal-value no-edit has no counter premise (Register.equal_value_write_is_neutral), so it
// succeeds even at the maximum counter.
proof counted_write_does_not_wrap(before: Native.t_Replica, key: u64, value: Alloc.Vec.t_Vec(u8, Alloc.Alloc.t_Global)): unit
  gives forall(next: Native.t_Replica, authored: Nickel.Register.fact) .
    Native.impl_Replica__write(before, key, value) == (next, Result.Result_Ok(Option.Option_Some(authored))) ==>
      v(before.f_next_counter) < Rust_primitives.Integers.maxint(Rust_primitives.Integers.U64)
{
  Nickel.Register.write_publication_on_every_return(before, key, value);
  assert(forall(next: Native.t_Replica, authored: Nickel.Register.fact) .
    Native.impl_Replica__write(before, key, value) == (next, Result.Result_Ok(Option.Option_Some(authored))) ==>
      v(before.f_next_counter) < Rust_primitives.Integers.maxint(Rust_primitives.Integers.U64)) by {
    Tactics.prune("Nickel_crdt.Register.impl_Replica__write");
    Tactics.smt_sync'(1, 1)
  }
}
