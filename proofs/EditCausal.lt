import Rust_primitives
import Core_models
import FStar.Pervasives
import FStar.NormSteps
import Nickel.EditWellFormed
import Nickel.EditAccepted
import Native = Nickel_crdt.Edit
import Result = Core_models.Result
import Option = Core_models.Option
import Seq = FStar.Seq
import FStar.Classical

// A ghost certificate, not stored Rust metadata and not event-ID order.
function fact_descends(rank: (Native.t_EventId => nat), fact: Native.t_Fact): Type0 {
  forall(i: usize where v(i) < v(Core_models.Slice.impl__len(Alloc.Vec.impl_1__as_slice(fact.f_after)))) .
    rank(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i)) < rank(fact.f_id)
}
function causal_rank(facts: facts_vec, rank: (Native.t_EventId => nat), bound: nat): Type0 {
  facts_causally_closed(facts) and
  forall(fact: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(facts), fact) ==>
    (rank(fact.f_id) < bound and fact_descends(rank, fact))
}
function extend_rank(rank: (Native.t_EventId => nat), bound: nat, fresh: Native.t_EventId): (Native.t_EventId => nat) {
  (id: Native.t_EventId) => if id ==? fresh { bound } else { rank(id) }
}
proof present_fact_has_id(facts: t_Slice(Native.t_Fact), fact: Native.t_Fact): unit
  takes fact_present(facts, fact)
  gives event_present(facts, fact.f_id)
{
  absence_on_whole_facts(facts, fact.f_id);
  norm_spec([delta_only(["Nickel.EditWellFormed.event_present"]), iota], event_present(facts, fact.f_id))
}
proof present_id_rank_bound(facts: facts_vec, rank: (Native.t_EventId => nat), bound: nat, id: Native.t_EventId): unit
  takes causal_rank(facts, rank, bound)
  takes event_present(Alloc.Vec.impl_1__as_slice(facts), id)
  gives rank(id) < bound
{
  event_membership_is_presence(Alloc.Vec.impl_1__as_slice(facts), id);
  const i = find_id_position(Alloc.Vec.impl_1__as_slice(facts), id);
  assert(fact_present(Alloc.Vec.impl_1__as_slice(facts), Seq.index(Alloc.Vec.impl_1__as_slice(facts), i)));
  norm_spec([delta_only(["Nickel.EditCausal.causal_rank"]), iota], causal_rank(facts, rank, bound))
}
proof old_rank_unchanged(facts: facts_vec, rank: (Native.t_EventId => nat), bound: nat, fresh: Native.t_EventId, id: Native.t_EventId): unit
  takes Nickel.EditIdentity.prefix_absent(Alloc.Vec.impl_1__as_slice(facts), fresh, mk_usize(0), Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(facts)))
  takes event_present(Alloc.Vec.impl_1__as_slice(facts), id)
  gives extend_rank(rank, bound, fresh)(id) == rank(id)
{
  absence_on_whole_facts(Alloc.Vec.impl_1__as_slice(facts), fresh);
  event_membership_is_presence(Alloc.Vec.impl_1__as_slice(facts), id);
  const i = find_id_position(Alloc.Vec.impl_1__as_slice(facts), id);
  assert(fact_present(Alloc.Vec.impl_1__as_slice(facts), Seq.index(Alloc.Vec.impl_1__as_slice(facts), i)));
  norm_spec([delta_only(["Nickel.EditCausal.extend_rank"]), iota, zeta_full], extend_rank(rank, bound, fresh)(id))
}
proof exact_extension_extends_rank(before: facts_vec, fact: Native.t_Fact, next: facts_vec, rank: (Native.t_EventId => nat), bound: nat): unit
  takes causal_rank(before, rank, bound)
  takes fact_dependencies_present(Alloc.Vec.impl_1__as_slice(before), fact)
  takes Nickel.EditIdentity.prefix_absent(Alloc.Vec.impl_1__as_slice(before), fact.f_id, mk_usize(0), Nickel.EditIdentity.length(Alloc.Vec.impl_1__as_slice(before)))
  takes appended_contents(before, fact, next)
  gives causal_rank(next, extend_rank(rank, bound, fact.f_id), bound + 1)
{
  exact_extension_preserves_causal_closure(before, fact, next);
  proof each_fact(item: Native.t_Fact): unit
    takes fact_present(Alloc.Vec.impl_1__as_slice(next), item)
    gives extend_rank(rank, bound, fact.f_id)(item.f_id) < bound + 1 and fact_descends(extend_rank(rank, bound, fact.f_id), item)
  {
    if item ==? fact {
      proof each_dependency(i: usize where v(i) < v(Core_models.Slice.impl__len(Alloc.Vec.impl_1__as_slice(fact.f_after)))): unit
        gives extend_rank(rank, bound, fact.f_id)(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i)) < bound
      {
        const id = Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i);
        assert(event_present(Alloc.Vec.impl_1__as_slice(before), id));
        present_id_rank_bound(before, rank, bound, id);
        old_rank_unchanged(before, rank, bound, fact.f_id, id)
      };
      FStar.Classical.forall_intro(each_dependency);
      norm_spec([delta_only(["Nickel.EditCausal.fact_descends", "Nickel.EditCausal.extend_rank"]), iota, zeta_full], fact_descends(extend_rank(rank, bound, fact.f_id), item))
    } else {
      assert(fact_present(Alloc.Vec.impl_1__as_slice(before), item));
      present_fact_has_id(Alloc.Vec.impl_1__as_slice(before), item);
      old_rank_unchanged(before, rank, bound, fact.f_id, item.f_id);
      proof each_dependency(i: usize where v(i) < v(Core_models.Slice.impl__len(Alloc.Vec.impl_1__as_slice(item.f_after)))): unit
        gives extend_rank(rank, bound, fact.f_id)(Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(item.f_after), i)) < extend_rank(rank, bound, fact.f_id)(item.f_id)
      {
        const id = Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(item.f_after), i);
        assert(event_present(Alloc.Vec.impl_1__as_slice(before), id));
        old_rank_unchanged(before, rank, bound, fact.f_id, id)
      };
      FStar.Classical.forall_intro(each_dependency);
      norm_spec([delta_only(["Nickel.EditCausal.fact_descends"]), iota], fact_descends(extend_rank(rank, bound, fact.f_id), item))
    }
  };
  proof all_fact(item: Native.t_Fact): unit
    gives fact_present(Alloc.Vec.impl_1__as_slice(next), item) ==> (extend_rank(rank, bound, fact.f_id)(item.f_id) < bound + 1 and fact_descends(extend_rank(rank, bound, fact.f_id), item))
  { FStar.Classical.move_requires(each_fact, item) };
  FStar.Classical.forall_intro(all_fact);
  norm_spec([delta_only(["Nickel.EditCausal.causal_rank"]), iota], causal_rank(next, extend_rank(rank, bound, fact.f_id), bound + 1))
}

function receive_ranked(rank: Native.t_EventId => nat, bound: nat, fact: Native.t_Fact, outcome: (Native.t_Replica, Result.t_Result(Native.t_Admission, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(Native.Admission_Added)) => causal_rank(next.f_facts, extend_rank(rank, bound, fact.f_id), bound + 1),
    (next, _) => causal_rank(next.f_facts, rank, bound)
  }
}
proof receive_preserves_causal_rank(before: Native.t_Replica, fact: Native.t_Fact, rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(before.f_facts, rank, bound)
  gives receive_ranked(rank, bound, fact, Native.impl_Replica__receive(before, fact))
{
  Nickel.EditAtomic.receive_rejection_unchanged(before, fact);
  receive_added_has_exact_contents(before, fact);
  receive_added_has_direct_dependencies(before, fact);
  Nickel.EditIdentity.receive_added_has_fresh_event_id(before, fact);
  match Native.impl_Replica__receive(before, fact) {
    (next, Result.Result_Ok(Native.Admission_Added)) => exact_extension_extends_rank(before.f_facts, fact, next.f_facts, rank, bound),
    _ => ()
  };
  norm_spec([delta_only(["Nickel.EditCausal.receive_ranked", "Nickel.EditAtomic.receive_neutral"]), iota, zeta_full], receive_ranked(rank, bound, fact, Native.impl_Replica__receive(before, fact)))
}
function edit_ranked(rank: Native.t_EventId => nat, bound: nat, outcome: (Native.t_Replica, Result.t_Result(Native.t_Local, Native.t_Error))): Type0 {
  match outcome {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) => causal_rank(next.f_facts, extend_rank(rank, bound, fact.f_id), bound + 1),
    (next, _) => causal_rank(next.f_facts, rank, bound)
  }
}
proof edit_preserves_causal_rank(before: Native.t_Replica, gap: usize, insert: Alloc.Vec.t_Vec(u32, Alloc.Alloc.t_Global), delete: Alloc.Vec.t_Vec(Native.t_BirthId, Alloc.Alloc.t_Global), rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(before.f_facts, rank, bound)
  gives edit_ranked(rank, bound, Native.impl_Replica__edit(before, gap, insert, delete))
{
  Nickel.EditAtomic.edit_rejection_or_empty_unchanged(before, gap, insert, delete);
  edit_authored_has_exact_contents(before, gap, insert, delete);
  Nickel.EditCommit.authored_fact_replays_same_commit(before, gap, insert, delete);
  Nickel.EditIdentity.authored_event_id_is_fresh(before, gap, insert, delete);
  match Native.impl_Replica__edit(before, gap, insert, delete) {
    (next, Result.Result_Ok(Native.Local_Authored(fact))) => {
      receive_added_has_direct_dependencies(before, fact);
      exact_extension_extends_rank(before.f_facts, fact, next.f_facts, rank, bound)
    },
    _ => ()
  };
  norm_spec([delta_only(["Nickel.EditCausal.edit_ranked", "Nickel.EditAtomic.edit_neutral"]), iota, zeta_full], edit_ranked(rank, bound, Native.impl_Replica__edit(before, gap, insert, delete)))
}
function new_ranked(outcome: Result.t_Result(Native.t_Replica, Native.t_Error)): Type0 {
  match outcome { Result.Result_Ok(state) => causal_rank(state.f_facts, ((_: Native.t_EventId) => 0), 0), _ => Prims.l_True }
}
proof new_establishes_causal_rank(writer: Option.t_Option(Native.t_Writer), limits: Native.t_Limits): unit
  gives new_ranked(Native.impl_Replica__new(writer, limits))
{
  new_establishes_causal_closure(writer, limits);
  norm_spec([delta_only(["Nickel.EditCausal.new_ranked", "Nickel.EditCausal.causal_rank", "Nickel_crdt.Edit.impl_Replica__new", "Nickel.EditAccepted.fact_present", "Alloc.Vec.impl_1__as_slice", "Alloc.Vec.impl__new", "Rust_primitives.Sequence.seq_empty", "Rust_primitives.Sequence.seq_to_slice", "Core_models.Slice.impl__len", "Nickel.EditIdentity.length"]), iota, zeta_full, primops], new_ranked(Native.impl_Replica__new(writer, limits)))
}

function causal_edge(facts: facts_vec, newer: Native.t_EventId, older: Native.t_EventId): Type0 {
  exists(fact: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(facts), fact) and fact.f_id == newer and
    (exists(i: usize) . v(i) < v(Core_models.Slice.impl__len(Alloc.Vec.impl_1__as_slice(fact.f_after))) and
      Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i) == older)
}
proof causal_edge_descends(facts: facts_vec, rank: Native.t_EventId => nat, bound: nat, newer: Native.t_EventId, older: Native.t_EventId): unit
  takes causal_rank(facts, rank, bound)
  takes causal_edge(facts, newer, older)
  gives rank(older) < rank(newer)
{
  norm_spec([delta_only(["Nickel.EditCausal.causal_rank", "Nickel.EditCausal.causal_edge", "Nickel.EditCausal.fact_descends"]), iota, zeta_full], causal_edge(facts, newer, older))
}
function! causal_path(facts: facts_vec, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId): Type0
  decreases steps
{
  match steps {
    Prims.Nil => start == finish,
    Prims.Cons(next, rest) => causal_edge(facts, start, next) and causal_path(facts, next, rest, finish)
  }
}
proof! causal_path_descends(facts: facts_vec, rank: Native.t_EventId => nat, bound: nat, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId): unit
  decreases steps
  takes causal_rank(facts, rank, bound)
  takes causal_path(facts, start, steps, finish)
  gives rank(finish) <= rank(start) and (not (steps == Prims.Nil) ==> rank(finish) < rank(start))
{
  norm_spec([delta_once(["Nickel.EditCausal.causal_path"]), iota, zeta_full], causal_path(facts, start, steps, finish));
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => {
      causal_edge_descends(facts, rank, bound, start, next);
      causal_path_descends(facts, rank, bound, next, rest, finish)
    }
  }
}
proof rank_excludes_nonempty_cycles(facts: facts_vec, rank: Native.t_EventId => nat, bound: nat, start: Native.t_EventId, steps: Prims.list(Native.t_EventId)): unit
  takes causal_rank(facts, rank, bound)
  takes causal_path(facts, start, steps, start)
  gives steps == Prims.Nil
{ causal_path_descends(facts, rank, bound, start, steps, start) }

// hax lowers the derived Clone instance to value identity. It copies the
// existing certificate; it supplies no fresh writer identity or allocator.
proof clone_preserves_causal_rank(before: Native.t_Replica, rank: Native.t_EventId => nat, bound: nat): unit
  takes causal_rank(before.f_facts, rank, bound)
  gives causal_rank(Native.impl_82.f_clone(before).f_facts, rank, bound)
{ norm_spec([delta_only(["Nickel_crdt.Edit.impl_82"]), iota, zeta_full], Native.impl_82.f_clone(before)) }

proof actual_reference_is_edge(facts: facts_vec, fact: Native.t_Fact,
  i: usize where v(i) < v(Core_models.Slice.impl__len(Alloc.Vec.impl_1__as_slice(fact.f_after)))): unit
  takes fact_present(Alloc.Vec.impl_1__as_slice(facts), fact)
  gives causal_edge(facts, fact.f_id, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i))
{ norm_spec([delta_only(["Nickel.EditCausal.causal_edge"]), iota], causal_edge(facts, fact.f_id, Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i))) }
proof self_reference_has_no_rank(facts: facts_vec, fact: Native.t_Fact,
  i: usize where v(i) < v(Core_models.Slice.impl__len(Alloc.Vec.impl_1__as_slice(fact.f_after))), rank: Native.t_EventId => nat, bound: nat): unit
  takes fact_present(Alloc.Vec.impl_1__as_slice(facts), fact)
  takes Rust_primitives.Slice.slice_index(Alloc.Vec.impl_1__as_slice(fact.f_after), i) == fact.f_id
  gives not (causal_rank(facts, rank, bound))
{
  proof impossible(dummy: unit): unit
    takes causal_rank(facts, rank, bound)
    gives Prims.l_False
  {
    actual_reference_is_edge(facts, fact, i);
    causal_edge_descends(facts, rank, bound, fact.f_id, fact.f_id);
    assert(Prims.l_False)
  };
  FStar.Classical.move_requires(impossible, ())
}
