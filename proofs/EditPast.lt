import Shared = Nickel_crdt.Event_layer
import Graph = Nickel.EventGraph
import Nickel.EventGraphText
import Rust_primitives
import Core_models
import FStar.Pervasives
import FStar.Classical
import Nickel.Vector
import Nickel.LoopUtil
import Nickel.EditAccepted
import Nickel.EditCausal
import List = FStar.List.Tot
import Native = Nickel_crdt.Edit
import Result = Core_models.Result
import Seq = FStar.Seq

// Prefix absence is independent of the implementation's membership scan.
function absent_prefix(ids: t_Slice(Native.t_EventId), id: Native.t_EventId, finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(ids)) . v(i) < finish ==> Seq.index(ids, v(i)) =!= id
}
function member(ids: t_Slice(Native.t_EventId), id: Native.t_EventId): Type0 {
  not absent_prefix(ids, id, Seq.length(ids))
}
proof event_membership_is_exact(ids: t_Slice(Native.t_EventId), id: Native.t_EventId): unit
  gives Native.has_event(ids, id) == true <==> member(ids, id)
  hint Native.has_event(ids, id)
{
  // Check the actual text arguments before consuming generic correctness.
  assert(Shared.has_id(ids, id, Native.same_event_id) == Native.has_event(ids, id));
  Graph.membership_is_exact(ids, id, Native.same_event_id);
  assert(Native.has_event(ids, id) == true <==> member(ids, id)) by {
    Tactics.prune("Nickel_crdt.Edit.has_event");
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.smt_sync'(1, 1)
  }
}

proof id_membership_is_text_call(ids: t_Slice(Native.t_EventId), id: Native.t_EventId): unit
  gives Shared.has_id(ids, id, Native.same_event_id) == Native.has_event(ids, id)
  hint Shared.has_id(ids, id, Native.same_event_id)
{ () }

unfold type ids_vec = Alloc.Vec.t_Vec(Native.t_EventId, Alloc.Alloc.t_Global)
function all_ids(ids: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0): Type0 {
  forall(i: usize where v(i) < Seq.length(ids)) . p(Seq.index(ids, v(i)))
}
function retains(roots: t_Slice(Native.t_EventId), selected: ids_vec): Type0 {
  forall(i: usize where v(i) < Seq.length(roots)) . member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(roots, v(i)))
}
function selection_ok(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, selected: ids_vec): Type0 {
  all_ids(Alloc.Vec.impl_1__as_slice(selected), p) and retains(roots, selected)
}
function selection_result(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(selected) => selection_ok(roots, p, selected), _ => Prims.l_True }
}
proof member_satisfies(ids: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, id: Native.t_EventId): unit
  takes all_ids(ids, p)
  takes member(ids, id)
  gives p(id)
{ () }
function push_selection_result(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, outcome: (ids_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(_)) => selection_ok(roots, p, next), _ => Prims.l_True }
}
proof selected_push_preserves(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, before: ids_vec, id: Native.t_EventId): unit
  takes selection_ok(roots, p, before)
  takes p(id)
  gives push_selection_result(roots, p, Native.push(before, id))
{
  push_result_is_exact(before, id);
  assert(push_selection_result(roots, p, Native.push(before, id))) by {
    Tactics.prune("Nickel_crdt.Edit.push");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
function fact_closed(fact: Native.t_Fact, p: Native.t_EventId => Type0): Type0 {
  p(fact.f_id) ==> all_ids(Alloc.Vec.impl_1__as_slice(fact.f_after), p)
}
proof extend_past_preserves(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, fact: Native.t_Fact, before: ids_vec): unit
  takes selection_ok(roots, p, before)
  takes fact_closed(fact, p)
  gives selection_result(roots, p, Native.extend_past(fact, before))
{
  proof each_push(selected: ids_vec, id: Native.t_EventId): unit
    takes selection_ok(roots, p, selected)
    takes p(id)
    gives push_selection_result(roots, p, Native.push(selected, id))
  { selected_push_preserves(roots, p, selected, id) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_push));
  if Native.has_event(Alloc.Vec.impl_1__as_slice(before), fact.f_id) {
    member_satisfies(Alloc.Vec.impl_1__as_slice(before), p, fact.f_id);
    assert(all_ids(Alloc.Vec.impl_1__as_slice(fact.f_after), p));
    Nickel.LoopUtil.result_preserve_any(mk_usize(0), Alloc.Vec.impl_1__len(fact.f_after),
      ((_: nat, selected: ids_vec) => selection_ok(roots, p, selected)),
      ((selected: ids_vec) => selected), selection_ok(roots, p), ((_: Native.t_Error) => Prims.l_True));
    assert(selection_result(roots, p, Native.extend_past(fact, before))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Edit.has_event");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  } else {
    assert(selection_result(roots, p, Native.extend_past(fact, before))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Edit.has_event");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  }
}

function facts_closed(facts: t_Slice(Native.t_Fact), p: Native.t_EventId => Type0): Type0 {
  forall(i: usize where v(i) < Seq.length(facts)) . fact_closed(Seq.index(facts, v(i)), p)
}
proof past_pass_preserves(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0, facts: t_Slice(Native.t_Fact), before: ids_vec): unit
  takes selection_ok(roots, p, before)
  takes facts_closed(facts, p)
  gives selection_result(roots, p, Native.past_pass(facts, before))
{
  proof each_extend(selected: ids_vec, i: usize where v(i) < Seq.length(facts)): unit
    takes selection_ok(roots, p, selected)
    gives selection_result(roots, p, Native.extend_past(Seq.index(facts, v(i)), selected))
  { extend_past_preserves(roots, p, Seq.index(facts, v(i)), selected) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_extend));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((_: nat, selected: ids_vec) => selection_ok(roots, p, selected)),
    ((selected: ids_vec) => selected), selection_ok(roots, p), ((_: Native.t_Error) => Prims.l_True));
  assert(selection_result(roots, p, Native.past_pass(facts, before))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.extend_past");
    Tactics.prune("Nickel_crdt.Event_layer.extend_past");
    Tactics.smt_sync'(1, 1)
  }
}
proof initial_selection_is_valid(roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0): unit
  takes all_ids(roots, p)
  gives selection_ok(roots, p, Alloc.Slice.impl__to_vec(roots))
{ () }

// Universal source-linked soundness and seed retention. p may be ANY set of
// IDs containing the roots and closed under this history's direct edges.
// Completeness (the result itself is closed after N passes) is a separate law.
proof past_stays_in_closed_set(facts: t_Slice(Native.t_Fact), roots: t_Slice(Native.t_EventId), p: Native.t_EventId => Type0): unit
  takes all_ids(roots, p)
  takes facts_closed(facts, p)
  gives selection_result(roots, p, Native.past(facts, roots))
{
  initial_selection_is_valid(roots, p);
  proof each_pass(selected: ids_vec): unit
    takes selection_ok(roots, p, selected)
    gives selection_result(roots, p, Native.past_pass(facts, selected))
  { past_pass_preserves(roots, p, facts, selected) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_pass));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((_: nat, selected: ids_vec) => selection_ok(roots, p, selected)),
    ((selected: ids_vec) => selected), selection_ok(roots, p), ((_: Native.t_Error) => Prims.l_True));
  assert(selection_result(roots, p, Native.past(facts, roots))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Edit.past_pass");
    Tactics.prune("Nickel_crdt.Event_layer.past_pass");
    Tactics.smt_sync'(1, 1)
  }
}


// Reuse the independently stated finite-edge path, not the closure scan.
function ancestor(facts: facts_vec, roots: t_Slice(Native.t_EventId), id: Native.t_EventId): Type0 {
  exists(root: Native.t_EventId, steps: Prims.list(Native.t_EventId)) .
    member(roots, root) and Nickel.EditCausal.causal_path(facts, root, steps, id)
}
proof! append_path_edge(facts: facts_vec, root: Native.t_EventId, steps: Prims.list(Native.t_EventId), parent: Native.t_EventId, child: Native.t_EventId): unit
  decreases steps
  takes Nickel.EditCausal.causal_path(facts, root, steps, parent)
  takes Nickel.EditCausal.causal_edge(facts, parent, child)
  gives Nickel.EditCausal.causal_path(facts, root, List.append(steps, Prims.Cons(child, Prims.Nil)), child)
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => append_path_edge(facts, next, rest, parent, child)
  }
}
proof ancestor_follows_edge(facts: facts_vec, roots: t_Slice(Native.t_EventId), parent: Native.t_EventId, child: Native.t_EventId): unit
  takes ancestor(facts, roots, parent)
  takes Nickel.EditCausal.causal_edge(facts, parent, child)
  gives ancestor(facts, roots, child)
{
  proof each_path(root: Native.t_EventId, steps: Prims.list(Native.t_EventId)): unit
    takes member(roots, root)
    takes Nickel.EditCausal.causal_path(facts, root, steps, parent)
    gives ancestor(facts, roots, child)
  {
    append_path_edge(facts, root, steps, parent, child);
    assert(member(roots, root) and Nickel.EditCausal.causal_path(facts, root, List.append(steps, Prims.Cons(child, Prims.Nil)), child));
    ()
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_path));
  ()
}
proof ancestor_roots_and_edges(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  gives all_ids(roots, ancestor(facts, roots)) and facts_closed(Alloc.Vec.impl_1__as_slice(facts), ancestor(facts, roots))
{
  proof each_root(i: usize where v(i) < Seq.length(roots)): unit
    gives ancestor(facts, roots, Seq.index(roots, v(i)))
  {
    assert(member(roots, Seq.index(roots, v(i))));
    assert(Nickel.EditCausal.causal_path(facts, Seq.index(roots, v(i)), Prims.Nil, Seq.index(roots, v(i))));
    ()
  };
  FStar.Classical.forall_intro(each_root);
  proof each_fact(i: usize where v(i) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))): unit
    gives fact_closed(Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i)), ancestor(facts, roots))
  {
    const fact = Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(i));
    proof each_child(j: usize where v(j) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after))): unit
      takes ancestor(facts, roots, fact.f_id)
      gives ancestor(facts, roots, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)))
    {
      assert(Nickel.EditCausal.causal_edge(facts, fact.f_id, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j))));
      ancestor_follows_edge(facts, roots, fact.f_id, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(j)))
    };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(each_child));
    ()
  };
  FStar.Classical.forall_intro(each_fact);
  ()
}
proof past_has_only_ancestors_and_keeps_roots(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  gives selection_result(roots, ancestor(facts, roots), Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  ancestor_roots_and_edges(facts, roots);
  past_stays_in_closed_set(Alloc.Vec.impl_1__as_slice(facts), roots, ancestor(facts, roots));
  assert(selection_result(roots, ancestor(facts, roots), Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
    Tactics.prune("Nickel_crdt.Edit.past");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.smt_sync'(1, 1)
  }
}

// A successful expansion covers every direct predecessor of a selected fact.
function expanded_prefix(fact: Native.t_Fact, finish: nat, selected: ids_vec): Type0 {
  forall(i: usize where v(i) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after))) .
    v(i) < finish ==> member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(i)))
}
function expansion_ok(fact: Native.t_Fact, before: ids_vec, next: ids_vec): Type0 {
  retains(Alloc.Vec.impl_1__as_slice(before), next) and
  (member(Alloc.Vec.impl_1__as_slice(before), fact.f_id) ==> expanded_prefix(fact, Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after)), next))
}
function expansion_result(fact: Native.t_Fact, before: ids_vec, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(next) => expansion_ok(fact, before, next), _ => Prims.l_True }
}
proof extend_past_covers_predecessors(fact: Native.t_Fact, before: ids_vec): unit
  gives expansion_result(fact, before, Native.extend_past(fact, before))
{
  proof membership_boolean(ids: t_Slice(Native.t_EventId), id: Native.t_EventId): unit
    gives Native.has_event(ids, id) == true or Native.has_event(ids, id) == false
    hint Native.has_event(ids, id)
  { () };
  extend_past_preserves(Alloc.Vec.impl_1__as_slice(before), ((_: Native.t_EventId) => Prims.l_True), fact, before);
  proof each_push(at: usize where v(at) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after)), selected: ids_vec): unit
    takes expanded_prefix(fact, v(at), selected)
    gives (match Native.push(selected, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(at))) {
      (next, Result.Result_Ok(_)) => expanded_prefix(fact, v(at) + 1, next),
      _ => Prims.l_True
    } : Type0)
  {
    push_result_is_exact(selected, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(at)));
    assert((match Native.push(selected, Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(at))) {
      (next, Result.Result_Ok(_)) => expanded_prefix(fact, v(at) + 1, next),
      _ => Prims.l_True
    } : Type0)) by { Tactics.prune("Nickel_crdt.Edit.push");
 Tactics.prune("Nickel_crdt.Event_layer.push"); Tactics.smt_sync'(1, 1) }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_push));
  proof skip_existing(at: usize where v(at) < Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after)), selected: ids_vec): unit
    takes expanded_prefix(fact, v(at), selected)
    takes Native.has_event(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(at))) == true
    gives expanded_prefix(fact, v(at) + 1, selected)
  {
    event_membership_is_exact(Alloc.Vec.impl_1__as_slice(selected), Seq.index(Alloc.Vec.impl_1__as_slice(fact.f_after), v(at)));
    ()
  };

  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(skip_existing));
  if Native.has_event(Alloc.Vec.impl_1__as_slice(before), fact.f_id) {
    Nickel.LoopUtil.result_preserve_any(mk_usize(0), Alloc.Vec.impl_1__len(fact.f_after),
      ((at: nat, selected: ids_vec) => expanded_prefix(fact, at, selected)),
      ((selected: ids_vec) => selected), ((selected: ids_vec) => expanded_prefix(fact, Seq.length(Alloc.Vec.impl_1__as_slice(fact.f_after)), selected)), ((_: Native.t_Error) => Prims.l_True));
    assert(expansion_result(fact, before, Native.extend_past(fact, before))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return"); Tactics.prune("Nickel_crdt.Edit.has_event");
 Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push"); Tactics.smt_sync'(1, 1)
    }
  } else {
    assert(expansion_result(fact, before, Native.extend_past(fact, before))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return"); Tactics.prune("Nickel_crdt.Edit.has_event");
 Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Edit.push");
      Tactics.prune("Nickel_crdt.Event_layer.push"); Tactics.smt_sync'(1, 1)
    }
  }
}

function pass_prefix(facts: t_Slice(Native.t_Fact), before: ids_vec, finish: nat, next: ids_vec): Type0 {
  retains(Alloc.Vec.impl_1__as_slice(before), next) and
  (forall(i: usize where v(i) < Seq.length(facts)) . v(i) < finish ==> expansion_ok(Seq.index(facts, v(i)), before, next))
}
function pass_result(facts: t_Slice(Native.t_Fact), before: ids_vec, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(next) => pass_prefix(facts, before, Seq.length(facts), next), _ => Prims.l_True }
}
proof retains_member(before: ids_vec, next: ids_vec, id: Native.t_EventId): unit
  takes retains(Alloc.Vec.impl_1__as_slice(before), next)
  takes member(Alloc.Vec.impl_1__as_slice(before), id)
  gives member(Alloc.Vec.impl_1__as_slice(next), id)
{ () }
proof expansion_composes(facts: t_Slice(Native.t_Fact), before: ids_vec, at: usize where v(at) < Seq.length(facts), selected: ids_vec, next: ids_vec): unit
  takes pass_prefix(facts, before, v(at), selected)
  takes expansion_ok(Seq.index(facts, v(at)), selected, next)
  gives pass_prefix(facts, before, v(at) + 1, next)
{
  proof each_id(id: Native.t_EventId): unit
    takes member(Alloc.Vec.impl_1__as_slice(selected), id)
    gives member(Alloc.Vec.impl_1__as_slice(next), id)
  { retains_member(selected, next, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_id));
  proof prior_member(id: Native.t_EventId): unit
    takes member(Alloc.Vec.impl_1__as_slice(before), id)
    gives member(Alloc.Vec.impl_1__as_slice(selected), id)
  { retains_member(before, selected, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(prior_member));
  ()
}
proof past_pass_covers_edges(facts: t_Slice(Native.t_Fact), before: ids_vec): unit
  gives pass_result(facts, before, Native.past_pass(facts, before))
{
  proof each_extend(selected: ids_vec, at: usize where v(at) < Seq.length(facts)): unit
    takes pass_prefix(facts, before, v(at), selected)
    gives (match Native.extend_past(Seq.index(facts, v(at)), selected) {
      Result.Result_Ok(next) => pass_prefix(facts, before, v(at) + 1, next), _ => Prims.l_True
    } : Type0)
  {
    extend_past_covers_predecessors(Seq.index(facts, v(at)), selected);
    proof each_next(next: ids_vec): unit
      takes expansion_ok(Seq.index(facts, v(at)), selected, next)
      gives pass_prefix(facts, before, v(at) + 1, next)
    { expansion_composes(facts, before, at, selected, next) };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(each_next));
    assert((match Native.extend_past(Seq.index(facts, v(at)), selected) {
      Result.Result_Ok(next) => pass_prefix(facts, before, v(at) + 1, next), _ => Prims.l_True
    } : Type0)) by { Tactics.prune("Nickel_crdt.Edit.extend_past");
 Tactics.prune("Nickel_crdt.Event_layer.extend_past"); Tactics.smt_sync'(1, 1) }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_extend));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    pass_prefix(facts, before), ((selected: ids_vec) => selected),
    ((next: ids_vec) => pass_prefix(facts, before, Seq.length(facts), next)), ((_: Native.t_Error) => Prims.l_True));
  assert(pass_result(facts, before, Native.past_pass(facts, before))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return"); Tactics.prune("Nickel_crdt.Edit.extend_past");
 Tactics.prune("Nickel_crdt.Event_layer.extend_past"); Tactics.smt_sync'(1, 1)
  }
}

// Independent bounded edge reachability: at most depth predecessor edges.
function! reachable_within(facts: facts_vec, roots: t_Slice(Native.t_EventId), depth: nat, id: Native.t_EventId): Type0
  decreases depth
{
  member(roots, id) or
  (if depth ==? 0 { Prims.l_False } else {
    exists(parent: Native.t_EventId) . reachable_within(facts, roots, depth - 1, parent) and Nickel.EditCausal.causal_edge(facts, parent, id)
  })
}
function covers_depth(facts: facts_vec, roots: t_Slice(Native.t_EventId), depth: nat, selected: ids_vec): Type0 {
  forall(id: Native.t_EventId) . reachable_within(facts, roots, depth, id) ==> member(Alloc.Vec.impl_1__as_slice(selected), id)
}
proof pass_edge_is_covered(facts: facts_vec, before: ids_vec, next: ids_vec, parent: Native.t_EventId, child: Native.t_EventId): unit
  takes pass_prefix(Alloc.Vec.impl_1__as_slice(facts), before, Seq.length(Alloc.Vec.impl_1__as_slice(facts)), next)
  takes member(Alloc.Vec.impl_1__as_slice(before), parent)
  takes Nickel.EditCausal.causal_edge(facts, parent, child)
  gives member(Alloc.Vec.impl_1__as_slice(next), child)
{
  proof each_fact(fact: Native.t_Fact): unit
    takes fact_present(Alloc.Vec.impl_1__as_slice(facts), fact)
    takes fact.f_id == parent
    gives all_ids(Alloc.Vec.impl_1__as_slice(fact.f_after), ((id: Native.t_EventId) => member(Alloc.Vec.impl_1__as_slice(next), id)))
  {
    const at = find_fact_position(Alloc.Vec.impl_1__as_slice(facts), fact);
    const index = mk_usize(at);
    assert(v(index) == at);
    assert(expansion_ok(Seq.index(Alloc.Vec.impl_1__as_slice(facts), v(index)), before, next));
    assert(expansion_ok(fact, before, next));
    ()
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_fact));
  ()
}
proof pass_covers_next_depth(facts: facts_vec, roots: t_Slice(Native.t_EventId), depth: nat, before: ids_vec, next: ids_vec): unit
  takes covers_depth(facts, roots, depth, before)
  takes pass_prefix(Alloc.Vec.impl_1__as_slice(facts), before, Seq.length(Alloc.Vec.impl_1__as_slice(facts)), next)
  gives covers_depth(facts, roots, depth + 1, next)
{
  proof old_member(id: Native.t_EventId): unit
    takes member(Alloc.Vec.impl_1__as_slice(before), id)
    gives member(Alloc.Vec.impl_1__as_slice(next), id)
  { retains_member(before, next, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(old_member));
  proof each_parent(parent: Native.t_EventId, child: Native.t_EventId): unit
    takes reachable_within(facts, roots, depth, parent)
    takes Nickel.EditCausal.causal_edge(facts, parent, child)
    gives member(Alloc.Vec.impl_1__as_slice(next), child)
  { pass_edge_is_covered(facts, before, next, parent, child) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_parent));
  proof each_id(id: Native.t_EventId): unit
    takes reachable_within(facts, roots, depth + 1, id)
    gives member(Alloc.Vec.impl_1__as_slice(next), id)
  { () };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_id));
  ()
}
function depth_result(facts: facts_vec, roots: t_Slice(Native.t_EventId), depth: nat, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(selected) => covers_depth(facts, roots, depth, selected), _ => Prims.l_True }
}
proof past_covers_bounded_predecessor_paths(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  gives depth_result(facts, roots, Seq.length(Alloc.Vec.impl_1__as_slice(facts)), Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  proof each_pass(selected: ids_vec, at: usize where v(at) < Seq.length(Alloc.Vec.impl_1__as_slice(facts))): unit
    takes covers_depth(facts, roots, v(at), selected)
    gives depth_result(facts, roots, v(at) + 1, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected))
  {
    past_pass_covers_edges(Alloc.Vec.impl_1__as_slice(facts), selected);
    assert(pass_result(Alloc.Vec.impl_1__as_slice(facts), selected, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected))) by {
      Tactics.prune("Nickel_crdt.Edit.past_pass");
      Tactics.prune("Nickel_crdt.Event_layer.past_pass"); Tactics.smt_sync'(1, 1)
    };
    match Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected) {
      Result.Result_Ok(next) => {
        pass_covers_next_depth(facts, roots, v(at), selected, next);
        assert(depth_result(facts, roots, v(at) + 1, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected))) by {
          Tactics.prune("Nickel_crdt.Edit.past_pass");
          Tactics.prune("Nickel_crdt.Event_layer.past_pass"); Tactics.smt_sync'(1, 1)
        }
      },
      Result.Result_Err(_) => {
        assert(depth_result(facts, roots, v(at) + 1, Native.past_pass(Alloc.Vec.impl_1__as_slice(facts), selected))) by {
          Tactics.prune("Nickel_crdt.Edit.past_pass");
          Tactics.prune("Nickel_crdt.Event_layer.past_pass"); Tactics.smt_sync'(1, 1)
        }
      }
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_pass));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Alloc.Vec.impl_1__len(facts),
    covers_depth(facts, roots), ((selected: ids_vec) => selected),
    covers_depth(facts, roots, Seq.length(Alloc.Vec.impl_1__as_slice(facts))), ((_: Native.t_Error) => Prims.l_True));
  assert(depth_result(facts, roots, Seq.length(Alloc.Vec.impl_1__as_slice(facts)), Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return"); Tactics.prune("Nickel_crdt.Edit.past_pass");
 Tactics.prune("Nickel_crdt.Event_layer.past_pass"); Tactics.smt_sync'(1, 1)
  }
}

proof! path_extends_reach(facts: facts_vec, roots: t_Slice(Native.t_EventId), depth: nat,
  start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId): unit
  decreases steps
  takes reachable_within(facts, roots, depth, start)
  takes Nickel.EditCausal.causal_path(facts, start, steps, finish)
  gives reachable_within(facts, roots, depth + List.length(steps), finish)
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => {
      assert(reachable_within(facts, roots, depth + 1, next));
      path_extends_reach(facts, roots, depth + 1, next, rest, finish)
    }
  }
}
proof! reach_allows_more_edges(facts: facts_vec, roots: t_Slice(Native.t_EventId), depth: nat, extra: nat, id: Native.t_EventId): unit
  decreases depth
  takes reachable_within(facts, roots, depth, id)
  gives reachable_within(facts, roots, depth + extra, id)
{
  if depth ==? 0 { () } else {
    proof each_parent(parent: Native.t_EventId): unit
      takes reachable_within(facts, roots, depth - 1, parent)
      takes Nickel.EditCausal.causal_edge(facts, parent, id)
      gives reachable_within(facts, roots, depth + extra, id)
    {
      reach_allows_more_edges(facts, roots, depth - 1, extra, parent);
      ()
    };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(each_parent));
    ()
  }
}
proof past_contains_short_paths(facts: facts_vec, roots: t_Slice(Native.t_EventId), root: Native.t_EventId,
  steps: Prims.list(Native.t_EventId), id: Native.t_EventId): unit
  takes member(roots, root)
  takes Nickel.EditCausal.causal_path(facts, root, steps, id)
  takes List.length(steps) <= Seq.length(Alloc.Vec.impl_1__as_slice(facts))
  gives (match Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)
{
  path_extends_reach(facts, roots, 0, root, steps, id);
  reach_allows_more_edges(facts, roots, List.length(steps), Seq.length(Alloc.Vec.impl_1__as_slice(facts)) - List.length(steps), id);
  past_covers_bounded_predecessor_paths(facts, roots);
  assert((match Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)) by { Tactics.prune("Nickel_crdt.Edit.past");
 Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1) }
}

// Cut a repeated-parent loop from an independent causal walk.
import FStar.Fin
function! path_node(start: Native.t_EventId, steps: Prims.list(Native.t_EventId), at: nat where at <= List.length(steps)): Native.t_EventId
  decreases steps
{
  match steps {
    Prims.Nil => start,
    Prims.Cons(next, rest) => if at ==? 0 { start } else { path_node(next, rest, at - 1) }
  }
}
function! drop_edges(steps: Prims.list(Native.t_EventId), count: nat where count <= List.length(steps)): Prims.list(Native.t_EventId)
  decreases steps
{
  if count ==? 0 { steps } else {
    match steps { Prims.Nil => Prims.Nil, Prims.Cons(_, rest) => drop_edges(rest, count - 1) }
  }
}
function! cut_path_loop(steps: Prims.list(Native.t_EventId), first: nat, last: nat where first < last and last <= List.length(steps)): Prims.list(Native.t_EventId)
  decreases steps
{
  if first ==? 0 { drop_edges(steps, last) } else {
    match steps {
      Prims.Nil => Prims.Nil,
      Prims.Cons(next, rest) => Prims.Cons(next, cut_path_loop(rest, first - 1, last - 1))
    }
  }
}
proof! dropped_edge_count(steps: Prims.list(Native.t_EventId), count: nat where count <= List.length(steps)): unit
  decreases steps
  gives List.length(drop_edges(steps, count)) == List.length(steps) - count
{
  if count ==? 0 { () } else {
    match steps { Prims.Nil => (), Prims.Cons(_, rest) => dropped_edge_count(rest, count - 1) }
  }
}
proof! cut_path_is_shorter(steps: Prims.list(Native.t_EventId), first: nat, last: nat where first < last and last <= List.length(steps)): unit
  decreases steps
  gives List.length(cut_path_loop(steps, first, last)) == List.length(steps) - last + first and
    List.length(cut_path_loop(steps, first, last)) < List.length(steps)
{
  if first ==? 0 { dropped_edge_count(steps, last) } else {
    match steps { Prims.Nil => (), Prims.Cons(_, rest) => cut_path_is_shorter(rest, first - 1, last - 1) }
  }
}
proof! dropped_path_starts_at_node(facts: facts_vec, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId,
  count: nat where count <= List.length(steps)): unit
  decreases steps
  takes Nickel.EditCausal.causal_path(facts, start, steps, finish)
  gives Nickel.EditCausal.causal_path(facts, path_node(start, steps, count), drop_edges(steps, count), finish)
{
  if count ==? 0 { () } else {
    match steps {
      Prims.Nil => (),
      Prims.Cons(next, rest) => dropped_path_starts_at_node(facts, next, rest, finish, count - 1)
    }
  }
}
proof! cutting_repeated_node_preserves_path(facts: facts_vec, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId,
  first: nat, last: nat where first < last and last <= List.length(steps)): unit
  decreases steps
  takes Nickel.EditCausal.causal_path(facts, start, steps, finish)
  takes path_node(start, steps, first) == path_node(start, steps, last)
  gives Nickel.EditCausal.causal_path(facts, start, cut_path_loop(steps, first, last), finish)
{
  if first ==? 0 { dropped_path_starts_at_node(facts, start, steps, finish, last) } else {
    match steps {
      Prims.Nil => (),
      Prims.Cons(next, rest) => cutting_repeated_node_preserves_path(facts, next, rest, finish, first - 1, last - 1)
    }
  }
}
function fact_id_present(facts: facts_vec, id: Native.t_EventId): Type0 {
  exists(fact: Native.t_Fact) . fact_present(Alloc.Vec.impl_1__as_slice(facts), fact) and fact.f_id == id
}
proof! path_parent_is_present(facts: facts_vec, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId,
  at: nat where at < List.length(steps)): unit
  decreases steps
  takes Nickel.EditCausal.causal_path(facts, start, steps, finish)
  gives fact_id_present(facts, path_node(start, steps, at))
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => if at ==? 0 { () } else { path_parent_is_present(facts, next, rest, finish, at - 1) }
  }
}
function parent_fact_position(facts: facts_vec, id: Native.t_EventId where fact_id_present(facts, id)): i: nat where
  i < Seq.length(Alloc.Vec.impl_1__as_slice(facts)) and Seq.index(Alloc.Vec.impl_1__as_slice(facts), i).f_id == id
{
  match FStar.Fin.find(Alloc.Vec.impl_1__as_slice(facts), ((fact: Native.t_Fact) => fact.f_id ==? id), 0) {
    Some(i) => i,
    None => 0
  }
}
function path_parent_position(facts: facts_vec, start: Native.t_EventId, finish: Native.t_EventId,
  steps: Prims.list(Native.t_EventId) where Nickel.EditCausal.causal_path(facts, start, steps, finish),
  at: nat where at < List.length(steps)): position: FStar.Fin.under(Seq.length(Alloc.Vec.impl_1__as_slice(facts))) where
    Seq.index(Alloc.Vec.impl_1__as_slice(facts), position).f_id == path_node(start, steps, at)
{
  path_parent_is_present(facts, start, steps, finish, at);
  parent_fact_position(facts, path_node(start, steps, at))
}
proof! every_path_has_short_path(facts: facts_vec, start: Native.t_EventId, steps: Prims.list(Native.t_EventId), finish: Native.t_EventId): unit
  decreases List.length(steps)
  takes Nickel.EditCausal.causal_path(facts, start, steps, finish)
  gives exists(short: Prims.list(Native.t_EventId)) .
    List.length(short) <= Seq.length(Alloc.Vec.impl_1__as_slice(facts)) and Nickel.EditCausal.causal_path(facts, start, short, finish)
{
  const count = Seq.length(Alloc.Vec.impl_1__as_slice(facts));
  if List.length(steps) <= count {
    assert(List.length(steps) <= count and Nickel.EditCausal.causal_path(facts, start, steps, finish));
    ()
  } else {
    if count ==? 0 {
      path_parent_is_present(facts, start, steps, finish, 0);
      const position = parent_fact_position(facts, start);
      assert(position < count);
      ()
    } else {
      const position = path_parent_position(facts, start, finish, steps);
      const positions = Seq.init(count + 1, position);
      Seq.lemma_init_len(count + 1, position);
      Seq.init_index(count + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j and j < count + 1);
          assert(position(i) == position(j));
          assert(path_node(start, steps, i) == path_node(start, steps, j));
          cutting_repeated_node_preserves_path(facts, start, steps, finish, i, j);
          cut_path_is_shorter(steps, i, j);
          const shorter = cut_path_loop(steps, i, j);
          every_path_has_short_path(facts, start, shorter, finish)
        }
      }
    }
  }
}
proof past_contains_every_causal_path(facts: facts_vec, roots: t_Slice(Native.t_EventId), root: Native.t_EventId,
  steps: Prims.list(Native.t_EventId), id: Native.t_EventId): unit
  takes member(roots, root)
  takes Nickel.EditCausal.causal_path(facts, root, steps, id)
  gives (match Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)
{
  every_path_has_short_path(facts, root, steps, id);
  proof each_short(short: Prims.list(Native.t_EventId)): unit
    takes List.length(short) <= Seq.length(Alloc.Vec.impl_1__as_slice(facts))
    takes Nickel.EditCausal.causal_path(facts, root, short, id)
    gives (match Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) {
      Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
    } : Type0)
  { past_contains_short_paths(facts, roots, root, short, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_short));
  assert((match Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)) by { Tactics.prune("Nickel_crdt.Edit.past");
 Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1) }
}
function exact_past_result(facts: facts_vec, roots: t_Slice(Native.t_EventId), result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result {
    Result.Result_Ok(selected) => forall(id: Native.t_EventId) . member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(facts, roots, id),
    _ => Prims.l_True
  }
}
proof successful_past_is_exact_closure(facts: facts_vec, roots: t_Slice(Native.t_EventId)): unit
  gives exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))
{
  past_has_only_ancestors_and_keeps_roots(facts, roots);
  match Native.past(Alloc.Vec.impl_1__as_slice(facts), roots) {
    Result.Result_Ok(selected) => {
      proof each_id(id: Native.t_EventId): unit
        gives member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(facts, roots, id)
      {
        proof each_selected(): unit
          takes member(Alloc.Vec.impl_1__as_slice(selected), id)
          gives ancestor(facts, roots, id)
        { member_satisfies(Alloc.Vec.impl_1__as_slice(selected), ancestor(facts, roots), id) };
        FStar.Classical.move_requires(each_selected, ());
        proof each_path(root: Native.t_EventId, steps: Prims.list(Native.t_EventId)): unit
          takes member(roots, root)
          takes Nickel.EditCausal.causal_path(facts, root, steps, id)
          gives member(Alloc.Vec.impl_1__as_slice(selected), id)
        {
          past_contains_every_causal_path(facts, roots, root, steps, id);
          assert(member(Alloc.Vec.impl_1__as_slice(selected), id)) by {
            Tactics.prune("Nickel_crdt.Edit.past");
            Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
          }
        };
        FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_path));
        ()
      };
      FStar.Classical.forall_intro(each_id);
      assert(exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
        Tactics.prune("Nickel_crdt.Edit.past");
        Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
      }
    },
    Result.Result_Err(_) => {
      assert(exact_past_result(facts, roots, Native.past(Alloc.Vec.impl_1__as_slice(facts), roots))) by {
        Tactics.prune("Nickel_crdt.Edit.past");
        Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
      }
    }
  }
}
