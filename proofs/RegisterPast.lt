import Rust_primitives
import Core_models
import FStar.Pervasives
import FStar.Classical
import Nickel.LoopUtil
import Nickel.EventGraph
import Nickel.Canonical
import Nickel.Vector
import Shared = Nickel_crdt.Event_layer
import Native = Nickel_crdt.Register
import Envelope = Nickel_crdt.Causal
import List = FStar.List.Tot
import Result = Core_models.Result
import Seq = FStar.Seq
import Tactics = FStar.Tactics.V2

// Exact past for the register's shared admission (#97 obligation 1).
// Success-only: a successful `past` selects exactly the ancestors of its roots.
// Totality (a valid offer succeeds) is a separate, unclaimed direction.
// Ancestry is stated through the ops' own id/parent callbacks; the register
// instance discharges those applications in Register.lt.
type fact = Envelope.t_Event(Native.t_Write)
unfold type rid = Envelope.t_Id
unfold type rops = Nickel.EventGraph.graph_ops(fact, Envelope.t_Id, Native.t_Error)
unfold type ids_vec = Alloc.Vec.t_Vec(Envelope.t_Id, Alloc.Alloc.t_Global)

function ids_exact(ops: rops): Type0 {
  forall(a: Envelope.t_Id, b: Envelope.t_Id) . (ops._1._3(a, b) == true <==> a == b)
}

// Positional membership, independent of the native scan.
function absent_prefix(ids: t_Slice(Envelope.t_Id), id: Envelope.t_Id, finish: nat): Type0 {
  forall(i: usize where v(i) < Seq.length(ids)) . v(i) < finish ==> Seq.index(ids, v(i)) =!= id
}
function member(ids: t_Slice(Envelope.t_Id), id: Envelope.t_Id): Type0 {
  not absent_prefix(ids, id, Seq.length(ids))
}
proof id_membership_is_exact(ids: t_Slice(Envelope.t_Id), id: Envelope.t_Id, ops: rops): unit
  takes ids_exact(ops)
  gives Shared.has_id(ids, id, ops) == true <==> member(ids, id)
{
  Nickel.EventGraph.membership_is_exact(ids, id, ops);
  assert(Shared.has_id(ids, id, ops) == true <==> member(ids, id)) by {
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.smt_sync'(1, 1)
  }
}

function all_ids(ids: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0): Type0 {
  forall(i: usize where v(i) < Seq.length(ids)) . p(Seq.index(ids, v(i)))
}
function retains(roots: t_Slice(Envelope.t_Id), selected: ids_vec): Type0 {
  forall(i: usize where v(i) < Seq.length(roots)) . member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(roots, v(i)))
}
function selection_ok(roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, selected: ids_vec): Type0 {
  all_ids(Alloc.Vec.impl_1__as_slice(selected), p) and retains(roots, selected)
}
function selection_result(roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(selected) => selection_ok(roots, p, selected), _ => Prims.l_True }
}
proof member_satisfies(ids: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, id: Envelope.t_Id): unit
  takes all_ids(ids, p)
  takes member(ids, id)
  gives p(id)
{ () }
function push_selection_result(roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, outcome: (ids_vec, Result.t_Result(unit, Native.t_Error))): Type0 {
  match outcome { (next, Result.Result_Ok(_)) => selection_ok(roots, p, next), _ => Prims.l_True }
}
proof selected_push_preserves(roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, before: ids_vec, id: Envelope.t_Id, internal: unit => Native.t_Error): unit
  takes selection_ok(roots, p, before)
  takes p(id)
  gives push_selection_result(roots, p, Shared.push(before, id, internal))
{
  Nickel.Canonical.push_is_exact(before, id, internal);
  assert(push_selection_result(roots, p, Shared.push(before, id, internal))) by {
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.smt_sync'(1, 1)
  }
}
// The native bodies destructure the ops tuple; state its shape once.
proof ops_shape(ops: rops): unit
  gives ops == ((ops._1._1, ops._1._2, ops._1._3, ops._1._4, ops._1._5, ops._1._6), (ops._2._1, ops._2._2))
{ () }
function fact_closed(ops: rops, fact: fact, p: Envelope.t_Id => Type0): Type0 {
  p(ops._1._1(fact)) ==> all_ids(ops._1._2(fact), p)
}
proof extend_past_preserves(ops: rops, roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, fact: fact, before: ids_vec): unit
  takes ids_exact(ops)
  takes selection_ok(roots, p, before)
  takes fact_closed(ops, fact, p)
  gives selection_result(roots, p, Shared.extend_past(fact, before, ops))
{
  proof each_push(selected: ids_vec, id: Envelope.t_Id): unit
    takes selection_ok(roots, p, selected)
    takes p(id)
    gives push_selection_result(roots, p, Shared.push(selected, id, ops._2._1))
  { selected_push_preserves(roots, p, selected, id, ops._2._1) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_push));
  id_membership_is_exact(Alloc.Vec.impl_1__as_slice(before), ops._1._1(fact), ops);
  ops_shape(ops);
  if Shared.has_id(Alloc.Vec.impl_1__as_slice(before), ops._1._1(fact), ops) {
    member_satisfies(Alloc.Vec.impl_1__as_slice(before), p, ops._1._1(fact));
    assert(all_ids(ops._1._2(fact), p));
    Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(ops._1._2(fact)),
      ((_: nat, selected: ids_vec) => selection_ok(roots, p, selected)),
      ((selected: ids_vec) => selected), selection_ok(roots, p), ((_: Native.t_Error) => Prims.l_True));
    assert(selection_result(roots, p, Shared.extend_past(fact, before, ops))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  } else {
    assert(selection_result(roots, p, Shared.extend_past(fact, before, ops))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  }
}

function facts_closed(ops: rops, facts: t_Slice(fact), p: Envelope.t_Id => Type0): Type0 {
  forall(i: usize where v(i) < Seq.length(facts)) . fact_closed(ops, Seq.index(facts, v(i)), p)
}
proof past_pass_preserves(ops: rops, roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0, facts: t_Slice(fact), before: ids_vec): unit
  takes ids_exact(ops)
  takes selection_ok(roots, p, before)
  takes facts_closed(ops, facts, p)
  gives selection_result(roots, p, Shared.past_pass(facts, before, ops))
{
  proof each_extend(selected: ids_vec, i: usize where v(i) < Seq.length(facts)): unit
    takes selection_ok(roots, p, selected)
    gives selection_result(roots, p, Shared.extend_past(Seq.index(facts, v(i)), selected, ops))
  { extend_past_preserves(ops, roots, p, Seq.index(facts, v(i)), selected) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_extend));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((_: nat, selected: ids_vec) => selection_ok(roots, p, selected)),
    ((selected: ids_vec) => selected), selection_ok(roots, p), ((_: Native.t_Error) => Prims.l_True));
  assert(selection_result(roots, p, Shared.past_pass(facts, before, ops))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.extend_past");
    Tactics.smt_sync'(1, 1)
  }
}
proof initial_selection_is_valid(roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0): unit
  takes all_ids(roots, p)
  gives selection_ok(roots, p, Alloc.Slice.impl__to_vec(roots))
{ () }

// Source-linked soundness and root retention for ANY id set p that contains the
// roots and is closed under this history's direct edges.
proof past_stays_in_closed_set(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), p: Envelope.t_Id => Type0): unit
  takes ids_exact(ops)
  takes all_ids(roots, p)
  takes facts_closed(ops, facts, p)
  gives selection_result(roots, p, Shared.past(facts, roots, ops))
{
  initial_selection_is_valid(roots, p);
  ops_shape(ops);
  proof each_pass(selected: ids_vec): unit
    takes selection_ok(roots, p, selected)
    gives selection_result(roots, p, Shared.past_pass(facts, selected, ops))
  { past_pass_preserves(ops, roots, p, facts, selected) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_pass));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    ((_: nat, selected: ids_vec) => selection_ok(roots, p, selected)),
    ((selected: ids_vec) => selected), selection_ok(roots, p), ((_: Native.t_Error) => Prims.l_True));
  assert(selection_result(roots, p, Shared.past(facts, roots, ops))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.past_pass");
    Tactics.prune("Nickel_crdt.Event_layer.validate_after");
    Tactics.smt_sync'(1, 1)
  }
}

// Independent ancestry through the ops' id/parent callbacks.
function causal_edge(ops: rops, facts: t_Slice(fact), newer: Envelope.t_Id, older: Envelope.t_Id): Type0 {
  exists(k: nat) . k < Seq.length(facts) and ops._1._1(Seq.index(facts, k)) == newer and
    member(ops._1._2(Seq.index(facts, k)), older)
}
function! causal_path(ops: rops, facts: t_Slice(fact), start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), finish: Envelope.t_Id): Type0
  decreases steps
{
  match steps {
    Prims.Nil => start == finish,
    Prims.Cons(next, rest) => causal_edge(ops, facts, start, next) and causal_path(ops, facts, next, rest, finish)
  }
}
function ancestor(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), id: Envelope.t_Id): Type0 {
  exists(root: Envelope.t_Id, steps: Prims.list(Envelope.t_Id)) .
    member(roots, root) and causal_path(ops, facts, root, steps, id)
}
proof! append_path_edge(ops: rops, facts: t_Slice(fact), root: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), parent: Envelope.t_Id, child: Envelope.t_Id): unit
  decreases steps
  takes causal_path(ops, facts, root, steps, parent)
  takes causal_edge(ops, facts, parent, child)
  gives causal_path(ops, facts, root, List.append(steps, Prims.Cons(child, Prims.Nil)), child)
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => append_path_edge(ops, facts, next, rest, parent, child)
  }
}
proof ancestor_follows_edge(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), parent: Envelope.t_Id, child: Envelope.t_Id): unit
  takes ancestor(ops, facts, roots, parent)
  takes causal_edge(ops, facts, parent, child)
  gives ancestor(ops, facts, roots, child)
{
  proof each_path(root: Envelope.t_Id, steps: Prims.list(Envelope.t_Id)): unit
    takes member(roots, root)
    takes causal_path(ops, facts, root, steps, parent)
    gives ancestor(ops, facts, roots, child)
  {
    append_path_edge(ops, facts, root, steps, parent, child);
    assert(member(roots, root) and causal_path(ops, facts, root, List.append(steps, Prims.Cons(child, Prims.Nil)), child))
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_path))
}
proof ancestor_roots_and_edges(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id)): unit
  gives all_ids(roots, ancestor(ops, facts, roots)) and facts_closed(ops, facts, ancestor(ops, facts, roots))
{
  proof each_root(i: usize where v(i) < Seq.length(roots)): unit
    gives ancestor(ops, facts, roots, Seq.index(roots, v(i)))
  {
    assert(member(roots, Seq.index(roots, v(i))));
    assert(causal_path(ops, facts, Seq.index(roots, v(i)), Prims.Nil, Seq.index(roots, v(i))))
  };
  FStar.Classical.forall_intro(each_root);
  proof each_fact(i: usize where v(i) < Seq.length(facts)): unit
    gives fact_closed(ops, Seq.index(facts, v(i)), ancestor(ops, facts, roots))
  {
    const f = Seq.index(facts, v(i));
    proof each_child(j: usize where v(j) < Seq.length(ops._1._2(f))): unit
      takes ancestor(ops, facts, roots, ops._1._1(f))
      gives ancestor(ops, facts, roots, Seq.index(ops._1._2(f), v(j)))
    {
      assert(member(ops._1._2(f), Seq.index(ops._1._2(f), v(j))));
      assert(causal_edge(ops, facts, ops._1._1(f), Seq.index(ops._1._2(f), v(j))));
      ancestor_follows_edge(ops, facts, roots, ops._1._1(f), Seq.index(ops._1._2(f), v(j)))
    };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(each_child))
  };
  FStar.Classical.forall_intro(each_fact)
}
// Soundness (one direction of exactness): every selected id is an ancestor of
// the roots, and every root is retained. Unrelated extras are excluded.
proof past_has_only_ancestors_and_keeps_roots(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id)): unit
  takes ids_exact(ops)
  gives selection_result(roots, ancestor(ops, facts, roots), Shared.past(facts, roots, ops))
{
  ancestor_roots_and_edges(ops, facts, roots);
  past_stays_in_closed_set(ops, facts, roots, ancestor(ops, facts, roots))
}

// Completeness (the reverse inclusion), part 1: each successful pass covers one
// more edge of depth.
function expanded_prefix(ops: rops, fact: fact, finish: nat, selected: ids_vec): Type0 {
  forall(i: usize where v(i) < Seq.length(ops._1._2(fact))) .
    v(i) < finish ==> member(Alloc.Vec.impl_1__as_slice(selected), Seq.index(ops._1._2(fact), v(i)))
}
function expansion_ok(ops: rops, fact: fact, before: ids_vec, next: ids_vec): Type0 {
  retains(Alloc.Vec.impl_1__as_slice(before), next) and
  (member(Alloc.Vec.impl_1__as_slice(before), ops._1._1(fact)) ==> expanded_prefix(ops, fact, Seq.length(ops._1._2(fact)), next))
}
function expansion_result(ops: rops, fact: fact, before: ids_vec, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(next) => expansion_ok(ops, fact, before, next), _ => Prims.l_True }
}
proof extend_past_covers_predecessors(ops: rops, fact: fact, before: ids_vec): unit
  takes ids_exact(ops)
  gives expansion_result(ops, fact, before, Shared.extend_past(fact, before, ops))
{
  ops_shape(ops);
  proof membership_boolean(ids: t_Slice(Envelope.t_Id), id: Envelope.t_Id): unit
    gives Shared.has_id(ids, id, ops) == true or Shared.has_id(ids, id, ops) == false
    hint Shared.has_id(ids, id, ops)
  { () };
  extend_past_preserves(ops, Alloc.Vec.impl_1__as_slice(before), ((_: Envelope.t_Id) => Prims.l_True), fact, before);
  proof each_push(at: usize where v(at) < Seq.length(ops._1._2(fact)), selected: ids_vec): unit
    takes expanded_prefix(ops, fact, v(at), selected)
    gives (match Shared.push(selected, Seq.index(ops._1._2(fact), v(at)), ops._2._1) {
      (next, Result.Result_Ok(_)) => expanded_prefix(ops, fact, v(at) + 1, next),
      _ => Prims.l_True
    } : Type0)
  {
    Nickel.Canonical.push_is_exact(selected, Seq.index(ops._1._2(fact), v(at)), ops._2._1);
    assert((match Shared.push(selected, Seq.index(ops._1._2(fact), v(at)), ops._2._1) {
      (next, Result.Result_Ok(_)) => expanded_prefix(ops, fact, v(at) + 1, next),
      _ => Prims.l_True
    } : Type0)) by {
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_push));
  proof skip_existing(at: usize where v(at) < Seq.length(ops._1._2(fact)), selected: ids_vec): unit
    takes expanded_prefix(ops, fact, v(at), selected)
    takes Shared.has_id(Alloc.Vec.impl_1__as_slice(selected), Seq.index(ops._1._2(fact), v(at)), ops) == true
    gives expanded_prefix(ops, fact, v(at) + 1, selected)
  { id_membership_is_exact(Alloc.Vec.impl_1__as_slice(selected), Seq.index(ops._1._2(fact), v(at)), ops) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(skip_existing));
  id_membership_is_exact(Alloc.Vec.impl_1__as_slice(before), ops._1._1(fact), ops);
  if Shared.has_id(Alloc.Vec.impl_1__as_slice(before), ops._1._1(fact), ops) {
    Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(ops._1._2(fact)),
      ((at: nat, selected: ids_vec) => expanded_prefix(ops, fact, at, selected)),
      ((selected: ids_vec) => selected), ((selected: ids_vec) => expanded_prefix(ops, fact, Seq.length(ops._1._2(fact)), selected)), ((_: Native.t_Error) => Prims.l_True));
    assert(expansion_result(ops, fact, before, Shared.extend_past(fact, before, ops))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  } else {
    assert(expansion_result(ops, fact, before, Shared.extend_past(fact, before, ops))) by {
      Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
      Tactics.prune("Nickel_crdt.Event_layer.has_id");
      Tactics.prune("Nickel_crdt.Event_layer.push");
      Tactics.smt_sync'(1, 1)
    }
  }
}

function pass_prefix(ops: rops, facts: t_Slice(fact), before: ids_vec, finish: nat, next: ids_vec): Type0 {
  retains(Alloc.Vec.impl_1__as_slice(before), next) and
  (forall(i: usize where v(i) < Seq.length(facts)) . v(i) < finish ==> expansion_ok(ops, Seq.index(facts, v(i)), before, next))
}
function pass_result(ops: rops, facts: t_Slice(fact), before: ids_vec, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(next) => pass_prefix(ops, facts, before, Seq.length(facts), next), _ => Prims.l_True }
}
proof retains_member(before: ids_vec, next: ids_vec, id: Envelope.t_Id): unit
  takes retains(Alloc.Vec.impl_1__as_slice(before), next)
  takes member(Alloc.Vec.impl_1__as_slice(before), id)
  gives member(Alloc.Vec.impl_1__as_slice(next), id)
{ () }
proof expansion_composes(ops: rops, facts: t_Slice(fact), before: ids_vec, at: usize where v(at) < Seq.length(facts), selected: ids_vec, next: ids_vec): unit
  takes pass_prefix(ops, facts, before, v(at), selected)
  takes expansion_ok(ops, Seq.index(facts, v(at)), selected, next)
  gives pass_prefix(ops, facts, before, v(at) + 1, next)
{
  proof each_id(id: Envelope.t_Id): unit
    takes member(Alloc.Vec.impl_1__as_slice(selected), id)
    gives member(Alloc.Vec.impl_1__as_slice(next), id)
  { retains_member(selected, next, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_id));
  proof prior_member(id: Envelope.t_Id): unit
    takes member(Alloc.Vec.impl_1__as_slice(before), id)
    gives member(Alloc.Vec.impl_1__as_slice(selected), id)
  { retains_member(before, selected, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(prior_member))
}
proof past_pass_covers_edges(ops: rops, facts: t_Slice(fact), before: ids_vec): unit
  takes ids_exact(ops)
  gives pass_result(ops, facts, before, Shared.past_pass(facts, before, ops))
{
  proof each_extend(selected: ids_vec, at: usize where v(at) < Seq.length(facts)): unit
    takes pass_prefix(ops, facts, before, v(at), selected)
    gives (match Shared.extend_past(Seq.index(facts, v(at)), selected, ops) {
      Result.Result_Ok(next) => pass_prefix(ops, facts, before, v(at) + 1, next), _ => Prims.l_True
    } : Type0)
  {
    extend_past_covers_predecessors(ops, Seq.index(facts, v(at)), selected);
    proof each_next(next: ids_vec): unit
      takes expansion_ok(ops, Seq.index(facts, v(at)), selected, next)
      gives pass_prefix(ops, facts, before, v(at) + 1, next)
    { expansion_composes(ops, facts, before, at, selected, next) };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(each_next));
    assert((match Shared.extend_past(Seq.index(facts, v(at)), selected, ops) {
      Result.Result_Ok(next) => pass_prefix(ops, facts, before, v(at) + 1, next), _ => Prims.l_True
    } : Type0)) by {
      Tactics.prune("Nickel_crdt.Event_layer.extend_past");
      Tactics.smt_sync'(1, 1)
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_extend));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    pass_prefix(ops, facts, before), ((selected: ids_vec) => selected),
    ((next: ids_vec) => pass_prefix(ops, facts, before, Seq.length(facts), next)), ((_: Native.t_Error) => Prims.l_True));
  assert(pass_result(ops, facts, before, Shared.past_pass(facts, before, ops))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.extend_past");
    Tactics.smt_sync'(1, 1)
  }
}

// Independent bounded edge reachability: at most depth predecessor edges.
function! reachable_within(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), depth: nat, id: Envelope.t_Id): Type0
  decreases depth
{
  member(roots, id) or
  (if depth ==? 0 { Prims.l_False } else {
    exists(parent: Envelope.t_Id) . reachable_within(ops, facts, roots, depth - 1, parent) and causal_edge(ops, facts, parent, id)
  })
}
function covers_depth(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), depth: nat, selected: ids_vec): Type0 {
  forall(id: Envelope.t_Id) . reachable_within(ops, facts, roots, depth, id) ==> member(Alloc.Vec.impl_1__as_slice(selected), id)
}
proof pass_edge_is_covered(ops: rops, facts: t_Slice(fact), before: ids_vec, next: ids_vec, parent: Envelope.t_Id, child: Envelope.t_Id): unit
  takes pass_prefix(ops, facts, before, Seq.length(facts), next)
  takes member(Alloc.Vec.impl_1__as_slice(before), parent)
  takes causal_edge(ops, facts, parent, child)
  gives member(Alloc.Vec.impl_1__as_slice(next), child)
{
  proof each_position(k: nat): unit
    takes k < Seq.length(facts) and ops._1._1(Seq.index(facts, k)) == parent
    takes member(ops._1._2(Seq.index(facts, k)), child)
    gives member(Alloc.Vec.impl_1__as_slice(next), child)
  {
    const index = mk_usize(k);
    assert(expansion_ok(ops, Seq.index(facts, v(index)), before, next))
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_position))
}
proof pass_covers_next_depth(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), depth: nat, before: ids_vec, next: ids_vec): unit
  takes covers_depth(ops, facts, roots, depth, before)
  takes pass_prefix(ops, facts, before, Seq.length(facts), next)
  gives covers_depth(ops, facts, roots, depth + 1, next)
{
  proof old_member(id: Envelope.t_Id): unit
    takes member(Alloc.Vec.impl_1__as_slice(before), id)
    gives member(Alloc.Vec.impl_1__as_slice(next), id)
  { retains_member(before, next, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(old_member));
  proof each_parent(parent: Envelope.t_Id, child: Envelope.t_Id): unit
    takes reachable_within(ops, facts, roots, depth, parent)
    takes causal_edge(ops, facts, parent, child)
    gives member(Alloc.Vec.impl_1__as_slice(next), child)
  { pass_edge_is_covered(ops, facts, before, next, parent, child) };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_parent));
  proof each_id(id: Envelope.t_Id): unit
    takes reachable_within(ops, facts, roots, depth + 1, id)
    gives member(Alloc.Vec.impl_1__as_slice(next), id)
  { () };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_id))
}
function depth_result(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), depth: nat, result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result { Result.Result_Ok(selected) => covers_depth(ops, facts, roots, depth, selected), _ => Prims.l_True }
}
proof past_covers_bounded_predecessor_paths(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id)): unit
  takes ids_exact(ops)
  gives depth_result(ops, facts, roots, Seq.length(facts), Shared.past(facts, roots, ops))
{
  ops_shape(ops);
  proof each_pass(selected: ids_vec, at: usize where v(at) < Seq.length(facts)): unit
    takes covers_depth(ops, facts, roots, v(at), selected)
    gives depth_result(ops, facts, roots, v(at) + 1, Shared.past_pass(facts, selected, ops))
  {
    past_pass_covers_edges(ops, facts, selected);
    match Shared.past_pass(facts, selected, ops) {
      Result.Result_Ok(next) => {
        pass_covers_next_depth(ops, facts, roots, v(at), selected, next);
        assert(depth_result(ops, facts, roots, v(at) + 1, Shared.past_pass(facts, selected, ops))) by {
          Tactics.prune("Nickel_crdt.Event_layer.past_pass"); Tactics.smt_sync'(1, 1)
        }
      },
      Result.Result_Err(_) => {
        assert(depth_result(ops, facts, roots, v(at) + 1, Shared.past_pass(facts, selected, ops))) by {
          Tactics.prune("Nickel_crdt.Event_layer.past_pass"); Tactics.smt_sync'(1, 1)
        }
      }
    }
  };
  FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_pass));
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    covers_depth(ops, facts, roots), ((selected: ids_vec) => selected),
    covers_depth(ops, facts, roots, Seq.length(facts)), ((_: Native.t_Error) => Prims.l_True));
  assert(depth_result(ops, facts, roots, Seq.length(facts), Shared.past(facts, roots, ops))) by {
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel_crdt.Event_layer.past_pass");
    Tactics.prune("Nickel_crdt.Event_layer.validate_after");
    Tactics.smt_sync'(1, 1)
  }
}

proof! path_extends_reach(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), depth: nat,
  start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), finish: Envelope.t_Id): unit
  decreases steps
  takes reachable_within(ops, facts, roots, depth, start)
  takes causal_path(ops, facts, start, steps, finish)
  gives reachable_within(ops, facts, roots, depth + List.length(steps), finish)
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => {
      assert(reachable_within(ops, facts, roots, depth + 1, next));
      path_extends_reach(ops, facts, roots, depth + 1, next, rest, finish)
    }
  }
}
proof! reach_allows_more_edges(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), depth: nat, extra: nat, id: Envelope.t_Id): unit
  decreases depth
  takes reachable_within(ops, facts, roots, depth, id)
  gives reachable_within(ops, facts, roots, depth + extra, id)
{
  if depth ==? 0 { () } else {
    proof each_parent(parent: Envelope.t_Id): unit
      takes reachable_within(ops, facts, roots, depth - 1, parent)
      takes causal_edge(ops, facts, parent, id)
      gives reachable_within(ops, facts, roots, depth + extra, id)
    { reach_allows_more_edges(ops, facts, roots, depth - 1, extra, parent) };
    FStar.Classical.forall_intro(FStar.Classical.move_requires(each_parent))
  }
}
proof past_contains_short_paths(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), root: Envelope.t_Id,
  steps: Prims.list(Envelope.t_Id), id: Envelope.t_Id): unit
  takes ids_exact(ops)
  takes member(roots, root)
  takes causal_path(ops, facts, root, steps, id)
  takes List.length(steps) <= Seq.length(facts)
  gives (match Shared.past(facts, roots, ops) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)
{
  path_extends_reach(ops, facts, roots, 0, root, steps, id);
  reach_allows_more_edges(ops, facts, roots, List.length(steps), Seq.length(facts) - List.length(steps), id);
  past_covers_bounded_predecessor_paths(ops, facts, roots);
  assert((match Shared.past(facts, roots, ops) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)) by { Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1) }
}

// Cut a repeated-parent loop from an independent causal walk.
import FStar.Fin
function! path_node(start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), at: nat where at <= List.length(steps)): Envelope.t_Id
  decreases steps
{
  match steps {
    Prims.Nil => start,
    Prims.Cons(next, rest) => if at ==? 0 { start } else { path_node(next, rest, at - 1) }
  }
}
function! drop_edges(steps: Prims.list(Envelope.t_Id), count: nat where count <= List.length(steps)): Prims.list(Envelope.t_Id)
  decreases steps
{
  if count ==? 0 { steps } else {
    match steps { Prims.Nil => Prims.Nil, Prims.Cons(_, rest) => drop_edges(rest, count - 1) }
  }
}
function! cut_path_loop(steps: Prims.list(Envelope.t_Id), first: nat, last: nat where first < last and last <= List.length(steps)): Prims.list(Envelope.t_Id)
  decreases steps
{
  if first ==? 0 { drop_edges(steps, last) } else {
    match steps {
      Prims.Nil => Prims.Nil,
      Prims.Cons(next, rest) => Prims.Cons(next, cut_path_loop(rest, first - 1, last - 1))
    }
  }
}
proof! dropped_edge_count(steps: Prims.list(Envelope.t_Id), count: nat where count <= List.length(steps)): unit
  decreases steps
  gives List.length(drop_edges(steps, count)) == List.length(steps) - count
{
  if count ==? 0 { () } else {
    match steps { Prims.Nil => (), Prims.Cons(_, rest) => dropped_edge_count(rest, count - 1) }
  }
}
proof! cut_path_is_shorter(steps: Prims.list(Envelope.t_Id), first: nat, last: nat where first < last and last <= List.length(steps)): unit
  decreases steps
  gives List.length(cut_path_loop(steps, first, last)) == List.length(steps) - last + first and
    List.length(cut_path_loop(steps, first, last)) < List.length(steps)
{
  if first ==? 0 { dropped_edge_count(steps, last) } else {
    match steps { Prims.Nil => (), Prims.Cons(_, rest) => cut_path_is_shorter(rest, first - 1, last - 1) }
  }
}
proof! dropped_path_starts_at_node(ops: rops, facts: t_Slice(fact), start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), finish: Envelope.t_Id,
  count: nat where count <= List.length(steps)): unit
  decreases steps
  takes causal_path(ops, facts, start, steps, finish)
  gives causal_path(ops, facts, path_node(start, steps, count), drop_edges(steps, count), finish)
{
  if count ==? 0 { () } else {
    match steps {
      Prims.Nil => (),
      Prims.Cons(next, rest) => dropped_path_starts_at_node(ops, facts, next, rest, finish, count - 1)
    }
  }
}
proof! cutting_repeated_node_preserves_path(ops: rops, facts: t_Slice(fact), start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), finish: Envelope.t_Id,
  first: nat, last: nat where first < last and last <= List.length(steps)): unit
  decreases steps
  takes causal_path(ops, facts, start, steps, finish)
  takes path_node(start, steps, first) == path_node(start, steps, last)
  gives causal_path(ops, facts, start, cut_path_loop(steps, first, last), finish)
{
  if first ==? 0 { dropped_path_starts_at_node(ops, facts, start, steps, finish, last) } else {
    match steps {
      Prims.Nil => (),
      Prims.Cons(next, rest) => cutting_repeated_node_preserves_path(ops, facts, next, rest, finish, first - 1, last - 1)
    }
  }
}
function fact_id_present(ops: rops, facts: t_Slice(fact), id: Envelope.t_Id): Type0 {
  exists(k: nat) . k < Seq.length(facts) and ops._1._1(Seq.index(facts, k)) == id
}
proof! path_parent_is_present(ops: rops, facts: t_Slice(fact), start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), finish: Envelope.t_Id,
  at: nat where at < List.length(steps)): unit
  decreases steps
  takes causal_path(ops, facts, start, steps, finish)
  gives fact_id_present(ops, facts, path_node(start, steps, at))
{
  match steps {
    Prims.Nil => (),
    Prims.Cons(next, rest) => if at ==? 0 { () } else { path_parent_is_present(ops, facts, next, rest, finish, at - 1) }
  }
}
function parent_fact_position(ops: rops, facts: t_Slice(fact), id: Envelope.t_Id where fact_id_present(ops, facts, id)): i: nat where
  i < Seq.length(facts) and ops._1._1(Seq.index(facts, i)) == id
{
  match FStar.Fin.find(facts, ((f: fact) => ops._1._1(f) ==? id), 0) {
    Some(i) => i,
    None => 0
  }
}
function path_parent_position(ops: rops, facts: t_Slice(fact), start: Envelope.t_Id, finish: Envelope.t_Id,
  steps: Prims.list(Envelope.t_Id) where causal_path(ops, facts, start, steps, finish),
  at: nat where at < List.length(steps)): position: FStar.Fin.under(Seq.length(facts)) where
    ops._1._1(Seq.index(facts, position)) == path_node(start, steps, at)
{
  path_parent_is_present(ops, facts, start, steps, finish, at);
  parent_fact_position(ops, facts, path_node(start, steps, at))
}
proof! every_path_has_short_path(ops: rops, facts: t_Slice(fact), start: Envelope.t_Id, steps: Prims.list(Envelope.t_Id), finish: Envelope.t_Id): unit
  decreases List.length(steps)
  takes causal_path(ops, facts, start, steps, finish)
  gives exists(short: Prims.list(Envelope.t_Id)) .
    List.length(short) <= Seq.length(facts) and causal_path(ops, facts, start, short, finish)
{
  const count = Seq.length(facts);
  if List.length(steps) <= count {
    assert(List.length(steps) <= count and causal_path(ops, facts, start, steps, finish))
  } else {
    if count ==? 0 {
      path_parent_is_present(ops, facts, start, steps, finish, 0);
      const position = parent_fact_position(ops, facts, start);
      assert(position < count)
    } else {
      const position = path_parent_position(ops, facts, start, finish, steps);
      const positions = Seq.init(count + 1, position);
      Seq.lemma_init_len(count + 1, position);
      Seq.init_index(count + 1, position);
      match FStar.Fin.pigeonhole(positions) {
        (i, j) => {
          assert(i < j and j < count + 1);
          assert(position(i) == position(j));
          assert(path_node(start, steps, i) == path_node(start, steps, j));
          cutting_repeated_node_preserves_path(ops, facts, start, steps, finish, i, j);
          cut_path_is_shorter(steps, i, j);
          const shorter = cut_path_loop(steps, i, j);
          every_path_has_short_path(ops, facts, start, shorter, finish)
        }
      }
    }
  }
}
proof past_contains_every_causal_path(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), root: Envelope.t_Id,
  steps: Prims.list(Envelope.t_Id), id: Envelope.t_Id): unit
  takes ids_exact(ops)
  takes member(roots, root)
  takes causal_path(ops, facts, root, steps, id)
  gives (match Shared.past(facts, roots, ops) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)
{
  every_path_has_short_path(ops, facts, root, steps, id);
  proof each_short(short: Prims.list(Envelope.t_Id)): unit
    takes List.length(short) <= Seq.length(facts)
    takes causal_path(ops, facts, root, short, id)
    gives (match Shared.past(facts, roots, ops) {
      Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
    } : Type0)
  { past_contains_short_paths(ops, facts, roots, root, short, id) };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each_short));
  assert((match Shared.past(facts, roots, ops) {
    Result.Result_Ok(selected) => member(Alloc.Vec.impl_1__as_slice(selected), id), _ => Prims.l_True
  } : Type0)) by { Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1) }
}
// Exactness = soundness (past_has_only_ancestors_and_keeps_roots) plus
// completeness (past_contains_every_causal_path), each stated separately.
function exact_past_result(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), result: Result.t_Result(ids_vec, Native.t_Error)): Type0 {
  match result {
    Result.Result_Ok(selected) => forall(id: Envelope.t_Id) . member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(ops, facts, roots, id),
    _ => Prims.l_True
  }
}
proof successful_past_is_exact_closure(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id)): unit
  takes ids_exact(ops)
  gives exact_past_result(ops, facts, roots, Shared.past(facts, roots, ops))
{
  past_has_only_ancestors_and_keeps_roots(ops, facts, roots);
  match Shared.past(facts, roots, ops) {
    Result.Result_Ok(selected) => {
      proof each_id(id: Envelope.t_Id): unit
        gives member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(ops, facts, roots, id)
      {
        proof each_selected(): unit
          takes member(Alloc.Vec.impl_1__as_slice(selected), id)
          gives ancestor(ops, facts, roots, id)
        { member_satisfies(Alloc.Vec.impl_1__as_slice(selected), ancestor(ops, facts, roots), id) };
        FStar.Classical.move_requires(each_selected, ());
        proof each_path(root: Envelope.t_Id, steps: Prims.list(Envelope.t_Id)): unit
          takes member(roots, root)
          takes causal_path(ops, facts, root, steps, id)
          gives member(Alloc.Vec.impl_1__as_slice(selected), id)
        {
          past_contains_every_causal_path(ops, facts, roots, root, steps, id);
          assert(member(Alloc.Vec.impl_1__as_slice(selected), id)) by {
            Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
          }
        };
        FStar.Classical.forall_intro_2(FStar.Classical.move_requires_2(each_path))
      };
      FStar.Classical.forall_intro(each_id);
      assert(exact_past_result(ops, facts, roots, Shared.past(facts, roots, ops))) by {
        Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
      }
    },
    Result.Result_Err(_) => {
      assert(exact_past_result(ops, facts, roots, Shared.past(facts, roots, ops))) by {
        Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
      }
    }
  }
}

// Whole-fact selection: the actual basis is the storage-order filter of the
// stored facts whose id is selected, each fact retained as a whole value.
function copies_exact(ops: rops): Type0 { forall(a: fact) . ops._1._5(a) == a }
unfold type facts_vec = Alloc.Vec.t_Vec(fact, Alloc.Alloc.t_Global)
function! selected_prefix(ops: rops, facts: t_Slice(fact), selected: t_Slice(Envelope.t_Id),
  finish: nat where finish <= Seq.length(facts), output: Seq.seq(fact)): Type0
  decreases finish
{
  if finish ==? 0 { output == Seq.empty }
  else {
    const f = Seq.index(facts, finish - 1);
    (member(selected, ops._1._1(f)) and
      (exists(before: Seq.seq(fact)) .
        selected_prefix(ops, facts, selected, finish - 1, before) and
        output == Seq.append(before, Seq.create(1, f)))) or
    (not member(selected, ops._1._1(f)) and selected_prefix(ops, facts, selected, finish - 1, output))
  }
}
function basis_prefix(ops: rops, facts: t_Slice(fact), selected: t_Slice(Envelope.t_Id), at: nat, basis: facts_vec): Type0 {
  at <= Seq.length(facts) and
  (at <= Seq.length(facts) ==> selected_prefix(ops, facts, selected, at, Alloc.Vec.impl_1__as_slice(basis))) and
  Seq.length(Alloc.Vec.impl_1__as_slice(basis)) <= at
}
proof actual_basis_is_exact_filter(ops: rops, facts: t_Slice(fact), selected: t_Slice(Envelope.t_Id)): unit
  takes ids_exact(ops) and copies_exact(ops)
  gives Nickel.LoopUtil.result_safe(
    ((basis: facts_vec) => selected_prefix(ops, facts, selected, Seq.length(facts), Alloc.Vec.impl_1__as_slice(basis))),
    ((_: Native.t_Error) => Prims.l_False), Shared.select_basis(facts, selected, ops))
{
  ops_shape(ops);
  proof clone(f: fact): unit
    gives Shared.clone_selected_fact(f, ops._1._5) == f
  { () };
  FStar.Classical.forall_intro(clone);
  proof membership(ids: t_Slice(Envelope.t_Id), id: Envelope.t_Id): unit
    gives (Shared.has_id(ids, id, ops) == true <==> member(ids, id)) and
      (Shared.has_id(ids, id, ops) == true or Shared.has_id(ids, id, ops) == false)
  { id_membership_is_exact(ids, id, ops) };
  FStar.Classical.forall_intro_2(membership);
  proof push(xs: facts_vec, item: fact): unit
    gives Shared.push(xs, item, ops._2._1) == Nickel.Canonical.push_outcome(xs, item, ops._2._1)
  { Nickel.Canonical.push_is_exact(xs, item, ops._2._1) };
  FStar.Classical.forall_intro_2(push);
  Nickel.Vector.empty_vector_contents<#fact>();
  Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
    basis_prefix(ops, facts, selected), ((basis: facts_vec) => basis),
    ((basis: facts_vec) => selected_prefix(ops, facts, selected, Seq.length(facts), Alloc.Vec.impl_1__as_slice(basis))),
    ((_: Native.t_Error) => Prims.l_False));
  assert(Nickel.LoopUtil.result_safe(
    ((basis: facts_vec) => selected_prefix(ops, facts, selected, Seq.length(facts), Alloc.Vec.impl_1__as_slice(basis))),
    ((_: Native.t_Error) => Prims.l_False), Shared.select_basis(facts, selected, ops))) by {
    Tactics.prune("Nickel_crdt.Event_layer.clone_selected_fact");
    Tactics.prune("Nickel_crdt.Event_layer.has_id");
    Tactics.prune("Nickel_crdt.Event_layer.push");
    Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
    Tactics.prune("Nickel.LoopUtil.step_safe");
    Tactics.prune("Nickel.LoopUtil.output_safe");
    Tactics.smt_sync'(1, 1)
  }
}

// Native boundary: a successful shared admission returns past's selection unchanged.
unfold type reops = Nickel.EventGraph.event_ops(fact, Envelope.t_Id, Native.t_Error)
proof validated_selection_is_past(facts: t_Slice(fact), offered: fact, events: usize, dependencies: usize, eops: reops): unit
  gives forall(selected: ids_vec) . Shared.validate_event(facts, offered, events, dependencies, eops) == Result.Result_Ok(selected) ==>
    Shared.past(facts, eops._1._1._2(offered), eops._1) == Result.Result_Ok(selected)
{
  assert(eops == (eops._1, (eops._2._1, eops._2._2, (eops._2._3._1, eops._2._3._2, eops._2._3._3, eops._2._3._4))));
  ops_shape(eops._1);
  proof membership_boolean(ids: t_Slice(Envelope.t_Id), id: Envelope.t_Id): unit
    gives Shared.has_id(ids, id, eops._1) == true or Shared.has_id(ids, id, eops._1) == false
    hint Shared.has_id(ids, id, eops._1)
  { () };
  match Shared.past(facts, eops._1._1._2(offered), eops._1) {
    Result.Result_Ok(past_ids) => {
      // The forbidden-ancestor scan only ever breaks with an error.
      Nickel.LoopUtil.result_preserve_any(mk_usize(0), Core_models.Slice.impl__len(facts),
        ((_: nat, _: unit) => Prims.l_True), ((_: unit) => past_ids),
        ((x: ids_vec) => x == past_ids), ((_: Native.t_Error) => Prims.l_True));
      assert(forall(selected: ids_vec) . Shared.validate_event(facts, offered, events, dependencies, eops) == Result.Result_Ok(selected) ==>
        Shared.past(facts, eops._1._1._2(offered), eops._1) == Result.Result_Ok(selected)) by {
        Tactics.prune("Nickel_crdt.Event_layer.past");
        Tactics.prune("Nickel_crdt.Event_layer.has_id");
        Tactics.prune("Nickel_crdt.Event_layer.duplicate_ids");
        Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
        Tactics.smt_sync'(1, 1)
      }
    },
    Result.Result_Err(_) => {
      assert(forall(selected: ids_vec) . Shared.validate_event(facts, offered, events, dependencies, eops) == Result.Result_Ok(selected) ==>
        Shared.past(facts, eops._1._1._2(offered), eops._1) == Result.Result_Ok(selected)) by {
        Tactics.prune("Nickel_crdt.Event_layer.past");
        Tactics.prune("Nickel_crdt.Event_layer.has_id");
        Tactics.prune("Nickel_crdt.Event_layer.duplicate_ids");
        Tactics.prune("Rust_primitives.Hax.Folds.fold_range_return");
        Tactics.smt_sync'(1, 1)
      }
    }
  }
}
proof exact_selection_members(ops: rops, facts: t_Slice(fact), roots: t_Slice(Envelope.t_Id), selected: ids_vec): unit
  takes exact_past_result(ops, facts, roots, Result.Result_Ok(selected))
  gives forall(id: Envelope.t_Id) . member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(ops, facts, roots, id)
{ () }
proof exact_filter_output(ops: rops, facts: t_Slice(fact), selected: t_Slice(Envelope.t_Id), basis: facts_vec): unit
  takes Nickel.LoopUtil.result_safe(
    ((out: facts_vec) => selected_prefix(ops, facts, selected, Seq.length(facts), Alloc.Vec.impl_1__as_slice(out))),
    ((_: Native.t_Error) => Prims.l_False), Result.Result_Ok(basis))
  gives selected_prefix(ops, facts, selected, Seq.length(facts), Alloc.Vec.impl_1__as_slice(basis))
{ () }
// A successful shared admission selected exactly the offered parents' ancestors.
proof validated_selection_is_exact(facts: t_Slice(fact), offered: fact, events: usize, dependencies: usize, eops: reops): unit
  takes ids_exact(eops._1)
  gives forall(selected: ids_vec) . Shared.validate_event(facts, offered, events, dependencies, eops) == Result.Result_Ok(selected) ==>
    (forall(id: Envelope.t_Id) . member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(eops._1, facts, eops._1._1._2(offered), id))
{
  validated_selection_is_past(facts, offered, events, dependencies, eops);
  successful_past_is_exact_closure(eops._1, facts, eops._1._1._2(offered));
  proof each(selected: ids_vec): unit
    takes Shared.past(facts, eops._1._1._2(offered), eops._1) == Result.Result_Ok(selected)
    gives forall(id: Envelope.t_Id) . member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(eops._1, facts, eops._1._1._2(offered), id)
  {
    assert(exact_past_result(eops._1, facts, eops._1._1._2(offered), Result.Result_Ok(selected))) by {
      Tactics.prune("Nickel_crdt.Event_layer.past"); Tactics.smt_sync'(1, 1)
    };
    exact_selection_members(eops._1, facts, eops._1._1._2(offered), selected)
  };
  FStar.Classical.forall_intro(FStar.Classical.move_requires(each));
  assert(forall(selected: ids_vec) . Shared.validate_event(facts, offered, events, dependencies, eops) == Result.Result_Ok(selected) ==>
    (forall(id: Envelope.t_Id) . member(Alloc.Vec.impl_1__as_slice(selected), id) <==> ancestor(eops._1, facts, eops._1._1._2(offered), id))) by {
    Tactics.prune("Nickel_crdt.Event_layer.validate_event");
    Tactics.prune("Nickel_crdt.Event_layer.past");
    Tactics.smt_sync'(1, 1)
  }
}
